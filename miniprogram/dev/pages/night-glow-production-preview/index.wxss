page { background: #071321; color: #F3F8FF; }
.preview-menu { padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); }
.preview-title { display: block; font-size: 36rpx; font-weight: 700; }
.preview-note { display: block; margin: 20rpx 0 32rpx; color: #B1BFD0; font-size: 25rpx; line-height: 1.6; }
.preview-target { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin-bottom: 16rpx; background: #152539; color: #CEFF80; font-size: 28rpx; }
