<view class="c2a-page">
  <view class="c2a-system" style="height: {{headerTopPx}}px;"></view>
  <view class="c2a-header" style="height: {{headerRowHeightPx}}px;">
    <button class="c2a-header-back" hover-class="c2a-pressed" bindtap="onHeaderBack" aria-label="返回">
      <view class="c2a-back-icon" aria-hidden="true"></view>
    </button>
    <text class="c2a-header-title">C2a 开发预览</text>
    <view class="c2a-header-spacer" aria-hidden="true"></view>
  </view>

  <scroll-view class="c2a-scroll" scroll-y="true">
    <view class="c2a-content">
      <text class="c2a-preview-note">{{previewNotice}}</text>
      <text class="c2a-heading">报名自助退出</text>
      <text class="c2a-copy">选择可重复状态，检查撤回、退出、终态回读与结果恢复。</text>
      <view class="c2a-scenario-list">
        <button
          wx:for="{{scenarios}}"
          wx:key="scenario"
          class="c2a-scenario-card"
          hover-class="c2a-pressed"
          bindtap="onOpenScenario"
          data-scenario="{{item.scenario}}"
          aria-label="打开{{item.title}}"
        >
          <view class="c2a-scenario-copy"><text>{{item.title}}</text><text>{{item.detail}}</text></view>
          <view class="c2a-chevron" aria-hidden="true"></view>
        </button>
      </view>
    </view>
  </scroll-view>
</view>
