.c2a-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 28rpx; }
.c2a-system { flex: 0 0 auto; background: #FFFFFF; }
.c2a-header { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; flex: 0 0 auto; box-sizing: border-box; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }
.c2a-header-back, .c2a-header-spacer { box-sizing: border-box; width: 88rpx; min-width: 88rpx; min-height: 88rpx; }
.c2a-header-back { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; }
.c2a-header-back::after, .c2a-scenario-card::after { border: 0; }
.c2a-header-title { overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; font-weight: 700; line-height: 48rpx; }
.c2a-back-icon { position: relative; width: 40rpx; height: 40rpx; }
.c2a-back-icon::before { position: absolute; top: 9rpx; left: 7rpx; box-sizing: border-box; width: 22rpx; height: 22rpx; border-left: 4rpx solid #10243E; border-bottom: 4rpx solid #10243E; transform: rotate(45deg); content: ""; }
.c2a-back-icon::after { position: absolute; top: 18rpx; left: 8rpx; width: 27rpx; height: 4rpx; border-radius: 2rpx; background: #10243E; content: ""; }
.c2a-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; min-height: 0; }
.c2a-content { box-sizing: border-box; min-height: 100%; padding: 28rpx 24rpx calc(64rpx + env(safe-area-inset-bottom, 0px)); }
.c2a-preview-note, .c2a-heading, .c2a-copy { display: block; }
.c2a-preview-note { color: #0369A1; font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.c2a-heading { margin-top: 8rpx; font-size: 42rpx; font-weight: 700; line-height: 58rpx; }
.c2a-copy { margin-top: 8rpx; color: #526479; font-size: 26rpx; line-height: 40rpx; }
.c2a-scenario-list { display: grid; gap: 18rpx; margin-top: 28rpx; }
.c2a-scenario-card { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 112rpx; margin: 0; padding: 20rpx 66rpx 20rpx 24rpx; border: 1rpx solid #DBE5EC; border-radius: 24rpx; background: #FFFFFF; color: #10243E; text-align: left; }
.c2a-scenario-copy { display: flex; width: 100%; min-width: 0; flex-direction: column; }
.c2a-scenario-copy text:first-child { font-size: 30rpx; font-weight: 700; line-height: 44rpx; }
.c2a-scenario-copy text:last-child { margin-top: 2rpx; color: #526479; font-size: 23rpx; line-height: 34rpx; }
.c2a-chevron { position: absolute; top: 50%; right: 28rpx; box-sizing: border-box; width: 18rpx; height: 18rpx; border-top: 4rpx solid #64748B; border-right: 4rpx solid #64748B; transform: translateY(-50%) rotate(45deg); }
.c2a-pressed { opacity: .68; }
