<view class="c2c-page">
  <view class="c2c-system" style="height: {{headerTopPx}}px;"></view>
  <view class="c2c-header" style="height: {{headerRowHeightPx}}px;">
    <button class="c2c-header-back" hover-class="c2c-pressed" bindtap="onHeaderBack" aria-label="返回">
      <view class="c2c-back-icon" aria-hidden="true"></view>
    </button>
    <text class="c2c-header-title">C2c 开发预览</text>
    <view class="c2c-header-spacer" aria-hidden="true"></view>
  </view>

  <scroll-view class="c2c-scroll" scroll-y="true">
    <view class="c2c-content">
      <text class="c2c-preview-note">{{previewNotice}}</text>
      <text class="c2c-heading">散客到场记录</text>
      <text class="c2c-copy">选择一个可重复场景，检查名单、空态与权威结果恢复。</text>

      <view class="c2c-scenario-list">
        <button
          wx:for="{{scenarios}}"
          wx:key="scenario"
          class="c2c-scenario-card"
          hover-class="c2c-pressed"
          bindtap="onOpenScenario"
          data-scenario="{{item.scenario}}"
          aria-label="打开{{item.title}}"
        >
          <view class="c2c-scenario-copy">
            <text>{{item.title}}</text>
            <text>{{item.detail}}</text>
          </view>
          <view class="c2c-chevron" aria-hidden="true"></view>
        </button>
      </view>

      <view class="c2c-boundary" aria-role="note">
        <text>预览边界</text>
        <text>本页只驱动隔离 Fixture，不写入生产到场记录。</text>
      </view>
    </view>
  </scroll-view>
</view>
