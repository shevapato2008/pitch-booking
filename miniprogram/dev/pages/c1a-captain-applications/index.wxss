.c1a-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 28rpx; }
.c1a-system { flex: 0 0 auto; background: #FFFFFF; }
.c1a-nav { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; box-sizing: border-box; flex: 0 0 auto; background: #FFFFFF; }
.c1a-nav-copy { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; }
.c1a-nav-title { overflow: hidden; font-size: 32rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.c1a-nav-subtitle { color: #526479; font-size: 22rpx; }
.c1a-nav-spacer { width: 88rpx; height: 88rpx; }
.c1a-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom, 0px)); }
.c1a-notice, .c1a-help { color: #526479; font-size: 23rpx; line-height: 36rpx; }
.c1a-notice { padding: 0 8rpx 14rpx; }
.c1a-card { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #DBE5EC; border-radius: 18rpx; background: #FFFFFF; line-height: 40rpx; }
.c1a-state-card { margin-top: 20rpx; }
.c1a-game-card { border-color: #BAE6FD; background: #F0F9FF; }
.c1a-card-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.c1a-card-row > view { display: flex; min-width: 0; flex-direction: column; }
.c1a-eyebrow, .c1a-label { color: #0369A1; font-size: 23rpx; font-weight: 700; }
.c1a-heading { font-size: 31rpx; font-weight: 700; line-height: 44rpx; }
.c1a-applicant-name { margin-top: 6rpx; }
.c1a-spots { padding: 4rpx 14rpx; border-radius: 999rpx; background: #FFFFFF; color: #0369A1; font-size: 22rpx; font-weight: 700; white-space: nowrap; }
.c1a-time { color: #64748B; font-size: 22rpx; white-space: nowrap; }
.c1a-detail-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-top: 1rpx solid #E2E8F0; border-bottom: 1rpx solid #E2E8F0; }
.c1a-note { display: flex; flex-direction: column; gap: 6rpx; }
.c1a-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 4rpx; }
.c1a-empty { align-items: center; padding-top: 48rpx; padding-bottom: 48rpx; text-align: center; }
.c1a-empty-mark { display: flex; align-items: flex-end; justify-content: center; width: 88rpx; height: 88rpx; gap: 8rpx; border-radius: 50%; background: #F0F9FF; }
.c1a-empty-mark view { width: 10rpx; margin-bottom: 28rpx; border-radius: 10rpx; background: #0284C7; }
.c1a-empty-mark view:nth-child(1) { height: 18rpx; }.c1a-empty-mark view:nth-child(2) { height: 30rpx; }.c1a-empty-mark view:nth-child(3) { height: 24rpx; }
button { box-sizing: border-box; }
.c1a-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 0; padding: 0 20rpx; border-radius: 14rpx; font-size: 28rpx; font-weight: 700; }
.c1a-button--primary { border: 1rpx solid #0284C7; background: #0284C7; color: #FFFFFF; }
.c1a-button--secondary { border: 1rpx solid #0284C7; background: #FFFFFF; color: #0369A1; }
.c1a-icon-button { min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; color: #0369A1; font-size: 48rpx; }
.c1a-scrim { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; box-sizing: border-box; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom, 0px)); background: rgba(16, 36, 62, .48); }
.c1a-sheet { display: flex; width: 100%; flex-direction: column; gap: 18rpx; box-sizing: border-box; padding: 28rpx; border-radius: 24rpx; background: #FFFFFF; }
.c1a-sheet-close { min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; margin: 0; padding: 0 12rpx; border: 0; background: transparent; color: #0369A1; font-size: 24rpx; }
