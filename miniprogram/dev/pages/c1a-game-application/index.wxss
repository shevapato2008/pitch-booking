.c1a-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 28rpx; }
.c1a-system { flex: 0 0 auto; background: #FFFFFF; }
.c1a-nav { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; box-sizing: border-box; flex: 0 0 auto; background: #FFFFFF; }
.c1a-nav-copy { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; }
.c1a-nav-title { overflow: hidden; font-size: 32rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.c1a-nav-subtitle { color: #526479; font-size: 22rpx; }
.c1a-nav-spacer { width: 88rpx; height: 88rpx; }
.c1a-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; padding: 20rpx 24rpx calc(252rpx + env(safe-area-inset-bottom, 0px)); }
.c1a-notice, .c1a-help { color: #526479; font-size: 23rpx; line-height: 36rpx; }
.c1a-notice { padding: 0 8rpx 14rpx; }
.c1a-card { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #DBE5EC; border-radius: 18rpx; background: #FFFFFF; }
.c1a-state-card { margin-top: 20rpx; }
.c1a-heading { font-size: 31rpx; font-weight: 700; line-height: 44rpx; }
.c1a-eyebrow, .c1a-label { color: #10243E; font-size: 25rpx; font-weight: 700; }
.c1a-eyebrow { color: #0369A1; }
.c1a-field { display: flex; flex-direction: column; gap: 10rpx; }
.c1a-input, .c1a-textarea { box-sizing: border-box; width: 100%; border: 1rpx solid #B8C8D6; border-radius: 12rpx; background: #FFFFFF; color: #10243E; font-size: 28rpx; }
.c1a-input { min-height: 88rpx; padding: 0 20rpx; }
.c1a-textarea { height: 176rpx; padding: 18rpx 20rpx; line-height: 40rpx; }
.c1a-card-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.c1a-count { color: #64748B; font-size: 23rpx; }
.c1a-position-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.c1a-option { min-height: 88rpx; display: flex; align-items: center; justify-content: center; width: 100%; margin: 0; padding: 0 12rpx; border: 1rpx solid #B8C8D6; border-radius: 12rpx; background: #FFFFFF; color: #334155; font-size: 26rpx; }
.c1a-option--selected { border-color: #0284C7; background: #F0F9FF; color: #0369A1; font-weight: 700; }
.c1a-check-row { display: flex; align-items: center; min-height: 88rpx; gap: 16rpx; line-height: 40rpx; }
.c1a-error { color: #B91C1C; font-size: 23rpx; line-height: 34rpx; }
button { box-sizing: border-box; }
.c1a-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 0; padding: 0 20rpx; border-radius: 14rpx; font-size: 29rpx; font-weight: 700; }
.c1a-button--primary { border: 1rpx solid #0284C7; background: #0284C7; color: #FFFFFF; }
.c1a-button--primary[disabled] { border-color: #CBD5E1; background: #E2E8F0; color: #64748B; }
.c1a-button--secondary { border: 1rpx solid #0284C7; background: #FFFFFF; color: #0369A1; }
.c1a-icon-button { min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; color: #0369A1; font-size: 48rpx; }
.c1a-footer { position: fixed; z-index: 8; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: 200rpx minmax(0, 1fr); gap: 16rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom, 0px)); border-top: 1rpx solid #DBE5EC; background: rgba(255, 255, 255, .98); box-shadow: 0 -8rpx 28rpx rgba(16, 36, 62, .08); }
.c1a-footer--stacked { grid-template-columns: 1fr; }
