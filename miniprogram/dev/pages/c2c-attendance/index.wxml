<view class="c2c-page">
  <view class="c2c-system" style="height: {{headerTopPx}}px;"></view>
  <view class="c2c-header" style="height: {{headerRowHeightPx}}px;" aria-hidden="{{decisionPanel ? true : false}}">
    <button class="c2c-header-back" hover-class="c2c-pressed" bindtap="onHeaderBack" aria-label="返回场景入口">
      <view class="c2c-back-icon" aria-hidden="true"></view>
    </button>
    <text class="c2c-header-title">到场记录</text>
    <view class="c2c-header-spacer" aria-hidden="true"></view>
  </view>

  <scroll-view class="c2c-scroll" scroll-y="true" aria-hidden="{{decisionPanel ? true : false}}">
    <view class="c2c-content">
      <text class="c2c-preview-note">{{fixtureNotice}}</text>

      <view wx:if="{{previewState === 'LOAD_ERROR'}}" class="c2c-state-card c2c-state-card--error" aria-role="alert">
        <view class="c2c-state-mark c2c-state-mark--error" aria-hidden="true"></view>
        <text class="c2c-state-title">名单加载失败</text>
        <text class="c2c-state-copy">{{previewMessage}}</text>
        <button class="c2c-state-action c2c-state-action--primary" hover-class="c2c-pressed" bindtap="onRetryLoad">重新加载</button>
      </view>

      <block wx:else>
        <view class="c2c-game-card">
          <view class="c2c-completed-heading">
            <view class="c2c-completed-icon" aria-hidden="true"></view>
            <text>本场已结束</text>
          </view>
          <text class="c2c-game-name">{{game.gameName}}</text>
          <text class="c2c-game-time">{{game.dateLabel}} · {{game.timeLabel}}</text>
          <text class="c2c-game-place">{{game.venue}} · {{game.pitch}}</text>
        </view>

        <view wx:if="{{previewState === 'CONFLICT'}}" class="c2c-recovery-card" aria-role="status">
          <view class="c2c-recovery-copy">
            <text>名单状态已变化</text>
            <text>{{previewMessage}}</text>
          </view>
          <button class="c2c-state-action c2c-state-action--secondary" hover-class="c2c-pressed" bindtap="onResolveConflict">确认最新名单</button>
        </view>

        <view wx:elif="{{previewState === 'UNKNOWN_RESULT'}}" class="c2c-recovery-card" aria-role="status">
          <view class="c2c-recovery-copy">
            <text>记录结果待确认</text>
            <text>{{previewMessage}}</text>
          </view>
          <button class="c2c-state-action c2c-state-action--primary" hover-class="c2c-pressed" bindtap="onConfirmUnknownResult">确认记录结果</button>
        </view>

        <view class="c2c-progress-row">
          <text>散客名单</text>
          <text>{{progressLabel}}</text>
        </view>

        <view wx:if="{{isEmpty}}" class="c2c-state-card" aria-role="status">
          <view class="c2c-empty-mark" aria-hidden="true"><view></view><view></view><view></view></view>
          <text class="c2c-state-title">本场没有需要记录的散客</text>
          <text class="c2c-state-copy">返回场景入口，可以继续检查其他到场状态。</text>
          <button class="c2c-state-action c2c-state-action--secondary" hover-class="c2c-pressed" bindtap="onReturnScenario">返回场景入口</button>
        </view>

        <view wx:else class="c2c-roster">
          <view wx:for="{{roster}}" wx:key="registrationId" class="c2c-player-card">
            <view class="c2c-player-top">
              <view class="c2c-player-identity">
                <text class="c2c-player-name">{{item.perGameName}}</text>
                <text class="c2c-player-position">意向位置 · {{item.intendedPosition}}</text>
              </view>
              <text wx:if="{{item.isUnmarked}}" class="c2c-pending-label">{{item.resultLabel}}</text>
              <view wx:else class="c2c-status-column">
                <text class="c2c-status-badge {{item.attendanceResult === 'PRESENT' ? 'c2c-status-badge--present' : 'c2c-status-badge--no-show'}}">{{item.resultLabel}}</text>
                <text class="c2c-recorded-time">{{item.recordedTimeLabel}}</text>
              </view>
            </view>

            <view wx:if="{{item.canMark}}" class="c2c-row-actions">
              <button class="c2c-row-action c2c-row-action--present" hover-class="c2c-pressed" bindtap="onMarkPresent" data-registration-id="{{item.registrationId}}" aria-label="记录{{item.perGameName}}到场">到场</button>
              <button class="c2c-row-action c2c-row-action--no-show" hover-class="c2c-pressed" bindtap="onMarkNoShow" data-registration-id="{{item.registrationId}}" aria-label="记录{{item.perGameName}}未到场">未到场</button>
            </view>
          </view>
        </view>

        <view wx:if="{{isComplete}}" class="c2c-complete-note" aria-role="status">
          <view class="c2c-complete-dot" aria-hidden="true"></view>
          <text>{{completionMessage}}</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{decisionPanel}}" class="c2c-scrim" catchtouchmove="onBlockTouchMove" aria-role="dialog" aria-modal="true" aria-label="{{decisionTitle}}">
    <view class="c2c-sheet">
      <view class="c2c-sheet-title-row">
        <view class="c2c-sheet-heading" tabindex="0">
          <text class="c2c-sheet-title">{{decisionTitle}}</text>
          <text class="c2c-sheet-player">本场称呼：{{decisionPlayerName}}</text>
        </view>
        <button class="c2c-sheet-close" hover-class="c2c-pressed" bindtap="onCloseDecision" aria-label="关闭确认层">
          <view class="c2c-close-icon" aria-hidden="true"></view>
        </button>
      </view>
      <text class="c2c-sheet-warning">{{decisionWarning}}</text>
      <view class="c2c-sheet-actions">
        <button class="c2c-sheet-action c2c-sheet-action--neutral" hover-class="c2c-pressed" bindtap="onCloseDecision">返回名单</button>
        <button class="c2c-sheet-action {{decisionPanel.attendanceResult === 'NO_SHOW' ? 'c2c-sheet-action--danger' : 'c2c-sheet-action--primary'}}" hover-class="c2c-pressed" bindtap="onConfirmDecision">{{confirmButtonLabel}}</button>
      </view>
    </view>
  </view>
</view>
