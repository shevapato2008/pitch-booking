.d1b-scenario-page { display: flex; height: 100vh; flex-direction: column; overflow: hidden; background: #F8FAFC; color: #10243E; }
.d1b-system { flex: 0 0 auto; background: #FFFFFF; }
.d1b-header { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; flex: 0 0 auto; align-items: center; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }
.d1b-header-back { display: flex; width: 88rpx; min-height: 88rpx; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; padding: 0; border: 0; background: transparent; }
.d1b-header-back::after, .d1b-scenario-button::after { border: 0; }
.d1b-header-title { overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; font-weight: 700; line-height: 48rpx; }
.d1b-header-spacer { width: 88rpx; }
.d1b-back-icon { position: relative; width: 40rpx; height: 40rpx; }
.d1b-back-icon::before { position: absolute; top: 9rpx; left: 7rpx; box-sizing: border-box; width: 22rpx; height: 22rpx; border-left: 4rpx solid #10243E; border-bottom: 4rpx solid #10243E; transform: rotate(45deg); content: ""; }
.d1b-back-icon::after { position: absolute; top: 18rpx; left: 8rpx; width: 27rpx; height: 4rpx; border-radius: 2rpx; background: #10243E; content: ""; }
.d1b-scenario-scroll { flex: 1 1 auto; height: 0; min-height: 0; }
.d1b-scenario-content { box-sizing: border-box; min-height: 100%; padding: 32rpx 24rpx calc(36rpx + env(safe-area-inset-bottom, 0px)); }
.d1b-kicker, .d1b-scenario-title, .d1b-scenario-copy, .d1b-scenario-button text { display: block; }
.d1b-kicker { color: #047857; font-size: 22rpx; font-weight: 750; line-height: 34rpx; }
.d1b-scenario-title { margin-top: 6rpx; font-size: 42rpx; font-weight: 760; line-height: 58rpx; }
.d1b-scenario-copy { margin: 10rpx 0 28rpx; color: #64748B; font-size: 25rpx; line-height: 40rpx; }
.d1b-scenario-button { display: flex; width: 100%; min-height: 126rpx; align-items: center; justify-content: space-between; box-sizing: border-box; margin: 0 0 18rpx; padding: 22rpx 26rpx; border: 1rpx solid #D7E3EA; border-radius: 24rpx; background: #FFFFFF; color: #10243E; text-align: left; }
.d1b-scenario-button view:first-child { min-width: 0; }
.d1b-scenario-button text:first-child { font-size: 29rpx; font-weight: 720; line-height: 42rpx; }
.d1b-scenario-button text:last-child { margin-top: 4rpx; color: #64748B; font-size: 22rpx; line-height: 34rpx; }
.d1b-chevron { width: 18rpx; height: 18rpx; flex: 0 0 auto; margin-left: 20rpx; border-top: 4rpx solid #64748B; border-right: 4rpx solid #64748B; transform: rotate(45deg); }
.d1b-pressed { opacity: .68; }
