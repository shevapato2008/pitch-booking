.c1b-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 28rpx; }
.c1b-system { flex: 0 0 auto; background: #FFFFFF; }
.c1b-header { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; flex: 0 0 auto; box-sizing: border-box; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }
.c1b-header-back, .c1b-header-spacer { box-sizing: border-box; width: 88rpx; min-width: 88rpx; min-height: 88rpx; }
.c1b-header-back { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; }
.c1b-header-back::after, .c1b-secondary-action::after { border: 0; }
.c1b-header-title { overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; font-weight: 700; line-height: 48rpx; }
.c1b-back-icon { position: relative; width: 40rpx; height: 40rpx; }
.c1b-back-icon::before { position: absolute; top: 9rpx; left: 7rpx; box-sizing: border-box; width: 22rpx; height: 22rpx; border-left: 4rpx solid #10243E; border-bottom: 4rpx solid #10243E; transform: rotate(45deg); content: ""; }
.c1b-back-icon::after { position: absolute; top: 18rpx; left: 8rpx; width: 27rpx; height: 4rpx; border-radius: 2rpx; background: #10243E; content: ""; }
.c1b-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; min-height: 0; }
.c1b-detail-content { box-sizing: border-box; min-height: 100%; padding: 24rpx 24rpx calc(64rpx + env(safe-area-inset-bottom, 0px)); }
.c1b-preview-note { display: block; color: #0369A1; font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.c1b-detail-card, .c1b-state-card { margin-top: 20rpx; padding: 32rpx; border: 1rpx solid #DBE5EC; border-radius: 28rpx; background: #FFFFFF; }
.c1b-confirmed { color: #047857; font-size: 24rpx; font-weight: 700; line-height: 36rpx; }
.c1b-confirmed::before { display: inline-block; width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: #047857; content: ""; vertical-align: 2rpx; }
.c1b-detail-title { display: block; margin-top: 10rpx; font-size: 42rpx; font-weight: 700; line-height: 58rpx; }
.c1b-detail-meta { display: block; margin-top: 10rpx; color: #526479; font-size: 26rpx; line-height: 40rpx; }
.c1b-detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24rpx 32rpx; margin-top: 32rpx; padding-top: 28rpx; border-top: 1rpx solid #DBE5EC; }
.c1b-detail-grid__wide { grid-column: 1 / -1; }
.c1b-detail-label, .c1b-detail-value { display: block; }
.c1b-detail-label { color: #64748B; font-size: 22rpx; line-height: 34rpx; }
.c1b-detail-value { margin-top: 4rpx; font-size: 26rpx; font-weight: 700; line-height: 40rpx; }
.c1b-readonly-note { display: block; margin-top: 28rpx; padding: 24rpx; border-radius: 22rpx; background: #F1F5F9; color: #526479; font-size: 24rpx; line-height: 38rpx; }
.c1b-state-card { padding: 44rpx 32rpx; text-align: center; }
.c1b-state-title, .c1b-state-copy { display: block; }
.c1b-state-title { font-size: 36rpx; font-weight: 700; line-height: 52rpx; }
.c1b-state-copy { margin-top: 12rpx; color: #526479; font-size: 26rpx; line-height: 40rpx; }
.c1b-secondary-action { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 30rpx 0 0; padding: 0 24rpx; border: 1rpx solid #7DD3FC; border-radius: 22rpx; background: #F0F9FF; color: #0369A1; font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.c1b-pressed { opacity: .68; }
