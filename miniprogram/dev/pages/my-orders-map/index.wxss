@import "../../../styles/tokens.wxss";

.map-frame {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #DCE9E3;
  color: #10243E;
}

.map-canvas {
  position: absolute;
  inset: 0;
  background: linear-gradient(110deg, transparent 0 54%, #B9DCE4 54.5% 62%, transparent 62.5%), #DCE9E3;
}

.map-canvas::after {
  position: absolute;
  top: 42%;
  right: -10%;
  left: -10%;
  height: 12rpx;
  border: 2rpx solid #CBD8D2;
  border-radius: 999rpx;
  background: #FFFFFFE0;
  content: "";
  transform: rotate(18deg);
}

.map-road {
  position: absolute;
  height: 14rpx;
  border: 2rpx solid #CBD8D2;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.map-road--one {
  top: 408rpx;
  left: -56rpx;
  width: 880rpx;
  transform: rotate(-9deg);
}

.map-road--two {
  top: 632rpx;
  left: 108rpx;
  width: 780rpx;
  transform: rotate(31deg);
}

.map-controls {
  position: absolute;
  z-index: 4;
  top: calc(40rpx + env(safe-area-inset-top, 0px));
  right: 24rpx;
  left: 24rpx;
  display: grid;
  gap: 16rpx;
}

.map-search-row,
.map-context-row {
  display: grid;
  gap: 16rpx;
}

.map-search-row {
  grid-template-columns: minmax(0, 1fr) 96rpx;
}

.map-context-row {
  grid-template-columns: minmax(0, 1fr) 248rpx;
}

.map-search,
.map-locate,
.map-center-copy,
.map-orders-action {
  box-sizing: border-box;
  height: 96rpx;
  border: 2rpx solid #10243E1A;
  background: #FFFFFFF7;
  box-shadow: 0 12rpx 40rpx #10243E1F;
}

.map-search,
.map-locate,
.map-orders-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  line-height: 1.4;
}

.map-search {
  justify-content: flex-start;
  gap: 20rpx;
  min-width: 0;
  padding: 0 30rpx;
  border-radius: 32rpx;
  color: #10243E;
  font-size: 28rpx;
  text-align: left;
}

.map-search-copy {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-icon {
  position: relative;
  box-sizing: border-box;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #526479;
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #526479;
  content: "";
  transform: rotate(45deg);
}

.map-locate {
  width: 96rpx;
  padding: 0;
  border-radius: 32rpx;
  color: #0369A1;
}

.map-locate--active {
  border-color: #0284C7;
  background: #F0F9FF;
}

.locate-icon {
  position: relative;
  box-sizing: border-box;
  width: 42rpx;
  height: 42rpx;
  border: 4rpx solid #0369A1;
  border-radius: 50%;
}

.locate-icon::before,
.locate-icon::after {
  position: absolute;
  background: #0369A1;
  content: "";
}

.locate-icon::before { top: -12rpx; bottom: -12rpx; left: 17rpx; width: 4rpx; }
.locate-icon::after { top: 17rpx; right: -12rpx; left: -12rpx; height: 4rpx; }

.locate-icon__dot {
  position: absolute;
  z-index: 1;
  top: 13rpx;
  left: 13rpx;
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 50%;
  background: #0369A1;
}

.map-center-copy {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 14rpx;
  padding: 0 24rpx;
  overflow: hidden;
  border-color: #BAE6FD;
  border-radius: 28rpx;
  color: #075985;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 24rpx #10243E14;
}

.map-center-label {
  flex: 0 0 auto;
  color: #526479;
  font-weight: 600;
}

.map-center-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-orders-action {
  position: relative;
  padding: 0 24rpx;
  border-color: #7DD3FC;
  border-radius: 28rpx;
  color: #075985;
  font-size: 26rpx;
  font-weight: 800;
  white-space: nowrap;
}

.order-icon {
  position: absolute;
  left: 24rpx;
  box-sizing: border-box;
  width: 34rpx;
  height: 40rpx;
  border: 3rpx solid #075985;
  border-radius: 3rpx;
}

.order-icon__line {
  position: absolute;
  left: 7rpx;
  width: 16rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #075985;
}

.order-icon__line--one { top: 9rpx; }
.order-icon__line--two { top: 17rpx; }
.order-icon__line--three { top: 25rpx; width: 11rpx; }

.map-control--pressed { background: #F0F9FF; }

.map-marker {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  width: 64rpx;
  height: 72rpx;
  border: 4rpx solid #526479;
  border-radius: 50% 50% 50% 8rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 8rpx #10243E38;
  transform: rotate(-45deg);
}

.map-marker--online { border-color: #FFFFFF; background: #0284C7; }
.map-marker--one { top: 306rpx; left: 124rpx; }
.map-marker--two { top: 500rpx; right: 132rpx; }
.map-marker--three { top: 638rpx; left: 284rpx; }

.map-marker__dot {
  width: 16rpx;
  height: 16rpx;
  margin: 20rpx auto 0;
  border: 3rpx solid #526479;
  border-radius: 50%;
  transform: rotate(45deg);
}

.map-marker--online .map-marker__dot { border-color: #FFFFFF; }

.map-sheet {
  position: absolute;
  z-index: 6;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  height: 796rpx;
  padding: 0 24rpx calc(32rpx + env(safe-area-inset-bottom, 0px));
  border-radius: 48rpx 48rpx 0 0;
  background: #FFFFFF;
  box-shadow: 0 -16rpx 56rpx #10243E26;
}

.map-sheet--expanded { height: 1080rpx; }

.map-sheet-handle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.map-sheet-handle view {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #B9C7D3;
}

.map-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68rpx;
}

.map-sheet-title { font-size: 40rpx; font-weight: 800; line-height: 56rpx; }
.map-sheet-count { color: #526479; font-size: 24rpx; }

.map-filters {
  display: flex;
  align-items: center;
  height: 104rpx;
  gap: 16rpx;
  overflow: hidden;
}

.map-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 2rpx solid #DBE5EC;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #10243E;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
}

.map-filter--selected { border-color: #7DD3FC; background: #F0F9FF; color: #075985; }
.map-filter--pressed { background: #EFFBF6; }

.map-venue-list {
  box-sizing: border-box;
  height: 496rpx;
}

.map-sheet--expanded .map-venue-list { height: 780rpx; }

.map-venue-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 88rpx;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 232rpx;
  gap: 16rpx;
  margin: 0 0 16rpx;
  padding: 22rpx 16rpx 22rpx 26rpx;
  border: 2rpx solid #DBE5EC;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #10243E;
  line-height: 1.4;
  text-align: left;
}

.map-venue-row--selected { border-color: #7DD3FC; background: #F0F9FF; }
.map-venue-row--pressed { background: #EFFBF6; }

.map-venue-main {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.map-venue-name,
.map-venue-address,
.map-venue-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-venue-name { font-size: 30rpx; font-weight: 800; line-height: 44rpx; }
.map-venue-address { margin-top: 8rpx; color: #526479; font-size: 24rpx; line-height: 36rpx; }
.map-venue-meta { margin-top: 8rpx; color: #075985; font-size: 24rpx; font-weight: 700; line-height: 36rpx; }

.map-row-chevron {
  box-sizing: border-box;
  width: 24rpx;
  height: 24rpx;
  margin: 0 auto;
  border-top: 4rpx solid #526479;
  border-right: 4rpx solid #526479;
  transform: rotate(45deg);
}

button::after { border: 0; }
