<view class="map-frame">
  <view class="map-canvas" aria-label="天津球场示意地图">
    <view class="map-road map-road--one"></view>
    <view class="map-road map-road--two"></view>
  </view>

  <view class="map-controls">
    <view class="map-search-row">
      <button class="map-search" hover-class="map-control--pressed" bindtap="onSearch" aria-label="更换搜索中心">
        <view class="search-icon" aria-hidden="true"></view>
        <text class="map-search-copy">搜索球场或地图地点</text>
      </button>
      <button class="map-locate {{locationActive ? 'map-locate--active' : ''}}" hover-class="map-control--pressed" bindtap="onLocate" aria-label="使用我的位置作为搜索中心">
        <view class="locate-icon" aria-hidden="true"><view class="locate-icon__dot"></view></view>
      </button>
    </view>

    <view class="map-context-row">
      <view class="map-center-copy">
        <text class="map-center-label">搜索中心</text>
        <text class="map-center-value">{{searchCenterName}}</text>
      </view>
      <button class="map-orders-action" hover-class="map-control--pressed" bindtap="onOpenOrders" aria-label="打开我的订单">
        <view class="order-icon" aria-hidden="true">
          <view class="order-icon__line order-icon__line--one"></view>
          <view class="order-icon__line order-icon__line--two"></view>
          <view class="order-icon__line order-icon__line--three"></view>
        </view>
        <text>我的订单</text>
      </button>
    </view>
  </view>

  <view class="map-marker map-marker--online map-marker--one" role="img" aria-label="渤海元丰足球场，可在线预订"><view class="map-marker__dot"></view></view>
  <view class="map-marker map-marker--two" role="img" aria-label="天津市人民体育馆足球场"><view class="map-marker__dot"></view></view>
  <view class="map-marker map-marker--three" role="img" aria-label="天津奥林匹克中心五人制足球场"><view class="map-marker__dot"></view></view>

  <view class="map-sheet {{sheetExpanded ? 'map-sheet--expanded' : ''}}">
    <button class="map-sheet-handle" bindtap="onToggleSheet" aria-label="{{sheetExpanded ? '收起球场列表' : '展开球场列表'}}"><view></view></button>
    <view class="map-sheet-head">
      <text class="map-sheet-title">天津球场</text>
      <text class="map-sheet-count">5 个已核验地点</text>
    </view>
    <view class="map-filters">
      <button
        wx:for="{{filters}}"
        wx:key="id"
        class="map-filter {{selectedFilterId === item.id ? 'map-filter--selected' : ''}}"
        hover-class="map-filter--pressed"
        data-filter-id="{{item.id}}"
        bindtap="onSelectFilter"
        aria-label="筛选：{{item.label}}"
      >{{item.label}}</button>
    </view>
    <scroll-view class="map-venue-list" scroll-y enhanced show-scrollbar="false">
      <button
        wx:for="{{venues}}"
        wx:key="id"
        class="map-venue-row {{index === 0 ? 'map-venue-row--selected' : ''}}"
        hover-class="map-venue-row--pressed"
        data-venue-id="{{item.id}}"
        bindtap="onOpenVenue"
        aria-label="查看{{item.name}}"
      >
        <view class="map-venue-main">
          <text class="map-venue-name">{{item.name}}</text>
          <text class="map-venue-address">{{item.address}}</text>
          <text class="map-venue-meta">{{item.meta}}</text>
        </view>
        <view class="map-row-chevron" aria-hidden="true"></view>
      </button>
    </scroll-view>
  </view>
</view>
