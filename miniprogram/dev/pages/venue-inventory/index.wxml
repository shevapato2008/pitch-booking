<view class="inventory-page">
  <view class="inventory-header" style="padding-top: {{headerTopPx}}px;">
    <view class="inventory-header__row" style="height: {{headerRowHeightPx}}px; padding-right: {{headerRightInsetPx}}px;">
      <view class="icon-back" aria-hidden="true"></view>
      <view class="inventory-header__identity">
        <text class="inventory-header__title">{{venue.name}}</text>
        <text class="inventory-header__subtitle">{{venueNote}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{mode === 'initial-loading' || mode === 'load-error'}}" class="initial-state">
    <view wx:if="{{mode === 'initial-loading'}}" class="loading-mark" aria-hidden="true"></view>
    <text>{{statusMessage}}</text>
    <button wx:if="{{recoveryLabel}}" class="secondary-button" bindtap="onRecovery">{{recoveryLabel}}</button>
  </view>

  <view wx:else class="inventory-content">
    <view class="month-row">
      <text class="month-title">2026年8月</text>
      <button class="text-button" bindtap="onOpenCalendar">更多日期</button>
    </view>

    <view class="week-strip" role="group" aria-label="当前自然周">
      <button wx:for="{{week}}" wx:key="iso" class="week-day {{item.iso === selectedDate ? 'week-day--selected' : ''}}" bindtap="onSelectDate" data-date="{{item.iso}}">
        <text>{{item.weekday}}</text><text class="week-day__number">{{item.day}}</text>
      </button>
    </view>

    <button class="current-pitch" bindtap="onOpenPitchPicker" disabled="{{writeControlsDisabled}}" aria-label="选择物理场地">
      <view class="current-pitch__copy">
        <text class="context-label">当前场地</text>
        <text class="current-pitch__value">{{selectedPitch.displayName}} · {{selectedPitch.playersPerSide}}人制</text>
      </view>
      <view class="icon-chevron" aria-hidden="true"></view>
    </button>

    <view class="inventory-summary">
      <text class="inventory-summary__date">{{selectedDateLabel}}</text>
      <text class="inventory-summary__count">{{slotCount === null ? '正在读取' : slotCount + ' 个时段'}}</text>
    </view>

    <view wx:if="{{statusMessage}}" class="status-callout status-callout--{{mode}}">
      <text>{{statusMessage}}</text>
      <button wx:if="{{recoveryLabel}}" class="inline-retry" bindtap="onRecovery">{{recoveryLabel}}</button>
    </view>

    <scroll-view class="inventory-list" scroll-y enhanced show-scrollbar="false" scroll-into-view="{{initializeAtEnd ? 'list-end' : ''}}">
      <view wx:if="{{mode === 'empty'}}" class="empty-state">当天还没有时段，可从下方新增第一条时段</view>
      <block wx:else>
        <view wx:for="{{slots}}" wx:key="id" class="slot-card {{!item.editable || writeControlsDisabled ? 'slot-card--readonly' : ''}}" bindtap="onSlotTap" data-slot-id="{{item.id}}" role="button" aria-label="{{item.start}}到{{item.end}}，{{item.statusLabel}}">
          <view class="slot-card__main">
            <text class="slot-card__title">{{item.start}}–{{item.end}} · ¥{{item.price}}</text>
            <text class="slot-card__detail">{{writeControlsDisabled && item.editable ? '权限已失效 · 不可修改' : item.detail}}</text>
          </view>
          <view class="status-badge status-badge--{{item.status}}"><text>{{item.statusLabel}}</text></view>
          <view class="icon-chevron {{item.editable && !writeControlsDisabled ? '' : 'icon-chevron--placeholder'}}" aria-hidden="true"></view>
        </view>
      </block>
      <view id="list-end" class="list-end"></view>
    </scroll-view>
  </view>

  <view class="inventory-footer">
    <text class="fixture-note">仅视觉预览，未写入库存</text>
    <button class="primary-button" bindtap="onOpenCreate" disabled="{{pageAction.disabled}}">＋ 新增时段</button>
  </view>

  <block wx:if="{{sheet}}">
    <view class="sheet-scrim" bindtap="onCloseOverlay" aria-hidden="true"></view>
    <view class="bottom-sheet" role="dialog" aria-modal="true" aria-label="{{sheet.title}}">
      <view class="sheet-handle" aria-hidden="true"></view>
      <view class="sheet-heading">
        <view><text class="sheet-title">{{sheet.title}}</text><text class="sheet-subtitle">{{sheet.kind === 'calendar' ? '未来 14 天' : '只显示使用中的物理场地'}}</text></view>
        <button class="close-button" bindtap="onCloseOverlay" aria-label="关闭"><view class="icon-close"></view></button>
      </view>
      <block wx:if="{{sheet.kind === 'pitch-picker'}}">
        <view wx:for="{{sheet.groups}}" wx:key="playersPerSide" class="pitch-group">
          <text class="pitch-group__title">{{item.playersPerSide}}人制</text>
          <button wx:for="{{item.pitches}}" wx:for-item="pitch" wx:key="id" class="pitch-option {{pitch.id === sheet.selectedPitchId ? 'pitch-option--selected' : ''}}" bindtap="onSelectPitch" data-pitch-id="{{pitch.id}}">
            <text>{{pitch.displayName}} · {{pitch.playersPerSide}}人制</text><text>{{pitch.id === sheet.selectedPitchId ? '当前' : '第 ' + pitch.sequence + ' 块'}}</text>
          </button>
        </view>
      </block>
      <block wx:else>
        <view class="calendar-weekdays"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view>
        <view class="calendar-grid">
          <button wx:for="{{sheet.days}}" wx:key="iso" class="calendar-day {{item.selected ? 'calendar-day--selected' : ''}}" disabled="{{!item.manageable}}" bindtap="onSelectDate" data-date="{{item.iso}}">{{item.day}}</button>
        </view>
        <view class="calendar-pending"><text>待确认日期</text><text>{{sheet.pendingLabel}}</text></view>
        <button class="primary-button" bindtap="onConfirmDate">确认日期</button>
      </block>
    </view>
  </block>

  <block wx:if="{{editor}}">
    <view class="sheet-scrim" bindtap="onCloseOverlay" aria-hidden="true"></view>
    <view class="bottom-sheet" role="dialog" aria-modal="true" aria-label="{{editor.title}}">
      <view class="sheet-handle"></view>
      <view class="sheet-heading">
        <view><text class="sheet-title">{{editor.title}}</text><text class="sheet-subtitle">{{statusMessage || '时间按 30 分钟递增'}}</text></view>
        <button class="close-button" bindtap="onCloseOverlay" disabled="{{editor.closeDisabled}}"><view class="icon-close"></view></button>
      </view>
      <view class="context-chips"><text wx:for="{{editor.contextChips}}" wx:key="*this">{{item}}</text></view>
      <view class="editor-field"><text>开始时间</text><button bindtap="onPreviewFieldTap" disabled="{{editor.timeReadOnly}}">{{editor.draft.start}}</button></view>
      <view class="editor-field"><text>结束时间</text><button bindtap="onPreviewFieldTap" disabled="{{editor.timeReadOnly}}">{{editor.draft.end}}</button></view>
      <view class="editor-field"><text>价格</text><button bindtap="onPreviewFieldTap">¥ {{editor.draft.price}}</button></view>
      <view wx:if="{{editor.inlineError}}" class="editor-error" role="alert"><text>{{editor.inlineError}}</text><text>最新库存中 {{editor.conflictingTime}} 已被占用。</text></view>
      <view wx:if="{{editor.reviewCopy}}" class="editor-warning">{{editor.reviewCopy}}</view>
      <view wx:if="{{visualState === 'permission-expired'}}" class="editor-error">权限已失效，请重新进入</view>
      <view class="sheet-actions"><button class="secondary-button" bindtap="onCloseOverlay" disabled="{{editor.closeDisabled}}">取消</button><button class="primary-button" bindtap="onPreviewSave" disabled="{{editor.saveDisabled}}">{{editor.saveLabel}}</button></view>
    </view>
  </block>
</view>
