.captain-game-page { min-height: 100vh; background: #F8FAFC; color: #10243E; font-size: 28rpx; }.captain-game-nav { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; padding: calc(env(safe-area-inset-top, 0px) + 8rpx) 32rpx 8rpx; background: #FFFFFF; font-size: 34rpx; font-weight: 700; }.captain-game-nav-back { display: flex; align-items: center; justify-content: center; width: 64rpx; min-height: 64rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #0369A1; font-size: 48rpx; }.captain-game-fixture, .captain-game-notice { color: #526479; font-size: 22rpx; }.captain-game-scroll { box-sizing: border-box; height: calc(100vh - 88rpx); padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom, 0px)); }.captain-game-notice { padding: 0 8rpx 12rpx; }.captain-game-card { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #DBE5EC; border-radius: 16rpx; background: #FFFFFF; }.captain-game-heading { font-size: 32rpx; font-weight: 700; }.captain-game-card-title { color: #0369A1; font-size: 24rpx; }.captain-game-readonly-note { margin: 20rpx 0; color: #526479; line-height: 40rpx; }button { box-sizing: border-box; }.captain-game-secondary { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 0; padding: 0 24rpx; border: 1rpx solid #0284C7; border-radius: 14rpx; background: #FFFFFF; color: #0369A1; font-size: 30rpx; }
