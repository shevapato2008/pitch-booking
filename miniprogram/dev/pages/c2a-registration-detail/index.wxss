.c2a-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 28rpx; }
.c2a-system { flex: 0 0 auto; background: #FFFFFF; }
.c2a-header { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; flex: 0 0 auto; box-sizing: border-box; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }
.c2a-header-back, .c2a-header-spacer { box-sizing: border-box; width: 88rpx; min-width: 88rpx; min-height: 88rpx; }
.c2a-header-back { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; }
.c2a-header-back::after, .c2a-secondary-action::after, .c2a-inline-action::after, .c2a-danger-action::after, .c2a-primary-action::after, .c2a-neutral-action::after { border: 0; }
.c2a-header-title { overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; font-weight: 700; line-height: 48rpx; }
.c2a-back-icon { position: relative; width: 40rpx; height: 40rpx; }
.c2a-back-icon::before { position: absolute; top: 9rpx; left: 7rpx; box-sizing: border-box; width: 22rpx; height: 22rpx; border-left: 4rpx solid #10243E; border-bottom: 4rpx solid #10243E; transform: rotate(45deg); content: ""; }
.c2a-back-icon::after { position: absolute; top: 18rpx; left: 8rpx; width: 27rpx; height: 4rpx; border-radius: 2rpx; background: #10243E; content: ""; }
.c2a-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; min-height: 0; }
.c2a-content { box-sizing: border-box; min-height: 100%; padding: 20rpx 24rpx calc(60rpx + env(safe-area-inset-bottom, 0px)); }
.c2a-content--with-footer { padding-bottom: calc(156rpx + env(safe-area-inset-bottom, 0px)); }
.c2a-preview-note { display: block; margin-bottom: 14rpx; color: #0369A1; font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.c2a-card { margin-bottom: 18rpx; padding: 28rpx; border: 1rpx solid #DBE5EC; border-radius: 28rpx; background: #FFFFFF; }
.c2a-confirmed { display: flex; align-items: center; gap: 14rpx; color: #047857; font-size: 24rpx; font-weight: 700; line-height: 36rpx; }
.c2a-confirmed-icon { position: relative; box-sizing: border-box; width: 36rpx; height: 36rpx; flex: 0 0 36rpx; border: 4rpx solid #047857; border-radius: 50%; }
.c2a-confirmed-icon::after { position: absolute; top: 7rpx; left: 8rpx; box-sizing: border-box; width: 14rpx; height: 8rpx; border-bottom: 4rpx solid #047857; border-left: 4rpx solid #047857; transform: rotate(-45deg); content: ""; }
.c2a-game-name, .c2a-game-time, .c2a-game-place { display: block; }
.c2a-game-name { margin-top: 14rpx; font-size: 40rpx; font-weight: 700; line-height: 56rpx; }
.c2a-game-time { margin-top: 8rpx; font-size: 28rpx; font-weight: 700; line-height: 42rpx; }
.c2a-game-place { margin-top: 4rpx; color: #526479; font-size: 24rpx; line-height: 36rpx; }
.c2a-tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.c2a-tag-row text { display: inline-flex; align-items: center; justify-content: center; min-height: 48rpx; padding: 4rpx 16rpx; border-radius: 24rpx; background: #F1F5F9; color: #526479; font-size: 22rpx; font-weight: 700; line-height: 32rpx; }
.c2a-status-card { margin-bottom: 18rpx; padding: 24rpx 28rpx; border: 1rpx solid #BAE6FD; border-radius: 28rpx; background: #F0F9FF; }
.c2a-status-card--joined { border-color: #A7F3D0; background: #ECFDF5; }
.c2a-status-card--neutral { border-color: #DBE5EC; background: #F1F5F9; }
.c2a-status-card--unknown { border-color: #BAE6FD; background: #FFFFFF; }
.c2a-status-card--error { border-color: #FECACA; background: #FEF2F2; }
.c2a-status-heading { display: flex; align-items: center; gap: 14rpx; font-size: 30rpx; font-weight: 700; line-height: 44rpx; }
.c2a-status-dot { width: 16rpx; height: 16rpx; flex: 0 0 auto; border-radius: 50%; background: #0369A1; }
.c2a-status-card--joined .c2a-status-dot { background: #047857; }
.c2a-status-card--neutral .c2a-status-dot { background: #64748B; }
.c2a-status-card--error .c2a-status-dot { background: #B42318; }
.c2a-status-copy, .c2a-terminal-note { display: block; margin: 8rpx 0 0 30rpx; color: #526479; font-size: 24rpx; line-height: 38rpx; }
.c2a-terminal-note { margin-top: 14rpx; font-weight: 700; }
.c2a-inline-action { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 22rpx 0 0; padding: 0 24rpx; border: 1rpx solid #F4C7C3; border-radius: 22rpx; background: #FFFFFF; color: #B42318; font-size: 26rpx; font-weight: 700; line-height: 38rpx; }
.c2a-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 18rpx; }
.c2a-metrics view { min-width: 0; padding: 18rpx 8rpx; border-radius: 22rpx; background: #F2F7FA; text-align: center; }
.c2a-metrics text { display: block; }
.c2a-metrics text:first-child { overflow: hidden; font-size: 24rpx; font-weight: 700; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.c2a-metrics text:last-child { margin-top: 4rpx; color: #526479; font-size: 20rpx; line-height: 30rpx; }
.c2a-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx 18rpx; }
.c2a-detail-grid view { min-width: 0; }
.c2a-detail-grid text { display: block; }
.c2a-detail-grid text:first-child { color: #64748B; font-size: 22rpx; line-height: 34rpx; }
.c2a-detail-grid text:last-child { margin-top: 4rpx; font-size: 25rpx; font-weight: 700; line-height: 38rpx; }
.c2a-risk-note { display: block; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #DBE5EC; color: #526479; font-size: 22rpx; line-height: 36rpx; }
.c2a-footer { box-sizing: border-box; flex: 0 0 auto; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom, 0px)); border-top: 1rpx solid #DBE5EC; background: rgba(255, 255, 255, .96); }
.c2a-danger-action, .c2a-primary-action, .c2a-neutral-action, .c2a-secondary-action { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 96rpx; margin: 0; padding: 0 24rpx; border-radius: 24rpx; font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.c2a-danger-action { border: 1rpx solid #F4C7C3; background: #FFF7F6; color: #B42318; }
.c2a-primary-action, .c2a-secondary-action { border: 1rpx solid #7DD3FC; background: #F0F9FF; color: #0369A1; }
.c2a-neutral-action { border: 1rpx solid #DBE5EC; background: #FFFFFF; color: #10243E; }
.c2a-scrim { position: fixed; z-index: 5; inset: 0; display: flex; align-items: flex-end; box-sizing: border-box; padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom, 0px)); background: rgba(16, 36, 62, .48); }
.c2a-sheet { box-sizing: border-box; width: 100%; padding: 20rpx 28rpx 28rpx; border-radius: 36rpx; background: #FFFFFF; box-shadow: 0 28rpx 64rpx rgba(16, 36, 62, .22); }
.c2a-sheet-handle { width: 68rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 4rpx; background: #CBD5E1; }
.c2a-sheet-title, .c2a-sheet-copy { display: block; }
.c2a-sheet-title { font-size: 36rpx; font-weight: 700; line-height: 50rpx; }
.c2a-sheet-copy { margin-top: 12rpx; color: #526479; font-size: 24rpx; line-height: 38rpx; }
.c2a-late-warning { margin-top: 20rpx; padding: 20rpx 22rpx; border: 1rpx solid #F4C7C3; border-radius: 20rpx; background: #FFF7F6; color: #B42318; }
.c2a-late-warning text { display: block; font-size: 23rpx; line-height: 36rpx; }
.c2a-late-warning text:first-child { font-weight: 700; }
.c2a-sheet-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 28rpx; }
.c2a-sheet-actions button { min-height: 88rpx; }
.c2a-state-card { margin-top: 20rpx; padding: 44rpx 32rpx; border: 1rpx solid #DBE5EC; border-radius: 28rpx; background: #FFFFFF; text-align: center; }
.c2a-state-title, .c2a-state-copy { display: block; }
.c2a-state-title { font-size: 36rpx; font-weight: 700; line-height: 52rpx; }
.c2a-state-copy { margin-top: 12rpx; color: #526479; font-size: 26rpx; line-height: 40rpx; }
.c2a-secondary-action { margin-top: 30rpx; }
.c2a-pressed { opacity: .68; }
button[disabled] { opacity: .54; }
