<view class="d1b-page">
  <view class="d1b-system" style="height: {{headerTopPx}}px;"></view>
  <view class="d1b-header" style="height: {{headerRowHeightPx}}px;">
    <button class="d1b-header-back" hover-class="d1b-pressed" bindtap="onHeaderBack" aria-label="返回"><view class="d1b-back-icon"></view></button>
    <text class="d1b-header-title">员工与权限</text><view class="d1b-header-spacer"></view>
  </view>

  <scroll-view class="d1b-scroll" scroll-y="true">
    <view class="d1b-content">
      <text class="d1b-kicker">D1b 开发预览 · 模拟数据</text>
      <view class="d1b-venue-card">
        <view><text class="d1b-eyebrow">{{canManage ? '负责人工作台' : '我的工作权限'}}</text><text class="d1b-venue-name">{{fixture.venue.name}}</text><text class="d1b-venue-location">{{fixture.venue.location}}</text></view>
        <text class="d1b-role-pill">{{canManage ? 'OWNER' : 'STAFF'}}</text>
      </view>

      <view wx:if="{{!canManage}}" class="d1b-boundary"><view class="d1b-boundary-mark">i</view><view><text>你只能查看自己的权限</text><text>成员邀请、权限变更和移除仅由场馆负责人操作。</text></view></view>
      <view wx:if="{{!canManage}}" class="d1b-member-card">
        <view class="d1b-member-top"><view class="d1b-avatar">{{selfMember.initials}}</view><view><text class="d1b-member-name">{{selfMember.displayName}}</text><text class="d1b-member-meta">{{selfMember.joinedAtLabel}}</text></view></view>
        <text class="d1b-permission-summary">{{selfMember.permissionSummary}}</text>
      </view>

      <block wx:if="{{canManage}}">
        <view class="d1b-section-head"><view><text>团队成员</text><text>{{members.length}} 人 · 服务端权限为准</text></view></view>
        <view wx:for="{{members}}" wx:key="id" class="d1b-member-card">
          <view class="d1b-member-top"><view class="d1b-avatar d1b-avatar--{{item.role === 'OWNER' ? 'owner' : 'staff'}}">{{item.initials}}</view><view class="d1b-member-copy"><view class="d1b-name-line"><text class="d1b-member-name">{{item.displayName}}</text><text class="d1b-small-pill">{{item.role}}</text></view><text class="d1b-member-meta">{{item.joinedAtLabel}}</text></view></view>
          <text class="d1b-permission-summary">{{item.permissionSummary}}</text>
          <button wx:if="{{item.role === 'STAFF'}}" class="d1b-secondary" data-membership-id="{{item.id}}" bindtap="onOpenEdit">编辑权限</button>
          <text wx:else class="d1b-owner-note">负责人拥有全部权限；负责人转移请联系平台处理</text>
        </view>

        <view class="d1b-section-head"><view><text>待接受邀请</text><text>权限在创建后不可编辑</text></view></view>
        <view wx:for="{{invitations}}" wx:key="id" class="d1b-invite-card d1b-invite-card--{{item.status === 'REVOKED' ? 'muted' : 'active'}}">
          <view class="d1b-invite-row"><view><text class="d1b-member-name">{{item.contactLabel}}</text><text class="d1b-member-meta">{{item.expiresAtLabel}}</text></view><text class="d1b-small-pill">{{item.status === 'ACTIVE' ? '待接受' : '已撤销'}}</text></view>
          <text class="d1b-permission-summary">{{item.permissionSummary}}</text>
          <button wx:if="{{item.status === 'ACTIVE'}}" class="d1b-danger-link" data-invitation-id="{{item.id}}" bindtap="onRevokeInvitation">撤销邀请</button>
        </view>
      </block>
      <text wx:if="{{feedback && sheet === 'none'}}" class="d1b-feedback">{{feedback}}</text>
      <view class="d1b-content-tail"></view>
    </view>
  </scroll-view>

  <view wx:if="{{canManage}}" class="d1b-bottom"><button class="d1b-primary" bindtap="onOpenCreate" hover-class="d1b-pressed">邀请员工</button><view class="d1b-safe-bottom"></view></view>

  <view wx:if="{{sheet !== 'none'}}" class="d1b-modal" aria-role="dialog">
    <view class="d1b-scrim" bindtap="onCloseSheet"></view>
    <view class="d1b-sheet">
      <view class="d1b-sheet-handle"></view>
      <block wx:if="{{sheet === 'create'}}">
        <text class="d1b-sheet-title">创建员工邀请</text><text class="d1b-sheet-copy">邀请有效 7 天，原始路径只展示一次。</text>
        <text class="d1b-field-label">内部称呼</text><input class="d1b-input" maxlength="40" value="{{draftContact}}" bindinput="onContactInput" placeholder="例如：夜班主管" />
        <text class="d1b-field-label">工作权限（至少一项）</text>
        <button wx:for="{{permissionChoices}}" wx:key="code" class="d1b-permission-choice d1b-permission-choice--{{item.selected ? 'selected' : 'plain'}}" data-permission="{{item.code}}" bindtap="onToggleDraftPermission"><view class="d1b-check">{{item.selected ? '✓' : ''}}</view><view><text>{{item.label}}</text><text>{{item.description}}</text></view></button>
        <text wx:if="{{feedback}}" class="d1b-field-error">{{feedback}}</text>
        <view class="d1b-sheet-actions"><button class="d1b-modal-button d1b-modal-button--quiet" bindtap="onCloseSheet">取消</button><button class="d1b-modal-button d1b-modal-button--primary" bindtap="onCreateInvitation">创建邀请</button></view>
      </block>
      <block wx:elif="{{sheet === 'created'}}">
        <text class="d1b-sheet-title">邀请已创建</text><text class="d1b-sheet-copy">{{feedback}}</text><text class="d1b-token-path">{{createdPath}}</text>
        <view class="d1b-sheet-actions"><button class="d1b-modal-button d1b-modal-button--quiet" bindtap="onCloseSheet">完成</button><button class="d1b-modal-button d1b-modal-button--primary" bindtap="onCopyInvitation">复制路径</button></view>
      </block>
      <block wx:elif="{{sheet === 'edit'}}">
        <text class="d1b-sheet-title">编辑员工权限</text><text class="d1b-sheet-copy">保存后，员工下一次操作会由服务端重新校验。</text>
        <button wx:for="{{permissionChoices}}" wx:key="code" class="d1b-permission-choice d1b-permission-choice--{{item.selected ? 'selected' : 'plain'}}" data-permission="{{item.code}}" bindtap="onToggleDraftPermission"><view class="d1b-check">{{item.selected ? '✓' : ''}}</view><view><text>{{item.label}}</text><text>{{item.description}}</text></view></button>
        <text wx:if="{{feedback}}" class="d1b-field-error">{{feedback}}</text>
        <button class="d1b-remove-link" data-membership-id="{{selectedMembershipId}}" bindtap="onPrepareRemove">停用这名员工</button>
        <view class="d1b-sheet-actions"><button class="d1b-modal-button d1b-modal-button--quiet" bindtap="onCloseSheet">取消</button><button class="d1b-modal-button d1b-modal-button--primary" bindtap="onSavePermissions">保存权限</button></view>
      </block>
      <block wx:else>
        <text class="d1b-sheet-title">确认停用员工？</text><text class="d1b-sheet-copy">停用后该员工不能继续管理本场馆，历史审计记录仍保留。</text>
        <view class="d1b-sheet-actions"><button class="d1b-modal-button d1b-modal-button--quiet" bindtap="onCloseSheet">返回检查</button><button class="d1b-modal-button d1b-modal-button--danger" bindtap="onConfirmRemove">确认停用</button></view>
      </block>
      <view class="d1b-safe-bottom"></view>
    </view>
  </view>
</view>
