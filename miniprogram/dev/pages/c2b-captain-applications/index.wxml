<view class="c2b-page">
  <view class="c2b-system" style="height: {{headerTopPx}}px;"></view>
  <view class="c2b-header" style="height: {{headerRowHeightPx}}px;">
    <button class="c2b-header-back" hover-class="c2b-pressed" bindtap="onHeaderBack" aria-label="返回">
      <view class="c2b-back-icon" aria-hidden="true"></view>
    </button>
    <text class="c2b-header-title">报名审核</text>
    <view class="c2b-header-spacer" aria-hidden="true"></view>
  </view>

  <scroll-view class="c2b-scroll" scroll-y="true">
    <view class="c2b-content">
      <text class="c2b-preview-note">{{fixtureNotice}}</text>

      <view class="c2b-context-card">
        <view>
          <text class="c2b-context-label">当前球局</text>
          <text class="c2b-context-name">{{game.gameName}}</text>
        </view>
        <view class="c2b-capacity">
          <text>{{capacityLabel}}</text>
          <text>剩余 {{remainingSpots}} 个名额</text>
        </view>
      </view>

      <view wx:if="{{noticeMessage}}" class="c2b-notice" role="status">
        <view class="c2b-notice-mark" aria-hidden="true"></view>
        <text>{{noticeMessage}}</text>
      </view>

      <block wx:if="{{hasPending}}">
        <text class="c2b-section-label">1 条待审核申请</text>
        <view class="c2b-applicant-card">
          <view class="c2b-applicant-top">
            <view class="c2b-avatar" aria-hidden="true"><text>候</text></view>
            <view class="c2b-applicant-title">
              <text>{{applicantName}}</text>
              <text>申请加入本场球局</text>
            </view>
            <text class="c2b-status-pill">待审核</text>
          </view>
          <view class="c2b-meta-grid">
            <view><text>意向位置</text><text>任意位置</text></view>
            <view><text>申请时间</text><text>{{applicantAppliedAtLabel}}</text></view>
          </view>
          <view class="c2b-note"><text>{{applicantNote}}</text></view>
          <text class="c2b-privacy">仅展示申请人主动填写的本场信息。</text>
        </view>

        <view class="c2b-full-note" role="note">
          <view class="c2b-full-dot" aria-hidden="true"></view>
          <view><text>当前球局已满员</text><text>可以按申请审核顺序加入候补，或婉拒本场申请。</text></view>
        </view>
      </block>

      <view wx:else class="c2b-empty" role="status">
        <view class="c2b-empty-mark" aria-hidden="true"><view></view><view></view><view></view></view>
        <text class="c2b-empty-title">当前没有待审核申请</text>
        <text class="c2b-empty-copy">处理结果已写入这份隔离 Fixture，可返回入口继续检查其他状态。</text>
        <button class="c2b-button c2b-button--secondary" hover-class="c2b-pressed" bindtap="onReturnScenario">返回场景入口</button>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{hasPending}}" class="c2b-footer">
    <view class="c2b-footer-actions">
      <button class="c2b-button c2b-button--neutral" hover-class="c2b-pressed" bindtap="onReject" disabled="{{!canReject}}">婉拒</button>
      <button class="c2b-button c2b-button--primary" hover-class="c2b-pressed" bindtap="onWaitlist" disabled="{{!canWaitlist}}">加入候补</button>
    </view>
  </view>

  <view wx:if="{{panel}}" class="c2b-scrim">
    <view class="c2b-sheet" role="dialog" aria-modal="true">
      <view class="c2b-sheet-title-row">
        <view>
          <text class="c2b-sheet-title">{{decisionTitle}}</text>
          <text class="c2b-sheet-copy">{{decisionCopy}}</text>
        </view>
        <button class="c2b-sheet-close" hover-class="c2b-pressed" bindtap="onClosePanel" aria-label="关闭确认层">
          <view class="c2b-close-icon" aria-hidden="true"></view>
        </button>
      </view>
      <view class="c2b-sheet-actions">
        <button class="c2b-button c2b-button--neutral" hover-class="c2b-pressed" bindtap="onClosePanel">返回审核</button>
        <button class="c2b-button {{panel === 'REJECT' ? 'c2b-button--danger' : 'c2b-button--primary'}}" hover-class="c2b-pressed" bindtap="onConfirmDecision">{{decisionButton}}</button>
      </view>
    </view>
  </view>
</view>
