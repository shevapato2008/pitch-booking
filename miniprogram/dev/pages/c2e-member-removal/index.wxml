<view class="c2e-page">
  <view class="c2e-system" style="height: {{headerTopPx}}px;"></view>
  <view class="c2e-header" style="height: {{headerRowHeightPx}}px;" aria-hidden="{{removalPanel ? true : false}}">
    <button class="c2e-header-back" hover-class="c2e-pressed" bindtap="onHeaderBack" aria-label="返回 C2e 场景入口"><view class="c2e-back-icon" aria-hidden="true"></view></button>
    <text class="c2e-header-title">成员管理</text><view class="c2e-header-spacer" aria-hidden="true"></view>
  </view>
  <scroll-view class="c2e-scroll" scroll-y="true" aria-hidden="{{removalPanel ? true : false}}">
    <view class="c2e-content">
      <text class="c2e-preview-note">{{fixtureNotice}}</text>
      <view class="c2e-game-card">
        <view class="c2e-game-heading"><view class="c2e-game-icon" aria-hidden="true"></view><text>赛前成员管理</text></view>
        <text class="c2e-game-name">{{game.gameName}}</text><text class="c2e-game-time">{{game.dateTimeLabel}}</text><text class="c2e-game-place">{{game.placeLabel}}</text>
      </view>

      <view wx:if="{{previewState === 'BLOCKED'}}" class="c2e-recovery-card" aria-role="status">
        <view class="c2e-recovery-copy"><text>当前名单只能查看</text><text>{{previewMessage}}</text></view>
        <button class="c2e-state-action c2e-state-action--secondary" hover-class="c2e-pressed" bindtap="onResolveBlocker">切换到可移除名单</button>
      </view>
      <view wx:elif="{{previewState === 'UNKNOWN_RESULT'}}" class="c2e-recovery-card" aria-role="status">
        <view class="c2e-recovery-copy"><text>移除结果待确认</text><text>{{previewMessage}}</text></view>
        <button class="c2e-state-action c2e-state-action--primary" hover-class="c2e-pressed" bindtap="onConfirmUnknownResult">确认原移除结果</button>
        <button class="c2e-state-action c2e-state-action--neutral" hover-class="c2e-pressed" bindtap="onReturnScenario">关闭并稍后确认</button>
      </view>
      <text wx:if="{{notice}}" class="c2e-notice" aria-role="status">{{notice}}</text>
      <view class="c2e-summary-row"><text>正式成员</text><text>{{summaryLabel}}</text></view>
      <view wx:if="{{isEmpty}}" class="c2e-state-card" aria-role="status">
        <text class="c2e-state-title">本场暂无正式成员</text><text class="c2e-state-copy">候补成员不能在本页移除。</text>
        <button class="c2e-state-action c2e-state-action--secondary" hover-class="c2e-pressed" bindtap="onReturnScenario">返回场景入口</button>
      </view>
      <view wx:else class="c2e-roster">
        <view wx:for="{{members}}" wx:key="registrationId" class="c2e-member-card">
          <view class="c2e-member-top">
            <view class="c2e-member-identity"><text class="c2e-member-name">{{item.displayName}}</text><text class="c2e-member-position">意向位置 · {{item.positionLabel}}</text></view>
            <text class="c2e-source-badge">{{item.sourceLabel}}</text>
          </view>
          <text class="c2e-joined-time">{{item.joinedTimeLabel}}</text>
          <button wx:if="{{item.canRemove && previewState === 'READY'}}" class="c2e-row-action" hover-class="c2e-pressed" bindtap="onOpenRemoval" data-registration-id="{{item.registrationId}}" aria-label="从球局移除{{item.displayName}}">移除成员</button>
          <text wx:else class="c2e-blocked-label">{{item.blockedLabel || '恢复完成后可以继续管理'}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{removalPanel}}" class="c2e-scrim" catchtouchmove="onBlockTouchMove" aria-role="dialog" aria-modal="true" aria-label="移除成员确认">
    <view class="c2e-sheet">
      <view class="c2e-sheet-title-row">
        <view class="c2e-sheet-heading" tabindex="0"><text class="c2e-sheet-title">确认移除成员？</text><text class="c2e-sheet-member">本场称呼：{{removalMemberName}}</text></view>
        <button class="c2e-sheet-close" hover-class="c2e-pressed" bindtap="onCloseRemoval" aria-label="关闭确认层"><view class="c2e-close-icon" aria-hidden="true"></view></button>
      </view>
      <text class="c2e-sheet-warning">移除后不可恢复。仅当移除前正式成员已满时，系统才会按顺序递补第一位候补。</text>
      <view class="c2e-field">
        <view class="c2e-field-label-row"><text class="c2e-field-label">移除原因（必填）</text><text class="c2e-field-count {{reasonCount > 120 ? 'c2e-field-count--error' : ''}}">{{reasonCount}} / 120</text></view>
        <textarea class="c2e-reason-input" maxlength="-1" value="{{reasonInput}}" bindinput="onReasonInput" placeholder="请填写简短原因，不要填写联系方式" aria-label="移除原因"></textarea>
        <text wx:if="{{reasonError}}" class="c2e-field-error" aria-role="alert">{{reasonError}}</text>
      </view>
      <view class="c2e-sheet-actions">
        <button class="c2e-sheet-action c2e-sheet-action--neutral" hover-class="c2e-pressed" bindtap="onCloseRemoval">返回名单</button>
        <button class="c2e-sheet-action c2e-sheet-action--danger" hover-class="c2e-pressed" bindtap="onConfirmRemoval" disabled="{{confirmDisabled}}">确认移除</button>
      </view>
    </view>
  </view>
</view>
