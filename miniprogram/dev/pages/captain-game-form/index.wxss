.captain-game-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 28rpx; }.captain-game-system { flex: 0 0 auto; background: #FFFFFF; }
.captain-game-nav { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; flex: 0 0 auto; box-sizing: border-box; background: #FFFFFF; font-size: 34rpx; font-weight: 700; }.captain-game-nav-back { display: flex; align-items: center; justify-content: center; width: 88rpx; min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #0369A1; font-size: 48rpx; }.captain-game-nav-title { overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; }.captain-game-nav-subtitle { text-align: center; color: #526479; font-size: 22rpx; font-weight: 400; }
.captain-game-fixture, .captain-game-notice, .captain-game-help { color: #526479; font-size: 22rpx; line-height: 34rpx; }
.captain-game-scroll { box-sizing: border-box; flex: 1 1 auto; height: auto; padding: 20rpx 24rpx 196rpx; }
.captain-game-notice { padding: 0 8rpx 12rpx; }
.captain-game-card { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #DBE5EC; border-radius: 16rpx; background: #FFFFFF; }
.captain-game-card-title, .captain-game-stepper-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.captain-game-card-title { color: #0369A1; font-size: 24rpx; }.captain-game-heading { font-size: 30rpx; font-weight: 700; }.captain-game-error { border-color: #FECACA; color: #B91C1C; }
.captain-game-stepper { display: flex; align-items: center; gap: 16rpx; }.captain-game-stepper__button { display: flex; align-items: center; justify-content: center; width: 88rpx; min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border: 1rpx solid #B8C8D6; border-radius: 12rpx; background: #FFFFFF; color: #0369A1; }
.captain-game-inline-error { color: #B91C1C; font-size: 24rpx; }.captain-game-hidden-copy { display: none; }
.captain-game-footer { position: fixed; right: 0; bottom: 0; left: 0; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom, 0px)); border-top: 1rpx solid #DBE5EC; background: #FFFFFF; }
button { box-sizing: border-box; }.captain-game-primary, .captain-game-secondary { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 14rpx; font-size: 30rpx; }.captain-game-primary { display: flex; align-items: center; justify-content: center; background: #0284C7; color: #FFFFFF; }.captain-game-secondary { display: flex; align-items: center; justify-content: center; margin-top: 20rpx; border: 1rpx solid #0284C7; background: #FFFFFF; color: #0369A1; }
