page {
  --page: #F8FAFC;
  --surface: #FFFFFF;
  --text: #10243E;
  --muted: #64748B;
  --border: #DBE5EC;
  --primary-strong: #0369A1;
  --success: #047857;
  --success-soft: #ECFDF5;
  --error: #C42525;
  height: 100%;
  background: var(--page);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button,
scroll-view { box-sizing: border-box; }

button {
  min-width: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: inherit;
  margin: 0;
}

button::after { border: 0; }

.venue-profile-public { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: var(--page); }
.venue-profile-public__system,
.venue-profile-public__header { flex: 0 0 auto; background: var(--surface); }
.venue-profile-public__header { position: relative; display: flex; min-height: 88rpx; align-items: center; justify-content: center; padding-left: 24rpx; border-bottom: 2rpx solid var(--border); }
.venue-profile-public__back { position: absolute; top: 0; left: 16rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; }
.venue-profile-public__title,
.venue-profile-public__venue-heading { font-size: 36rpx; font-weight: 750; line-height: 52rpx; }
.venue-profile-public__scroll { flex: 1 1 auto; min-height: 0; }
.venue-profile-public__content { padding: 32rpx 24rpx; padding-bottom: 240rpx; }
.venue-profile-public__venue-heading { display: block; margin: 0 8rpx 24rpx; }
.venue-profile-public__touch { min-width: 88rpx; min-height: 88rpx; }

.venue-profile-public__status { display: flex; gap: 20rpx; margin-bottom: 32rpx; padding: 24rpx; border: 2rpx solid var(--border); border-left: 8rpx solid var(--success); border-radius: 24rpx; background: var(--success-soft); }
.venue-profile-public__status-mark { display: flex; width: 48rpx; height: 48rpx; flex: 0 0 auto; align-items: center; justify-content: center; border: 4rpx solid currentColor; border-radius: 50%; color: var(--success); font-size: 24rpx; font-weight: 800; }
.venue-profile-public__status-title { display: block; font-size: 28rpx; font-weight: 750; line-height: 40rpx; }
.venue-profile-public__status-detail { display: block; margin-top: 4rpx; color: var(--muted); font-size: 24rpx; line-height: 36rpx; }

.venue-profile-public__card { margin-bottom: 24rpx; padding: 28rpx; border: 2rpx solid var(--border); border-radius: 28rpx; background: var(--surface); }
.venue-profile-public__section-title { display: block; margin-bottom: 16rpx; font-size: 30rpx; font-weight: 750; line-height: 44rpx; }
.venue-profile-public__description { display: block; color: #334155; font-size: 28rpx; line-height: 44rpx; white-space: pre-wrap; }

.venue-profile-public-scene { position: relative; width: 100%; padding-top: 56.25%; overflow: hidden; border-radius: 22rpx; background: #DFF3FC; }
.venue-profile-public-scene__sky,
.venue-profile-public-scene__field { position: absolute; right: 0; left: 0; }
.venue-profile-public-scene__sky { top: 0; height: 56%; background: #CDEFFC; }
.venue-profile-public-scene__field { bottom: 0; height: 44%; background: #409A68; }
.venue-profile-public-scene--sideline .venue-profile-public-scene__sky { background: #E3F4FB; }
.venue-profile-public-scene--sideline .venue-profile-public-scene__field { background: #357F5B; }
.venue-profile-public-scene--service .venue-profile-public-scene__sky { background: #D7EAF3; }
.venue-profile-public-scene--service .venue-profile-public-scene__field { background: #D2B48C; }
.venue-profile-public-scene__halfway { position: absolute; bottom: 0; left: 50%; width: 4rpx; height: 44%; background: rgba(255,255,255,.86); transform: translateX(-50%); }
.venue-profile-public-scene__circle { position: absolute; bottom: 8%; left: 50%; width: 72rpx; height: 72rpx; border: 5rpx solid rgba(255,255,255,.86); border-radius: 50%; transform: translateX(-50%); }
.venue-profile-public-scene__goal { position: absolute; bottom: 42%; left: 10%; width: 84rpx; height: 50rpx; border: 7rpx solid rgba(16,36,62,.72); border-bottom: 0; }

.venue-profile-public__gallery { width: 100%; margin-top: 16rpx; white-space: nowrap; }
.venue-profile-public__thumb { display: inline-flex; width: 144rpx; height: 96rpx; min-height: 88rpx; margin-right: 16rpx; overflow: hidden; border: 4rpx solid transparent; border-radius: 18rpx; vertical-align: top; }
.venue-profile-public__thumb--selected { border-color: var(--primary-strong); }
.venue-profile-public__thumb-color { width: 100%; height: 100%; background: #409A68; }
.venue-profile-public__thumb-color--sideline { background: #357F5B; }
.venue-profile-public__thumb-color--service { background: #D2B48C; }

.venue-profile-public__facilities { display: flex; flex-wrap: wrap; gap: 16rpx; }
.venue-profile-public__facility { padding: 14rpx 20rpx; border-radius: 999rpx; background: #F1F5F9; color: #334155; font-size: 24rpx; line-height: 36rpx; }
.venue-profile-public__price { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; font-size: 28rpx; }
.venue-profile-public__price-value { color: var(--error); font-size: 38rpx; font-weight: 750; }
.venue-profile-public__artifact-note { display: block; margin: 12rpx 4rpx 24rpx; color: var(--muted); font-size: 22rpx; text-align: center; }

.venue-profile-public__footer { position: fixed; z-index: 5; right: 0; bottom: 0; left: 0; padding: 20rpx 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom, 0px)); border-top: 2rpx solid var(--border); background: rgba(255,255,255,.98); box-shadow: 0 -16rpx 48rpx rgba(16,36,62,.10); }
.venue-profile-public__footer-note { display: block; margin-bottom: 12rpx; color: var(--muted); font-size: 22rpx; text-align: center; }
.venue-profile-public__primary { display: flex; width: 100%; min-height: 96rpx; align-items: center; justify-content: center; padding: 16rpx 32rpx; border: 2rpx solid var(--primary-strong); border-radius: 22rpx; background: var(--primary-strong); color: var(--surface); font-size: 30rpx; font-weight: 750; }

.venue-profile-public-icon { position: relative; display: inline-flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; }
.venue-profile-public-icon--back::before { content: ""; width: 16rpx; height: 16rpx; border-bottom: 4rpx solid currentColor; border-left: 4rpx solid currentColor; transform: rotate(45deg); }
