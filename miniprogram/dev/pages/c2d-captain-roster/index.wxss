.c2d-page { display: flex; height: 100vh; flex-direction: column; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 28rpx; }
.c2d-system { flex: 0 0 auto; background: #FFFFFF; }
.c2d-header { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; box-sizing: border-box; flex: 0 0 auto; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }
.c2d-header-back { display: flex; width: 88rpx; min-width: 88rpx; min-height: 88rpx; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; padding: 0; border: 0; background: transparent; }
.c2d-header-spacer { box-sizing: border-box; width: 88rpx; min-width: 88rpx; min-height: 88rpx; }
.c2d-header-back::after, .c2d-copy-button::after { border: 0; }
.c2d-header-title { overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; font-weight: 700; line-height: 48rpx; }
.c2d-back-icon { position: relative; width: 40rpx; height: 40rpx; }
.c2d-back-icon::before { position: absolute; top: 9rpx; left: 7rpx; box-sizing: border-box; width: 22rpx; height: 22rpx; border-left: 4rpx solid #10243E; border-bottom: 4rpx solid #10243E; transform: rotate(45deg); content: ""; }
.c2d-back-icon::after { position: absolute; top: 18rpx; left: 8rpx; width: 27rpx; height: 4rpx; border-radius: 2rpx; background: #10243E; content: ""; }
.c2d-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; min-height: 0; }
.c2d-content { box-sizing: border-box; min-height: 100%; padding: 24rpx 24rpx calc(64rpx + env(safe-area-inset-bottom, 0px)); }
.c2d-preview-note, .c2d-eyebrow, .c2d-game-name, .c2d-game-meta, .c2d-game-time, .c2d-player-name, .c2d-player-position, .c2d-status-label, .c2d-status-badge, .c2d-timeline text, .c2d-registration-label, .c2d-registration-id, .c2d-copy-feedback, .c2d-privacy-note { display: block; }
.c2d-preview-note { margin: 0 4rpx 16rpx; color: #0369A1; font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.c2d-game-card, .c2d-player-card { box-sizing: border-box; border: 1rpx solid #DBE5EC; border-radius: 28rpx; background: #FFFFFF; }
.c2d-game-card { padding: 28rpx; }
.c2d-game-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.c2d-game-heading > view { min-width: 0; }
.c2d-eyebrow { color: #0369A1; font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.c2d-game-name { margin-top: 4rpx; overflow: hidden; font-size: 34rpx; font-weight: 700; line-height: 48rpx; text-overflow: ellipsis; white-space: nowrap; }
.c2d-complete-badge, .c2d-correction-badge { display: flex; min-height: 52rpx; flex: 0 0 auto; align-items: center; justify-content: center; box-sizing: border-box; padding: 2rpx 16rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 700; line-height: 32rpx; white-space: nowrap; }
.c2d-complete-badge { background: #ECFDF5; color: #047857; }
.c2d-correction-badge { background: #F0F9FF; color: #0369A1; }
.c2d-game-meta { margin-top: 10rpx; color: #526479; font-size: 23rpx; line-height: 36rpx; }
.c2d-game-time { margin-top: 4rpx; font-size: 25rpx; font-weight: 700; line-height: 38rpx; }
.c2d-progress { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #DBE5EC; color: #526479; font-size: 22rpx; line-height: 34rpx; }
.c2d-progress text:last-child { color: #10243E; font-size: 26rpx; font-weight: 700; }
.c2d-section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; margin: 28rpx 4rpx 16rpx; }
.c2d-section-heading > view { display: flex; min-width: 0; flex-direction: column; }
.c2d-section-heading > view text:first-child { color: #526479; font-size: 21rpx; line-height: 32rpx; }
.c2d-section-heading > view text:last-child { margin-top: 2rpx; font-size: 30rpx; font-weight: 700; line-height: 42rpx; }
.c2d-roster { display: grid; gap: 18rpx; }
.c2d-player-card { padding: 26rpx; }
.c2d-player-main { display: grid; grid-template-columns: minmax(0, 1fr) 176rpx; align-items: flex-start; gap: 20rpx; }
.c2d-player-identity { display: flex; min-width: 0; flex-direction: column; }
.c2d-player-name { overflow-wrap: anywhere; font-size: 29rpx; font-weight: 700; line-height: 42rpx; }
.c2d-player-position { margin-top: 5rpx; color: #526479; font-size: 21rpx; line-height: 32rpx; }
.c2d-status-column { display: flex; width: 176rpx; align-items: stretch; flex-direction: column; }
.c2d-status-label { color: #64748B; text-align: center; font-size: 19rpx; line-height: 30rpx; }
.c2d-status-badge { width: 100%; min-height: 52rpx; align-items: center; justify-content: center; box-sizing: border-box; margin-top: 4rpx; padding: 2rpx 12rpx; border-radius: 999rpx; text-align: center; font-size: 21rpx; font-weight: 700; line-height: 32rpx; }
.c2d-status-badge--present { background: #ECFDF5; color: #047857; }
.c2d-status-badge--no-show { background: #FEF2F2; color: #B42318; }
.c2d-timeline { display: grid; gap: 8rpx; margin-top: 22rpx; padding: 20rpx 0; border-top: 1rpx solid #E2E8F0; border-bottom: 1rpx solid #E2E8F0; }
.c2d-timeline text { color: #526479; font-size: 22rpx; line-height: 34rpx; }
.c2d-timeline text:last-child { color: #0369A1; font-weight: 700; }
.c2d-registration { margin-top: 20rpx; }
.c2d-registration-label { color: #64748B; font-size: 20rpx; line-height: 30rpx; }
.c2d-registration-id { margin-top: 4rpx; overflow-wrap: anywhere; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 20rpx; line-height: 30rpx; }
.c2d-copy-button { display: flex; width: 100%; min-height: 88rpx; align-items: center; justify-content: center; box-sizing: border-box; margin: 18rpx 0 0; padding: 0 20rpx; border: 1rpx solid #7DD3FC; border-radius: 20rpx; background: #F0F9FF; color: #0369A1; font-size: 26rpx; font-weight: 700; line-height: 38rpx; }
.c2d-copy-feedback { min-height: 34rpx; margin-top: 8rpx; text-align: center; font-size: 21rpx; line-height: 34rpx; }
.c2d-copy-feedback--success { color: #047857; font-weight: 700; }
.c2d-copy-feedback--error { color: #B42318; font-weight: 700; }
.c2d-privacy-note { margin: 22rpx 4rpx 0; color: #64748B; font-size: 21rpx; line-height: 34rpx; }
.c2d-pressed { opacity: .68; }
