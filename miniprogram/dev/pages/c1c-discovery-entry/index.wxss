.c1c-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 28rpx; }
.c1c-system { flex: 0 0 auto; background: #FFFFFF; }
.c1c-header { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; flex: 0 0 auto; box-sizing: border-box; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }
.c1c-header-back, .c1c-header-spacer { box-sizing: border-box; width: 88rpx; min-width: 88rpx; min-height: 88rpx; }
.c1c-header-back { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; }
.c1c-header-back::after, .c1c-mine-entry::after, .c1c-date-chip::after, .c1c-filter-chip::after, .c1c-game-card::after, .c1c-secondary-action::after { border: 0; }
.c1c-header-title { overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; font-weight: 700; line-height: 48rpx; }
.c1c-back-icon { position: relative; width: 40rpx; height: 40rpx; }
.c1c-back-icon::before { position: absolute; top: 9rpx; left: 7rpx; box-sizing: border-box; width: 22rpx; height: 22rpx; border-left: 4rpx solid #10243E; border-bottom: 4rpx solid #10243E; transform: rotate(45deg); content: ""; }
.c1c-back-icon::after { position: absolute; top: 18rpx; left: 8rpx; width: 27rpx; height: 4rpx; border-radius: 2rpx; background: #10243E; content: ""; }
.c1c-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; min-height: 0; }
.c1c-content { box-sizing: border-box; min-height: 100%; padding: 24rpx 24rpx calc(64rpx + env(safe-area-inset-bottom, 0px)); }
.c1c-preview-note, .c1c-context { display: block; }
.c1c-preview-note { color: #0369A1; font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.c1c-context { color: #526479; font-size: 26rpx; line-height: 40rpx; }
.c1c-mine-entry { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 22rpx 0 0; padding: 0 70rpx 0 28rpx; border: 1rpx solid #DBE5EC; border-radius: 24rpx; background: #FFFFFF; color: #0369A1; font-size: 28rpx; font-weight: 700; line-height: 40rpx; text-align: left; }
.c1c-mine-entry > text { width: 100%; }
.c1c-filters { margin: 22rpx -24rpx 0; padding: 0 24rpx 24rpx; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }
.c1c-date-strip { width: 100%; white-space: nowrap; }
.c1c-date-strip__inner { display: inline-flex; gap: 16rpx; padding-bottom: 16rpx; }
.c1c-date-chip, .c1c-filter-chip, .c1c-secondary-action { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; margin: 0; border: 1rpx solid #DBE5EC; background: #FFFFFF; color: #526479; font-size: 26rpx; line-height: 38rpx; }
.c1c-date-chip { flex: 0 0 auto; min-width: 130rpx; padding: 0 24rpx; border-radius: 44rpx; }
.c1c-filter-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; }
.c1c-filter-chip { width: 100%; padding: 0 20rpx; border-radius: 24rpx; }
.c1c-filter-active { border-color: #7DD3FC; background: #F0F9FF; color: #0369A1; font-weight: 700; }
.c1c-down-icon { box-sizing: border-box; width: 14rpx; height: 14rpx; margin: -8rpx 0 0 16rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.c1c-toggle-dot { box-sizing: border-box; width: 32rpx; height: 32rpx; margin-right: 14rpx; border: 3rpx solid #94A3B8; border-radius: 50%; background: #FFFFFF; }
.c1c-filter-active .c1c-toggle-dot { border: 10rpx solid #047857; }
.c1c-result-line { display: flex; align-items: center; justify-content: space-between; min-height: 78rpx; color: #64748B; font-size: 24rpx; line-height: 36rpx; }
.c1c-result-count { color: #10243E; font-weight: 700; }
.c1c-game-list { display: grid; gap: 20rpx; }
.c1c-game-card { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 296rpx; margin: 0; padding: 26rpx 66rpx 26rpx 26rpx; overflow: hidden; border: 1rpx solid #DBE5EC; border-radius: 28rpx; background: #FFFFFF; color: #10243E; text-align: left; }
.c1c-card-body { display: block; width: 100%; min-width: 0; }
.c1c-card-status { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; color: #047857; font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.c1c-card-status text:last-child { padding: 4rpx 14rpx; border-radius: 20rpx; background: #ECFDF5; }
.c1c-game-name, .c1c-game-time, .c1c-game-place { display: block; }
.c1c-game-name { margin-top: 8rpx; font-size: 34rpx; font-weight: 700; line-height: 48rpx; }
.c1c-game-time { margin-top: 6rpx; font-size: 28rpx; font-weight: 700; line-height: 42rpx; }
.c1c-game-place { margin-top: 4rpx; overflow: hidden; color: #526479; font-size: 24rpx; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.c1c-format-badge { display: inline-flex; align-items: center; justify-content: center; min-height: 40rpx; margin-top: 14rpx; padding: 2rpx 14rpx; border-radius: 20rpx; background: #F1F5F9; color: #526479; font-size: 20rpx; line-height: 32rpx; }
.c1c-chevron { position: absolute; top: 50%; right: 28rpx; box-sizing: border-box; width: 18rpx; height: 18rpx; border-top: 4rpx solid #64748B; border-right: 4rpx solid #64748B; transform: translateY(-50%) rotate(45deg); }
.c1c-state-card { margin-top: 26rpx; padding: 44rpx 32rpx; border: 1rpx solid #DBE5EC; border-radius: 28rpx; background: #FFFFFF; text-align: center; }
.c1c-state-card--error { border-color: #FECACA; background: #FEF2F2; }
.c1c-state-title, .c1c-state-copy { display: block; }
.c1c-state-title { font-size: 36rpx; font-weight: 700; line-height: 52rpx; }
.c1c-state-card--error .c1c-state-title { color: #B42318; }
.c1c-state-copy { margin-top: 12rpx; color: #526479; font-size: 26rpx; line-height: 40rpx; }
.c1c-secondary-action { width: 100%; margin-top: 30rpx; padding: 0 24rpx; border-color: #7DD3FC; border-radius: 22rpx; background: #F0F9FF; color: #0369A1; font-weight: 700; }
.c1c-skeleton { min-height: 296rpx; border: 1rpx solid #DBE5EC; border-radius: 28rpx; background: #FFFFFF; }
.c1c-pressed { opacity: .68; }
