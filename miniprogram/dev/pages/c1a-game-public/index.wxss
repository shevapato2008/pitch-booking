.c1a-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 24rpx; }
.c1a-system { flex: 0 0 auto; background: #FFFFFF; }
.c1a-nav { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; box-sizing: border-box; flex: 0 0 auto; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }
.c1a-nav-copy { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; }
.c1a-nav-title { overflow: hidden; font-size: 32rpx; font-weight: 700; line-height: 42rpx; text-overflow: ellipsis; white-space: nowrap; }
.c1a-nav-subtitle { color: #0369A1; font-size: 20rpx; font-weight: 700; line-height: 28rpx; }
.c1a-nav-spacer { width: 88rpx; height: 88rpx; }
.c1a-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; padding: 24rpx 24rpx calc(200rpx + env(safe-area-inset-bottom, 0px)); }
.c1a-section { margin-bottom: 20rpx; }
.c1a-card { box-sizing: border-box; padding: 24rpx; border: 1rpx solid #DBE5EC; border-radius: 28rpx; background: #FFFFFF; }
.c1a-state-card { display: flex; flex-direction: column; gap: 20rpx; margin-top: 20rpx; }
.c1a-heading { font-size: 30rpx; font-weight: 700; line-height: 42rpx; }
.c1a-help { color: #526479; font-size: 24rpx; line-height: 36rpx; }
.c1a-confirmed-row { display: flex; align-items: flex-start; gap: 20rpx; }
.c1a-confirmed-mark { position: relative; flex: 0 0 auto; box-sizing: border-box; width: 36rpx; height: 36rpx; margin-top: 2rpx; border: 4rpx solid #047857; border-radius: 50%; }
.c1a-confirmed-mark::after { position: absolute; top: 7rpx; left: 7rpx; width: 12rpx; height: 7rpx; border-bottom: 4rpx solid #047857; border-left: 4rpx solid #047857; content: ""; transform: rotate(-45deg); }
.c1a-confirmed-copy { display: flex; min-width: 0; flex-direction: column; }
.c1a-confirmed-title { font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.c1a-game-hero { display: flex; flex-direction: column; }
.c1a-eyebrow { margin-bottom: 6rpx; color: #047857; font-size: 22rpx; font-weight: 700; line-height: 32rpx; }
.c1a-game-title { font-size: 40rpx; font-weight: 700; line-height: 54rpx; letter-spacing: -1rpx; }
.c1a-game-subtitle { margin-top: 6rpx; color: #526479; font-size: 24rpx; line-height: 36rpx; }
.c1a-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }
.c1a-metric { display: flex; min-width: 0; min-height: 84rpx; flex-direction: column; align-items: center; justify-content: center; padding: 18rpx 8rpx; border-radius: 22rpx; background: #F6F9FB; color: #526479; font-size: 20rpx; line-height: 30rpx; text-align: center; }
.c1a-metric-value { display: block; color: #10243E; font-size: 22rpx; font-weight: 700; line-height: 32rpx; white-space: nowrap; }
.c1a-status-card { box-sizing: border-box; padding: 22rpx 24rpx; border: 1rpx solid #BAE6FD; border-radius: 26rpx; background: #F0F9FF; }
.c1a-status-card--joined { border-color: #A7F3D0; background: #ECFDF5; }
.c1a-status-card--rejected { border-color: #DBE5EC; background: #F1F5F9; }
.c1a-status-heading { display: flex; align-items: center; gap: 16rpx; font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.c1a-status-dot { flex: 0 0 auto; width: 16rpx; height: 16rpx; border-radius: 50%; background: #0284C7; }
.c1a-status-card--joined .c1a-status-dot { background: #047857; }
.c1a-status-card--rejected .c1a-status-dot { background: #64748B; }
.c1a-status-description { display: block; margin: 6rpx 0 0 32rpx; color: #526479; font-size: 22rpx; line-height: 34rpx; }
.c1a-status-card--joined .c1a-status-description { color: #047857; }
.c1a-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx 24rpx; }
.c1a-detail-grid view { display: flex; min-width: 0; flex-direction: column; }
.c1a-detail-label { color: #526479; font-size: 20rpx; line-height: 30rpx; }
.c1a-detail-value { margin-top: 4rpx; font-size: 24rpx; font-weight: 700; line-height: 36rpx; }
.c1a-detail-wide { grid-column: 1 / -1; }
.c1a-settlement { display: block; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #DBE5EC; color: #526479; font-size: 22rpx; line-height: 34rpx; }
button { box-sizing: border-box; }
.c1a-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 20rpx; font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.c1a-button--primary { border: 1rpx solid #0284C7; background: #0284C7; color: #FFFFFF; }
.c1a-button--secondary { border: 1rpx solid #7DD3FC; background: #F0F9FF; color: #0369A1; }
.c1a-icon-button { min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; color: #10243E; }
.c1a-back-glyph { box-sizing: border-box; width: 22rpx; height: 22rpx; border-bottom: 4rpx solid currentColor; border-left: 4rpx solid currentColor; transform: rotate(45deg); }
.c1a-footer { position: fixed; z-index: 8; right: 0; bottom: 0; left: 0; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom, 0px)); border-top: 1rpx solid #DBE5EC; background: rgba(255, 255, 255, .96); }
.c1a-footer-note { display: block; margin-bottom: 14rpx; color: #526479; font-size: 20rpx; line-height: 30rpx; text-align: center; }
