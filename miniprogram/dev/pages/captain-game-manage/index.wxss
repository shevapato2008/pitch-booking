.captain-game-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 28rpx; }.captain-game-system { flex: 0 0 auto; background: #FFFFFF; }.captain-game-nav { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; flex: 0 0 auto; box-sizing: border-box; background: #FFFFFF; font-size: 34rpx; font-weight: 700; }.captain-game-nav-back { display: flex; align-items: center; justify-content: center; width: 88rpx; min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #0369A1; font-size: 48rpx; }.captain-game-nav-title { overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; }.captain-game-nav-subtitle { text-align: center; color: #526479; font-size: 22rpx; font-weight: 400; }.captain-game-fixture, .captain-game-notice { color: #526479; font-size: 22rpx; }.captain-game-scroll { box-sizing: border-box; flex: 1 1 auto; height: auto; padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom, 0px)); }.captain-game-notice { padding: 0 8rpx 12rpx; }.captain-game-card, .captain-game-actions { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #DBE5EC; border-radius: 16rpx; background: #FFFFFF; }.captain-game-heading { font-size: 30rpx; font-weight: 700; }.captain-game-card-title { color: #0369A1; font-size: 24rpx; }.captain-game-inline-error { margin: 12rpx 0; color: #B91C1C; }.captain-game-hidden-copy { display: none; }button { box-sizing: border-box; }.captain-game-primary, .captain-game-secondary, .captain-game-danger { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 14rpx; font-size: 30rpx; }.captain-game-primary { background: #0284C7; color: #FFFFFF; }.captain-game-secondary { border: 1rpx solid #0284C7; background: #FFFFFF; color: #0369A1; }.captain-game-danger { border: 1rpx solid #B91C1C; background: #FFFFFF; color: #B91C1C; }.captain-game-scrim { position: fixed; z-index: 4; inset: 0; display: flex; align-items: flex-end; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom, 0px)); background: rgba(16, 36, 62, .48); }.captain-game-sheet { display: flex; flex-direction: column; gap: 16rpx; width: 100%; padding: 28rpx; border-radius: 20rpx; background: #FFFFFF; }
