@import "../../styles/tokens.wxss";

.pitch-group + .pitch-group { margin-top: 40rpx; }
.pitch-heading { margin-bottom: 16rpx; line-height: 1.4; font-weight: 700; }
.slot-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.slot {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  margin: 0;
  padding: 20rpx;
  color: #F3F8FF;
  line-height: 1.3;
  text-align: left;
  background: #152539;
  border: 2rpx solid #314157;
}
.slot::after { border: 0; }
.slot-time { display: block; font-weight: 700; }
.slot-meta { display: flex; justify-content: space-between; gap: 8rpx; margin-top: 10rpx; }
.slot-price,
.slot-status { white-space: nowrap; }
.slot-status { font-weight: 600; }
.slot--disabled { opacity: 1; }
.slot--available,
.slot.slot--available.slot--disabled { color: #A6EDB9; background: #17392F; border-color: #3C6555; }
.slot--expired,
.slot--booked,
.slot--closed,
.slot.slot--expired.slot--disabled,
.slot.slot--booked.slot--disabled,
.slot.slot--closed.slot--disabled { color: #8B9DB3; background: #0B1727; }
.slot--temporarily-locked,
.slot.slot--temporarily-locked.slot--disabled { color: #FFD094; background: #392E23; border-color: #6B5335; }
.slot--selected,
.slot.slot--selected.slot--disabled { color: #173421; background: #CEFF80; border-color: #CEFF80; }
.slot--pressed { opacity: 0.76; transform: scale(0.99); }
