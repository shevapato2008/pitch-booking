<view wx:if="{{card}}" class="card {{card.selected?'card--selected':''}}" bindtap="onSelect"><view class="tag tag--{{card.action}}">{{card.statusText}}</view><view class="name">{{card.name}}</view><view class="address">{{card.address}}</view><view class="transit">{{card.distanceText || card.transitText}}</view><button wx:if="{{card.selected}}" class="action" catchtap="onAction">{{card.action === 'VIEW_AVAILABILITY' ? '查看可订时段' : '查看场馆详情'}}</button></view>
