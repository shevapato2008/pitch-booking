.card{width:590rpx;padding:24rpx;border:2rpx solid #dbe5ec;border-radius:28rpx;background:#fff;box-sizing:border-box}.card--selected{border-color:#0284c7;box-shadow:0 8rpx 24rpx #0284c722}.tag{font-size:22rpx;font-weight:700;color:#475569}.tag--VIEW_AVAILABILITY{color:#0369a1}.name{margin-top:12rpx;font-size:36rpx;font-weight:700;color:#10243e}.address,.transit{margin-top:10rpx;color:#64748b;font-size:26rpx}.action{min-height:88rpx;margin-top:20rpx;color:#fff;background:#0284c7;border:0;font-weight:700}.action::after{border:0}
