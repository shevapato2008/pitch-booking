.venue-row{display:grid;grid-template-columns:minmax(0,1fr) 88rpx;align-items:center;gap:16rpx;width:100%;height:232rpx;padding:20rpx 20rpx 20rpx 28rpx;border:2rpx solid #dbe5ec;border-radius:32rpx;background:#fff;box-sizing:border-box;overflow:hidden}.venue-row--selected{border-color:transparent;background:#f0f9ff;box-shadow:inset 0 0 0 4rpx #0284c7}.venue-row-body{display:flex;flex-direction:column;justify-content:center;width:100%;height:100%;min-width:0;margin:0;padding:0;border:0;background:transparent;text-align:left}.venue-row-body::after,.venue-row-action::after{border:0}.venue-row-name{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#10243e;font-size:32rpx;font-weight:700;line-height:44rpx}.venue-row-address{display:block;margin-top:4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#526479;font-size:24rpx;line-height:34rpx}.venue-row-meta{display:flex;align-items:center;min-width:0;margin-top:4rpx;overflow:hidden;color:#526479;font-size:22rpx;line-height:32rpx}.venue-row-summary{display:block;min-width:0;flex-shrink:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.venue-row-separator{flex-shrink:0;margin:0 8rpx;white-space:nowrap}.venue-row-status{white-space:nowrap;flex-shrink:0;color:#475569;font-weight:700}.venue-row-status--VIEW_AVAILABILITY{color:#0369a1}.venue-row-action{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;min-width:88rpx;min-height:88rpx;margin:0;padding:0;border:2rpx solid #d8e2ea;border-radius:28rpx;background:#f8fafc;color:#10243e}.venue-row-chevron{font-size:48rpx;line-height:1}
