<view class="sheet sheet--{{snap}}"><button class="handle" bindtap="onToggle" aria-label="切换场馆卡片高度"></button><view class="sheet-head"><text class="title">天津球场</text><text class="count">{{cards.length}} 个已核验地点</text></view><scroll-view class="cards" scroll-x scroll-with-animation scroll-into-view="venue-{{selectedVenueId}}"><view class="track"><view wx:for="{{cards}}" wx:key="venueId" id="venue-{{item.venueId}}" class="card-slot"><venue-map-card card="{{item}}" bindselect="onSelect" bindaction="onAction" /></view></view></scroll-view></view>
