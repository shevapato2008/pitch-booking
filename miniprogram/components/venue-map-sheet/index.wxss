.sheet{position:absolute;z-index:3;right:0;bottom:0;left:0;height:52%;padding:0 24rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:48rpx 48rpx 0 0;background:#152539;box-shadow:0 -16rpx 56rpx #020A1422;transition:height .2s ease;box-sizing:border-box}.sheet--collapsed{height:24%}.sheet--half{height:52%}.sheet--expanded{height:78%}.handle{display:block;width:96rpx;height:56rpx;min-height:56rpx;margin:0 auto;padding:0;border:0;background:linear-gradient(transparent 22rpx,#273A51 22rpx 30rpx,transparent 30rpx)}.handle::after,.sheet-toggle::after{border:0}.sheet-head{display:flex;align-items:center;justify-content:space-between;min-height:72rpx;padding:0 4rpx}.title{display:block;font-size:38rpx;font-weight:700;color:#F3F8FF}.subtitle{display:block;margin-top:2rpx;color:#B1BFD0;font-size:22rpx}.sheet-toggle{display:flex;align-items:center;justify-content:center;line-height:1.4;min-width:136rpx;height:64rpx;margin:0;padding:0;border:0;background:transparent;color:#CEFF80;font-size:24rpx;font-weight:700}.filters{display:flex;gap:12rpx;height:88rpx;align-items:center;overflow:hidden}.filter{display:flex;align-items:center;justify-content:center;height:64rpx;min-height:64rpx;margin:0;padding:0 24rpx;border:2rpx solid #314157;border-radius:24rpx;background:#152539;color:#F3F8FF;font-size:24rpx;line-height:1;white-space:nowrap}.filter::after{border:0}.filter--active{border-color:#425E68;background:#122C3B;color:#CEFF80}.cards{width:100%;height:calc(100% - 216rpx);overflow:hidden}.card-slot{margin-bottom:16rpx}

@import "../../styles/controls.wxss";

.filters { height: 100rpx; }
.cards { height: calc(100% - 228rpx); }
