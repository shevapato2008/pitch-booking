.sheet{position:absolute;z-index:3;right:0;bottom:0;left:0;height:52vh;padding:0 24rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:48rpx 48rpx 0 0;background:#fff;box-shadow:0 -16rpx 56rpx #10243e22;transition:height .2s ease;box-sizing:border-box}.sheet--collapsed{height:24vh}.sheet--half{height:52vh}.sheet--expanded{height:78vh}.handle{display:block;width:96rpx;height:56rpx;min-height:56rpx;margin:0 auto;padding:0;border:0;background:linear-gradient(transparent 22rpx,#b9c7d3 22rpx 30rpx,transparent 30rpx)}.handle::after,.sheet-toggle::after{border:0}.sheet-head{display:flex;align-items:center;justify-content:space-between;min-height:72rpx;padding:0 4rpx}.title{display:block;font-size:38rpx;font-weight:700;color:#10243e}.subtitle{display:block;margin-top:2rpx;color:#526479;font-size:22rpx}.sheet-toggle{min-width:136rpx;height:64rpx;margin:0;padding:0;border:0;background:transparent;color:#0369a1;font-size:24rpx;font-weight:700}.filters{display:flex;gap:12rpx;height:88rpx;align-items:center;overflow:hidden}.filter{display:flex;align-items:center;height:64rpx;min-height:64rpx;margin:0;padding:0 24rpx;border:2rpx solid #d8e2ea;border-radius:24rpx;background:#fff;color:#334155;font-size:24rpx;line-height:1;white-space:nowrap}.filter::after{border:0}.filter--active{border-color:#8ed0ef;background:#f0f9ff;color:#075985}.cards{width:100%;height:calc(100% - 216rpx);overflow:hidden}.card-slot{margin-bottom:16rpx}
