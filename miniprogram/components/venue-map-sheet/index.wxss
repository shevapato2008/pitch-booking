.sheet{position:absolute;z-index:3;right:0;bottom:0;left:0;height:43vh;padding:12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:40rpx 40rpx 0 0;background:#fff;box-shadow:0 -12rpx 40rpx #10243e22;transition:height .2s ease;box-sizing:border-box}.sheet--collapsed{height:22vh}.sheet--expanded{height:68vh}.handle{display:block;width:88rpx;min-height:44rpx;margin:0 auto;padding:0;border:0;background:linear-gradient(transparent 18rpx,#cbd5e1 18rpx 26rpx,transparent 26rpx)}.handle::after{border:0}.sheet-head{display:flex;align-items:center;justify-content:space-between;padding:0 4rpx 16rpx}.title{font-size:40rpx;font-weight:700;color:#10243e}.count{font-size:26rpx;color:#64748b}.cards{width:100%;height:calc(100% - 104rpx)}.track{display:flex;gap:20rpx}.card-slot{flex:none}
