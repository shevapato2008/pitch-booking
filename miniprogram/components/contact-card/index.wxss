@import "../../styles/tokens.wxss";

.contact-card {
  box-sizing: border-box;
  padding: 28rpx;
  border-style: dashed;
  border-color: #425E68;
  background: #122C3B;
}

@import "../../styles/controls.wxss";
.section-title {
  margin-bottom: 20rpx;
  line-height: 1.4;
  font-weight: 700;
}
.phone-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 20rpx 24rpx;
  color: #173421;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 700;
  background: #CEFF80;
  border: 0;
}
.phone-button::after,
.text-button::after { border: 0; }
.phone-button--pressed,
.text-button--pressed { opacity: 0.76; }
.phone-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx;
}
.masked-phone { font-weight: 700; }
.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0;
  padding: 0 16rpx;
  color: #CEFF80;
  font-size: 26rpx;
  line-height: 1.4;
  background: transparent;
  border: 0;
}
.field-label {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
  font-weight: 600;
}
.contact-input {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx 22rpx;
  color: #F3F8FF;
  font-size: 26rpx;
  line-height: 1.4;
  background: #152539;
  border: 2rpx solid #314157;
}
.contact-input--without-label { margin-top: 16rpx; }
.contact-input--error { border-color: #FFB4AA; }
.field-error {
  display: block;
  margin-top: 8rpx;
  color: #FFB4AA;
  line-height: 1.5;
}
.privacy-note {
  display: block;
  margin-top: 16rpx;
  line-height: 1.55;
}
