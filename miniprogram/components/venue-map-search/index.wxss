.venue-search{position:relative;flex:1;width:100%;min-width:0}.venue-search-bar{display:flex;align-items:center;height:96rpx;border:2rpx solid #10243e14;border-radius:32rpx;background:#fff;box-shadow:0 12rpx 40rpx #10243e1f;box-sizing:border-box}.venue-search-icon{position:relative;flex:none;width:28rpx;height:28rpx;margin-left:28rpx;border:4rpx solid #10243e;border-radius:50%;box-sizing:border-box}.venue-search-icon::after{position:absolute;width:14rpx;height:4rpx;right:-11rpx;bottom:-6rpx;border-radius:4rpx;background:#10243e;transform:rotate(45deg);content:""}.venue-search-bar input{flex:1;min-width:0;height:100%;padding:0 16rpx;color:#10243e;font-size:28rpx}.venue-search-clear,.venue-search-cancel{flex:none;height:88rpx;margin:0;padding:0;border:0;background:transparent}.venue-search-clear{width:64rpx;color:#64748b;font-size:34rpx}.venue-search-cancel{width:76rpx;color:#0369a1;font-size:24rpx}.venue-search-clear::after,.venue-search-cancel::after,.venue-search-result::after{border:0}.venue-search-panel{margin-top:12rpx;padding:12rpx 0 20rpx;border:2rpx solid #d8e2ea;border-radius:28rpx;background:#fff;box-shadow:0 16rpx 48rpx #10243e24;overflow:hidden}.venue-search-heading{padding:12rpx 24rpx 6rpx;color:#64748b;font-size:22rpx;font-weight:700}.venue-search-heading--map{margin-top:8rpx;border-top:2rpx solid #edf2f6;padding-top:18rpx}.venue-search-result{display:flex;flex-direction:column;align-items:flex-start;width:100%;min-height:88rpx;margin:0;padding:12rpx 24rpx;border:0;background:#fff;text-align:left}.venue-search-name{width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#10243e;font-size:28rpx;font-weight:700}.venue-search-address{width:100%;margin-top:4rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#64748b;font-size:22rpx}.venue-search-message{padding:18rpx 24rpx;color:#64748b;font-size:24rpx}.venue-search-message--error{color:#9a3412}
