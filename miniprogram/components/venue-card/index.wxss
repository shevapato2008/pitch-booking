@import "../../styles/tokens.wxss";

.venue-card {
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(2, 10, 20, 0.08);
}

.hero,
.hero-image,
.hero-fallback {
  width: 100%;
  height: 400rpx;
}

.hero { position: relative; background: #314157; }
.hero-image { display: block; }

.hero-fallback {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #152C46 0%, #103B45 62%, #176255 100%);
}

.pitch-line {
  position: absolute;
  border: 4rpx solid rgba(179, 255, 210, 0.72);
}

.pitch-line--outer { inset: 48rpx 40rpx; border-radius: 16rpx; }
.pitch-line--half { top: 48rpx; bottom: 48rpx; left: 50%; width: 0; border-width: 0 0 0 4rpx; }
.pitch-line--circle { top: 50%; left: 50%; width: 112rpx; height: 112rpx; border-radius: 50%; transform: translate(-50%, -50%); }

.fallback-copy {
  position: absolute;
  z-index: 2;
  top: 24rpx;
  right: 32rpx;
  padding: 12rpx 20rpx;
  color: #F3F8FF;
  font-weight: 600;
  background: rgba(16, 36, 62, 0.68);
}

.hero-overlay {
  position: absolute;
  z-index: 1;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 64rpx 32rpx 32rpx;
  color: #F3F8FF;
  background: linear-gradient(180deg, rgba(16, 36, 62, 0) 0%, rgba(16, 36, 62, 0.88) 100%);
}

.hero-name { line-height: 1.25; font-weight: 700; text-shadow: 0 2rpx 8rpx rgba(2, 10, 20, 0.35); }
.hero-description { margin-top: 8rpx; line-height: 1.45; text-shadow: 0 2rpx 8rpx rgba(2, 10, 20, 0.35); }

.card-body { padding: 32rpx; }
.trust-row { display: flex; justify-content: flex-end; }

.trust-mark {
  padding: 8rpx 16rpx;
  font-weight: 600;
  background: #122C3B;
  border: 2rpx solid #425E68;
}

.chip-group { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.chip { padding: 10rpx 18rpx; color: #A4B5C8; background: #0B1727; border: 2rpx solid #314157; }
.chip--pitch { color: #CEFF80; background: #122C3B; border-color: #425E68; font-weight: 600; }
.venue-gallery { width: 100%; margin-top: 24rpx; white-space: nowrap; }
.venue-gallery__image { width: 184rpx; height: 120rpx; margin-right: 16rpx; border-radius: 16rpx; vertical-align: top; }

.price-panel { margin-top: 32rpx; padding: 24rpx; background: #17392F; border: 2rpx solid #3C6555; }
.directory-notice { margin-top: 32rpx; padding: 24rpx; background: #0B1727; border: 2rpx solid #314157; }
.directory-notice .price-kicker, .directory-notice .price-text { color: #C9D7E7; }
.price-kicker { color: #A6EDB9; font-weight: 700; }
.price-text { margin-top: 8rpx; color: #A6EDB9; line-height: 1.45; font-weight: 700; }

.information { margin-top: 32rpx; border-top: 2rpx solid #314157; }
.info-row { display: flex; gap: 16rpx; padding: 24rpx 0; border-bottom: 2rpx solid #314157; }
.info-badge { display: flex; align-items: center; justify-content: center; flex: none; width: 48rpx; height: 48rpx; color: #CEFF80; line-height: 1; text-align: center; font-weight: 700; background: #122C3B; }
.info-copy { flex: 1; min-width: 0; }
.info-label { line-height: 1.4; }
.info-value { margin-top: 8rpx; line-height: 1.5; word-break: break-all; }
.info-row--last { border-bottom: 0; }

.policy-note { margin-top: 8rpx; padding: 24rpx; background: #0B1727; }
.policy-title { font-weight: 700; }
.policy-text { margin-top: 8rpx; line-height: 1.55; }
