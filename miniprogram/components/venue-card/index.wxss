@import "../../styles/tokens.wxss";

.venue-card {
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(16, 36, 62, 0.08);
}

.hero,
.hero-image,
.hero-fallback {
  width: 100%;
  height: 400rpx;
}

.hero { position: relative; background: #DBE5EC; }
.hero-image { display: block; }

.hero-fallback {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #0284C7 0%, #0EA5E9 48%, #059669 100%);
}

.pitch-line {
  position: absolute;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
}

.pitch-line--outer { inset: 48rpx 40rpx; border-radius: 16rpx; }
.pitch-line--half { top: 48rpx; bottom: 48rpx; left: 50%; width: 0; border-width: 0 0 0 4rpx; }
.pitch-line--circle { top: 50%; left: 50%; width: 112rpx; height: 112rpx; border-radius: 50%; transform: translate(-50%, -50%); }

.fallback-copy {
  position: absolute;
  z-index: 2;
  top: 24rpx;
  right: 32rpx;
  padding: 12rpx 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  background: rgba(16, 36, 62, 0.68);
}

.hero-overlay {
  position: absolute;
  z-index: 1;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 64rpx 32rpx 32rpx;
  color: #FFFFFF;
  background: linear-gradient(180deg, rgba(16, 36, 62, 0) 0%, rgba(16, 36, 62, 0.88) 100%);
}

.hero-name { line-height: 1.25; font-weight: 700; text-shadow: 0 2rpx 8rpx rgba(16, 36, 62, 0.35); }
.hero-description { margin-top: 8rpx; line-height: 1.45; text-shadow: 0 2rpx 8rpx rgba(16, 36, 62, 0.35); }

.card-body { padding: 32rpx; }
.trust-row { display: flex; justify-content: flex-end; }

.trust-mark {
  padding: 8rpx 16rpx;
  font-weight: 600;
  background: #EAF7FD;
  border: 2rpx solid #B9E6F7;
}

.chip-group { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.chip { padding: 10rpx 18rpx; color: #64748B; background: #F8FAFC; border: 2rpx solid #DBE5EC; }
.chip--pitch { color: #0284C7; background: #F0F9FF; border-color: #BAE6FD; font-weight: 600; }

.price-panel { margin-top: 32rpx; padding: 24rpx; background: #EFFBF6; border: 2rpx solid #BFEBD8; }
.directory-notice { margin-top: 32rpx; padding: 24rpx; background: #F8FAFC; border: 2rpx solid #DBE5EC; }
.directory-notice .price-kicker, .directory-notice .price-text { color: #475569; }
.price-kicker { color: #059669; font-weight: 700; }
.price-text { margin-top: 8rpx; color: #065F46; line-height: 1.45; font-weight: 700; }

.information { margin-top: 32rpx; border-top: 2rpx solid #DBE5EC; }
.info-row { display: flex; gap: 16rpx; padding: 24rpx 0; border-bottom: 2rpx solid #DBE5EC; }
.info-badge { flex: none; width: 48rpx; height: 48rpx; color: #0284C7; line-height: 48rpx; text-align: center; font-weight: 700; background: #F0F9FF; }
.info-copy { flex: 1; min-width: 0; }
.info-label { line-height: 1.4; }
.info-value { margin-top: 8rpx; line-height: 1.5; word-break: break-all; }
.info-row--last { border-bottom: 0; }

.policy-note { margin-top: 8rpx; padding: 24rpx; background: #F8FAFC; }
.policy-title { font-weight: 700; }
.policy-text { margin-top: 8rpx; line-height: 1.55; }
