@import "../../styles/tokens.wxss";

.pitch-filter { display: flex; gap: 8rpx; padding: 8rpx; background: #273A51; }
.pitch-option {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 20rpx;
  color: #A4B5C8;
  line-height: 1.2;
  font-weight: 600;
  background: transparent;
  border: 0;
}
.pitch-option::after { border: 0; }
.pitch-option--selected { color: #CEFF80; background: #152539; box-shadow: 0 4rpx 12rpx rgba(2, 10, 20, 0.08); }
.pitch-option--pressed { opacity: 0.72; }
