<view class="pitch-filter u-radius-md" role="group" aria-label="场地类型">
  <button
    wx:for="{{options}}"
    wx:key="code"
    class="pitch-option u-control u-type-body u-radius-sm {{item.code === selectedPitchType ? 'pitch-option--selected' : ''}}"
    data-pitch-type="{{item.code}}"
    bindtap="onSelect"
    hover-class="pitch-option--pressed"
  >{{item.label}}</button>
</view>
