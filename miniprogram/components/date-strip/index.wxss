@import "../../styles/tokens.wxss";

.date-scroll { width: 100%; white-space: nowrap; }
.date-row { display: inline-flex; gap: 12rpx; padding: 4rpx 24rpx 12rpx; }
.date-item {
  box-sizing: border-box;
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 112rpx;
  margin: 0;
  padding: 8rpx;
  color: #F3F8FF;
  line-height: 1.3;
  background: #152539;
  border: 2rpx solid #314157;
}
.date-item::after { border: 0; }
.date-weekday,
.date-label { display: block; }
.date-label { margin-top: 4rpx; font-weight: 700; }
.date-item--selected { color: #173421; background: #CEFF80; border-color: #CEFF80; }
.date-item--pressed { opacity: 0.76; transform: scale(0.98); }

@import "../../styles/controls.wxss";
