page { background: #F8FAFC; color: #10243E; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { min-height: 100vh; background: #F8FAFC; color: #10243E; font-size: 28rpx; }
.owner-shell { display: flex; height: 100vh; flex-direction: column; overflow: hidden; }
.header__system { flex: 0 0 auto; background: #FFFFFF; }
.header { z-index: 10; display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; box-sizing: border-box; flex: 0 0 auto; min-height: 88rpx; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }
.header__back, .header__spacer { display: flex; align-items: center; justify-content: center; width: 88rpx; min-width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #10243E; }
.header__back-glyph { box-sizing: border-box; width: 22rpx; height: 22rpx; border-bottom: 4rpx solid currentColor; border-left: 4rpx solid currentColor; transform: rotate(45deg); }
.header__title { text-align: center; font-size: 34rpx; font-weight: 700; }
.content { box-sizing: border-box; min-height: 0; flex: 1 1 auto; height: 0; padding: 20rpx 24rpx calc(32rpx + env(safe-area-inset-bottom, 0px)); }
.card, .state-card { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #DBE5EC; border-radius: 16rpx; background: #FFFFFF; }
.hero__top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.hero__title { font-size: 38rpx; font-weight: 800; line-height: 52rpx; }
.heading { font-size: 32rpx; font-weight: 700; line-height: 44rpx; }
.eyebrow { color: #047857; font-size: 24rpx; font-weight: 700; }
.badge { padding: 8rpx 16rpx; border-radius: 999rpx; background: #ECFDF5; color: #047857; font-size: 24rpx; font-weight: 700; }
.badge--SUSPENDED { background: #FFF7ED; color: #9A3412; }
.badge--CANCELLED, .badge--COMPLETED { background: #F1F5F9; color: #526479; }
.reason { padding: 16rpx; border-radius: 12rpx; background: #FFF7ED; color: #9A3412; }
.rule, .readonly-note { color: #526479; line-height: 42rpx; }
.readonly-note { margin: 20rpx 0; text-align: center; }
.state-card--error { border-color: #FECACA; }
.inline-error { margin: 0 0 16rpx; color: #B91C1C; }
.primary, .secondary { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 14rpx 0 0; padding: 0 24rpx; border-radius: 14rpx; font-size: 30rpx; font-weight: 600; }
.primary { border: 0; background: #0284C7; color: #FFFFFF; }
.secondary { border: 1rpx solid #0284C7; background: #FFFFFF; color: #0369A1; }

.c1a-shell { display: flex; height: 100vh; flex-direction: column; overflow: hidden; background: #F8FAFC; color: #10243E; font-size: 24rpx; }
.c1a-system { flex: 0 0 auto; background: #FFFFFF; }
.c1a-nav { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; box-sizing: border-box; flex: 0 0 auto; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }
.c1a-nav-copy { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; }
.c1a-nav-title { overflow: hidden; font-size: 32rpx; font-weight: 700; line-height: 42rpx; text-overflow: ellipsis; white-space: nowrap; }
.c1a-nav-spacer { width: 88rpx; height: 88rpx; }
.c1a-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom, 0px)); }
.c1a-scroll--footer { padding-bottom: calc(200rpx + env(safe-area-inset-bottom, 0px)); }
.c1a-section { margin-bottom: 20rpx; }
.c1a-card { box-sizing: border-box; padding: 24rpx; border: 1rpx solid #DBE5EC; border-radius: 28rpx; background: #FFFFFF; }
.c1a-state-card { display: flex; flex-direction: column; gap: 20rpx; margin-top: 20rpx; }
.c1a-state-card--error { border-color: #FECACA; }
.c1a-heading { font-size: 30rpx; font-weight: 700; line-height: 42rpx; }
.c1a-help { color: #526479; font-size: 24rpx; line-height: 36rpx; }
.c1a-confirmed-row { display: flex; align-items: flex-start; gap: 20rpx; }
.c1a-confirmed-mark { position: relative; box-sizing: border-box; width: 36rpx; height: 36rpx; flex: 0 0 auto; margin-top: 2rpx; border: 4rpx solid #047857; border-radius: 50%; }
.c1a-confirmed-mark::after { position: absolute; top: 7rpx; left: 7rpx; width: 12rpx; height: 7rpx; border-bottom: 4rpx solid #047857; border-left: 4rpx solid #047857; content: ""; transform: rotate(-45deg); }
.c1a-confirmed-copy { display: flex; min-width: 0; flex-direction: column; }
.c1a-confirmed-title { font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.c1a-game-hero { display: flex; flex-direction: column; }
.c1a-eyebrow { margin-bottom: 6rpx; color: #047857; font-size: 22rpx; font-weight: 700; line-height: 32rpx; }
.c1a-game-title { font-size: 40rpx; font-weight: 700; line-height: 54rpx; letter-spacing: -1rpx; }
.c1a-game-subtitle { margin-top: 6rpx; color: #526479; font-size: 24rpx; line-height: 36rpx; }
.c1a-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }
.c1a-metric { display: flex; min-width: 0; min-height: 84rpx; flex-direction: column; align-items: center; justify-content: center; padding: 18rpx 8rpx; border-radius: 22rpx; background: #F6F9FB; color: #526479; font-size: 20rpx; line-height: 30rpx; text-align: center; }
.c1a-metric-value { display: flex; width: 100%; min-width: 0; min-height: 64rpx; align-items: center; justify-content: center; color: #10243E; font-size: 22rpx; font-weight: 700; line-height: 32rpx; text-align: center; white-space: nowrap; }
.c1a-metric--deadline .c1a-metric-value { white-space: normal; word-break: keep-all; }
.c1a-status-card { box-sizing: border-box; padding: 22rpx 24rpx; border: 1rpx solid #BAE6FD; border-radius: 26rpx; background: #F0F9FF; }
.c1a-status-card--waitlisted { border-color: #FED7AA; background: #FFF7ED; }
.c1a-status-card--blocked { border-color: #BAE6FD; background: #F0F9FF; }
.c1a-status-card--joined { border-color: #A7F3D0; background: #ECFDF5; }
.c1a-status-card--rejected { border-color: #DBE5EC; background: #F1F5F9; }
.c1a-status-card--withdrawn { border-color: #DBE5EC; background: #F1F5F9; }
.c1a-status-heading { display: flex; align-items: center; gap: 16rpx; font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.c1a-status-dot { width: 16rpx; height: 16rpx; flex: 0 0 auto; border-radius: 50%; background: #0284C7; }
.c1a-status-card--waitlisted .c1a-status-dot { background: #9A3412; }
.c1a-status-card--blocked .c1a-status-dot { background: #0369A1; }
.c1a-status-card--joined .c1a-status-dot { background: #047857; }
.c1a-status-card--rejected .c1a-status-dot { background: #64748B; }
.c1a-status-card--withdrawn .c1a-status-dot { background: #64748B; }
.c1a-status-description { display: block; margin: 6rpx 0 0 32rpx; color: #526479; font-size: 22rpx; line-height: 34rpx; }
.c1a-status-card--joined .c1a-status-description { color: #047857; }
.c1a-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx 24rpx; }
.c1a-detail-grid view { display: flex; min-width: 0; flex-direction: column; }
.c1a-detail-label { color: #526479; font-size: 20rpx; line-height: 30rpx; }
.c1a-detail-value { margin-top: 4rpx; font-size: 24rpx; font-weight: 700; line-height: 36rpx; }
.c1a-detail-wide { grid-column: 1 / -1; }
.c1a-settlement { display: block; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #DBE5EC; color: #526479; font-size: 22rpx; line-height: 34rpx; }
.c1a-navigation-error { display: block; margin: 16rpx 0; padding: 16rpx; border: 1rpx solid #FECACA; border-radius: 16rpx; background: #FEF2F2; color: #B91C1C; font-size: 22rpx; line-height: 34rpx; }
.c1a-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 20rpx; font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.c1a-button--primary { border: 1rpx solid #0369A1; background: #0369A1; color: #FFFFFF; }
.c1a-button--secondary { border: 1rpx solid #7DD3FC; background: #F0F9FF; color: #0369A1; }
.c1a-button--danger { border: 1rpx solid #F4C7C3; background: #FFF7F6; color: #B42318; }
.c1a-icon-button { display: flex; align-items: center; justify-content: center; min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #10243E; }
.c1a-back-glyph { box-sizing: border-box; width: 22rpx; height: 22rpx; border-bottom: 4rpx solid currentColor; border-left: 4rpx solid currentColor; transform: rotate(45deg); }
.c1a-footer { position: fixed; z-index: 8; right: 0; bottom: 0; left: 0; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom, 0px)); border-top: 1rpx solid #DBE5EC; background: rgba(255, 255, 255, .96); }
.c2a-scrim { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; box-sizing: border-box; padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom, 0px)); background: rgba(16, 36, 62, .48); }
.c2a-sheet { box-sizing: border-box; width: 100%; padding: 20rpx 28rpx 28rpx; border-radius: 36rpx; background: #FFFFFF; box-shadow: 0 28rpx 64rpx rgba(16, 36, 62, .22); }
.c2a-sheet-handle { width: 68rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 4rpx; background: #CBD5E1; }
.c2a-sheet-title, .c2a-sheet-copy { display: block; }
.c2a-sheet-title { font-size: 36rpx; font-weight: 700; line-height: 50rpx; }
.c2a-sheet-copy { margin-top: 12rpx; color: #526479; font-size: 24rpx; line-height: 38rpx; }
.c2a-late-warning { margin-top: 20rpx; padding: 20rpx 22rpx; border: 1rpx solid #F4C7C3; border-radius: 20rpx; background: #FFF7F6; color: #B42318; }
.c2a-late-warning text { display: block; font-size: 23rpx; line-height: 36rpx; }
.c2a-late-warning text:first-child { font-weight: 700; }
.c2a-sheet-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 28rpx; }
.c2a-neutral-action, .c2a-danger-action { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 0; padding: 0 20rpx; border-radius: 22rpx; font-size: 26rpx; font-weight: 700; line-height: 38rpx; }
.c2a-neutral-action { border: 1rpx solid #DBE5EC; background: #FFFFFF; color: #10243E; }
.c2a-danger-action { border: 1rpx solid #F4C7C3; background: #FFF7F6; color: #B42318; }
.c2a-neutral-action[disabled], .c2a-danger-action[disabled] { opacity: .54; }
.button-hover, .c1a-button:active, .primary:active, .secondary:active { opacity: .82; }
button::after { border: 0; }
