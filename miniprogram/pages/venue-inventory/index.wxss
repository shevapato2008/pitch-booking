page { background: #0B1727; color: #F3F8FF; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
button { box-sizing: border-box; margin: 0; padding: 0; background: transparent; color: inherit; font: inherit; line-height: normal; }
button::after { border: 0; }
.inventory-page { min-height: 100vh; background: #0B1727; }
.inventory-header { position: relative; z-index: 2; background: #152539; border-bottom: 1rpx solid #314157; }
.inventory-header__row { box-sizing: border-box; display: flex; align-items: center; min-height: 88rpx; padding-left: 10rpx; }
.back-button { display: flex; width: 88rpx; height: 88rpx; flex: none; align-items: center; justify-content: center; }
.inventory-header__identity { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; }
.inventory-header__title { max-width: 100%; overflow: hidden; font-size: 32rpx; font-weight: 750; line-height: 44rpx; text-overflow: ellipsis; white-space: nowrap; }
.inventory-header__subtitle { font-size: 22rpx; color: #A4B5C8; line-height: 32rpx; }
.icon-back { width: 22rpx; height: 22rpx; border-left: 4rpx solid #F3F8FF; border-bottom: 4rpx solid #F3F8FF; transform: rotate(45deg); }
.inventory-content { position: fixed; top: 176rpx; right: 0; bottom: calc(136rpx + env(safe-area-inset-bottom, 0px)); left: 0; display: flex; min-height: 0; flex-direction: column; padding: 28rpx 28rpx 0; }
.month-row, .inventory-summary, .sheet-heading, .calendar-pending { display: flex; align-items: center; justify-content: space-between; }
.month-title { font-size: 34rpx; font-weight: 750; }
.text-button { display: flex; min-width: 160rpx; min-height: 88rpx; align-items: center; justify-content: center; border: 2rpx solid #92DDC3; border-radius: 20rpx; color: #CEFF80; font-size: 26rpx; font-weight: 700; }
.text-button[disabled], .current-pitch[disabled] { border-color: #314157; background: #0B1727; color: #8B9DB3; }
.week-strip { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6rpx; margin-top: 16rpx; }
.week-day { display: flex; min-width: 0; min-height: 88rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 22rpx; color: #B1BFD0; font-size: 22rpx; }
button.week-day[disabled] { color: #8B9DB3; background: #0B1727; }
.week-day[disabled] .week-day__number { color: inherit; }
.week-day__number { margin-top: 6rpx; font-size: 28rpx; font-weight: 750; color: #F3F8FF; }
.week-day--selected { background: #CEFF80; color: #173421; }
.week-day--selected .week-day__number { color: #173421; }
.current-pitch { display: flex; min-height: 96rpx; margin-top: 16rpx; padding: 0 18rpx 0 24rpx; align-items: center; justify-content: space-between; border: 2rpx solid #425E68; border-radius: 22rpx; background: #152539; text-align: left; }
.current-pitch__copy { display: flex; min-width: 0; flex-direction: column; }
.context-label { font-size: 22rpx; color: #8B9DB3; }
.current-pitch__value { overflow: hidden; margin-top: 4rpx; font-size: 28rpx; font-weight: 750; color: #CEFF80; text-overflow: ellipsis; white-space: nowrap; }
.inventory-summary { min-height: 72rpx; }
.inventory-summary__date { font-size: 28rpx; font-weight: 750; }
.inventory-summary__count { font-size: 23rpx; color: #8B9DB3; }
.status-callout { display: flex; min-height: 88rpx; padding: 0 18rpx; align-items: center; justify-content: space-between; border-left: 6rpx solid #CEFF80; border-radius: 16rpx; background: #152539; font-size: 23rpx; }
.status-callout--partial-error, .status-callout--permission-error { border-color: #FFB4AA; background: #39242D; color: #FFB4AA; }
.inline-retry { display: flex; min-width: 96rpx; min-height: 88rpx; align-items: center; justify-content: center; color: #CEFF80; font-weight: 700; }
.inventory-list { min-height: 0; flex: 1; }
.slot-card { display: flex; min-height: 112rpx; margin-bottom: 16rpx; padding: 18rpx 18rpx 18rpx 22rpx; align-items: center; gap: 14rpx; border: 1rpx solid #314157; border-radius: 22rpx; background: #152539; }
.slot-card--readonly { background: #102033; }
.slot-card__main { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.slot-card__title { font-size: 28rpx; font-weight: 750; }
.slot-card__detail { margin-top: 6rpx; font-size: 22rpx; color: #A4B5C8; }
.status-badge { display: flex; width: 104rpx; height: 56rpx; flex: none; align-items: center; justify-content: center; padding: 0; border-radius: 999rpx; font-size: 22rpx; font-weight: 750; }
.status-badge--AVAILABLE { background: #17392F; color: #A6EDB9; }
.status-badge--LOCKED { background: #392E23; color: #FFD094; }
.status-badge--CLOSED { background: #1C2C40; color: #A4B5C8; }
.status-badge--BOOKED { background: #292B46; color: #C4BFFF; }
.icon-chevron { width: 16rpx; height: 16rpx; flex: none; border-top: 3rpx solid #A4B5C8; border-right: 3rpx solid #A4B5C8; transform: rotate(45deg); }
.icon-chevron--disabled { visibility: hidden; }
.icon-chevron--placeholder { visibility: hidden; }
.empty-state, .initial-state { display: flex; align-items: center; justify-content: center; border: 1rpx solid #314157; border-radius: 22rpx; background: #152539; color: #A4B5C8; text-align: center; }
.empty-state { min-height: 180rpx; }
.initial-state { min-height: 320rpx; margin: 36rpx 28rpx; flex-direction: column; gap: 24rpx; }
.initial-state__title { color: #F3F8FF; font-size: 34rpx; font-weight: 800; }
.initial-state__copy { color: #A4B5C8; font-size: 25rpx; }
.initial-state__action { width: 360rpx; }
.loading-mark { width: 44rpx; height: 10rpx; border-radius: 999rpx; background: #92DDC3; }
.list-end { height: 24rpx; }
.inventory-footer { position: fixed; z-index: 4; right: 0; bottom: 0; left: 0; padding: 12rpx 28rpx calc(16rpx + env(safe-area-inset-bottom, 0px)); border-top: 1rpx solid #314157; background: rgba(21, 37, 57, .98); }
.primary-button, .secondary-button { display: flex; min-height: 88rpx; align-items: center; justify-content: center; border-radius: 20rpx; font-size: 28rpx; font-weight: 750; }
.primary-button { width: 100%; background: #CEFF80; color: #173421; }
.primary-button[disabled] { background: #273A51; color: #8B9DB3; }
.secondary-button { border: 2rpx solid #92DDC3; background: #152539; color: #CEFF80; }
.sheet-scrim { position: fixed; z-index: 10; inset: 0; background: rgba(3, 9, 19, .68); }
.bottom-sheet { position: fixed; z-index: 11; right: 0; bottom: 0; left: 0; max-height: 82vh; overflow-y: auto; padding: 14rpx 28rpx calc(20rpx + env(safe-area-inset-bottom, 0px)); border-radius: 32rpx 32rpx 0 0; background: #152539; }
.sheet-handle { display: block; width: 84rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: 999rpx; background: #314157; }
.sheet-title { display: block; font-size: 34rpx; font-weight: 800; }
.sheet-subtitle { display: block; margin-top: 4rpx; font-size: 22rpx; color: #A4B5C8; }
.close-button { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; }
.icon-close { position: relative; width: 28rpx; height: 28rpx; }
.icon-close::before, .icon-close::after { position: absolute; top: 13rpx; left: 2rpx; width: 24rpx; height: 3rpx; background: #B1BFD0; content: ""; transform: rotate(45deg); }
.icon-close::after { transform: rotate(-45deg); }
.pitch-group { margin-top: 22rpx; }
.pitch-group__title { display: block; margin-bottom: 10rpx; color: #B1BFD0; font-size: 22rpx; font-weight: 700; }
.pitch-option { display: flex; width: 100%; min-height: 88rpx; margin-bottom: 10rpx; padding: 0 20rpx; align-items: center; justify-content: space-between; border: 1rpx solid #314157; border-radius: 18rpx; background: #152539; font-size: 25rpx; }
.pitch-option--selected { border-color: #92DDC3; background: #122C3B; color: #CEFF80; }
.calendar-weekdays, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.calendar-weekdays { margin-top: 22rpx; color: #A4B5C8; font-size: 21rpx; text-align: center; }
.calendar-day { display: flex; min-height: 88rpx; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 24rpx; }
button.calendar-day[disabled] { color: #8B9DB3; background: #152539; }
.calendar-day--selected { background: #CEFF80; color: #173421; }
.calendar-pending { min-height: 72rpx; margin: 12rpx 0; color: #B1BFD0; font-size: 23rpx; }
.context-chips { display: flex; flex-wrap: wrap; gap: 8rpx; margin: 18rpx 0; }
.context-chips text { padding: 10rpx 14rpx; border-radius: 999rpx; background: #122C3B; color: #CEFF80; font-size: 22rpx; font-weight: 700; }
.editor-field, .status-selector { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #314157; font-size: 25rpx; }
.field-value { display: flex; min-width: 180rpx; min-height: 72rpx; align-items: center; justify-content: flex-end; gap: 20rpx; }
.price-input { display: flex; min-height: 72rpx; align-items: center; gap: 8rpx; }
.price-input input { width: 150rpx; text-align: right; }
.status-options { display: flex; gap: 10rpx; }
.status-option { display: flex; min-width: 112rpx; min-height: 88rpx; align-items: center; justify-content: center; border: 1rpx solid #314157; border-radius: 16rpx; }
.status-option--selected { border-color: #92DDC3; background: #122C3B; color: #CEFF80; }
.editor-error, .editor-warning { display: flex; margin-top: 18rpx; padding: 18rpx; flex-direction: column; gap: 6rpx; border-radius: 16rpx; background: #39242D; color: #FFB4AA; font-size: 22rpx; }
.editor-warning { background: #392E23; color: #FFD094; }
.sheet-actions { display: grid; grid-template-columns: 1fr 1.5fr; gap: 12rpx; margin-top: 20rpx; }
