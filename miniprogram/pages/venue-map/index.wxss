.map-page,.map{width:100%;height:100vh}.map-page{position:relative;background:#dce8e3;color:#10243e}.state{padding:96rpx 32rpx;text-align:center}.top{position:absolute;z-index:4;top:24rpx;right:24rpx;left:24rpx;display:flex;gap:16rpx}.search,.locate{height:96rpx;padding:0;border:2rpx solid #10243e14;background:#fff;box-shadow:0 12rpx 40rpx #10243e1f}.search{flex:1;border-radius:48rpx;text-align:left;padding:0 32rpx;color:#64748b;font-size:28rpx}.locate{flex:none;width:96rpx;border-radius:50%;color:#0369a1;font-size:36rpx}.search::after,.locate::after{border:0}.legend{position:absolute;z-index:4;top:140rpx;left:24rpx;padding:16rpx 20rpx;border:2rpx solid #dbe5ec;border-radius:24rpx;background:#fffffff0;font-size:24rpx}.dot{display:inline-block;width:20rpx;height:20rpx;margin-right:10rpx;border-radius:50%;background:#64748b}.dot--online{background:#0284c7}.dot--directory{margin-left:20rpx}.location-error{position:absolute;z-index:5;top:216rpx;right:24rpx;left:24rpx;padding:20rpx 24rpx;border-radius:20rpx;background:#fff7ed;color:#7c2d12;font-size:26rpx}.fallback-list{height:100vh;padding:24rpx;background:#f8fafc;box-sizing:border-box;overflow:auto}.fallback-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:20rpx;border:2rpx solid #fed7aa;border-radius:24rpx;background:#fff7ed}.fallback-title,.fallback-copy{display:block}.fallback-title{color:#9a3412;font-size:28rpx;font-weight:700}.fallback-copy{margin-top:8rpx;color:#7c2d12;font-size:22rpx;line-height:1.5}.fallback-head button{flex:none;min-height:80rpx;color:#0369a1;background:#fff;border:2rpx solid #0284c7}.fallback-card{display:flex;flex-direction:column;gap:8rpx;margin-top:20rpx;padding:24rpx;border:2rpx solid #dbe5ec;border-radius:24rpx;background:#fff}.fallback-tag{color:#0369a1;font-size:22rpx;font-weight:700}.fallback-name{font-size:30rpx;font-weight:700}.fallback-address,.fallback-transit{color:#64748b;font-size:24rpx}.fallback-card button{align-self:flex-start;min-height:72rpx;margin-top:8rpx;padding:0 24rpx;border:0;border-radius:20rpx;background:#0284c7;color:#fff;font-size:24rpx;font-weight:700}.fallback-card button::after{border:0}
.permission-sheet{position:absolute;z-index:6;right:0;bottom:0;left:0;height:752rpx;padding:16rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));border-radius:48rpx 48rpx 0 0;background:#fff;box-shadow:0 -16rpx 56rpx #10243e22;box-sizing:border-box}.permission-handle{width:80rpx;height:8rpx;margin:0 auto;border-radius:8rpx;background:#cbd5e1}.permission-icon{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;margin:52rpx 0 28rpx;border-radius:50%;background:#f1f5f9;color:#475569;font-size:52rpx}.permission-title{font-size:44rpx;font-weight:700}.permission-copy{margin:16rpx 0 28rpx;color:#64748b;font-size:30rpx;line-height:1.6}.permission-primary,.permission-secondary{width:100%;min-height:88rpx;border-radius:28rpx;font-weight:700}.permission-primary{border:0;background:#0284c7;color:#fff}.permission-secondary{margin-top:16rpx;border:2rpx solid #dbe5ec;background:#fff;color:#10243e}.permission-primary::after,.permission-secondary::after{border:0}
