.map-page,.map{width:100%;height:100vh}.map-page{position:relative;background:#dce8e3;color:#10243e}.state{padding:96rpx 32rpx;text-align:center}.top{position:absolute;z-index:4;top:24rpx;right:24rpx;left:24rpx;display:flex;gap:16rpx}.search,.locate{height:96rpx;border:2rpx solid #10243e14;background:#fff;box-shadow:0 12rpx 40rpx #10243e1f;box-sizing:border-box}.search{display:flex;align-items:center;flex:1;min-width:0;border-radius:48rpx;padding:0 4rpx 0 32rpx}.search input{flex:1;min-width:0;color:#10243e;font-size:28rpx}.search-clear{flex:none;min-width:88rpx;height:88rpx;margin:0;padding:0;border:0;background:transparent;color:#0369a1;font-size:24rpx}.locate{flex:none;width:96rpx;margin:0;padding:0;border-radius:50%;color:#0369a1;font-size:24rpx;font-weight:700}.search-clear::after,.locate::after{border:0}.legend{position:absolute;z-index:4;top:140rpx;left:24rpx;display:flex;align-items:center;gap:20rpx;padding:10rpx 16rpx;border:2rpx solid #dbe5ec;border-radius:24rpx;background:#fffffff0;color:#334155;font-size:22rpx}.legend view{display:flex;align-items:center;white-space:nowrap}.legend image{width:26rpx;height:34rpx;margin-right:8rpx}.location-error,.search-empty{position:absolute;z-index:5;top:214rpx;right:24rpx;left:24rpx;padding:20rpx 24rpx;border-radius:20rpx;background:#fff7ed;color:#7c2d12;font-size:26rpx}.search-empty{background:#fff;color:#475569;box-shadow:0 12rpx 40rpx #10243e1f}
.permission-sheet{position:absolute;z-index:6;right:0;bottom:0;left:0;height:752rpx;padding:16rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));border-radius:48rpx 48rpx 0 0;background:#fff;box-shadow:0 -16rpx 56rpx #10243e22;box-sizing:border-box}.permission-handle{width:80rpx;height:8rpx;margin:0 auto;border-radius:8rpx;background:#cbd5e1}.permission-icon{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;margin:52rpx 0 28rpx;border-radius:50%;background:#f1f5f9;color:#475569;font-size:52rpx}.permission-title{font-size:44rpx;font-weight:700}.permission-copy{margin:16rpx 0 28rpx;color:#64748b;font-size:30rpx;line-height:1.6}.permission-primary,.permission-secondary{width:100%;min-height:88rpx;border-radius:28rpx;font-weight:700}.permission-primary{border:0;background:#0284c7;color:#fff}.permission-secondary{margin-top:16rpx;border:2rpx solid #dbe5ec;background:#fff;color:#10243e}.permission-primary::after,.permission-secondary::after{border:0}
