.map-page,.map{width:100%;height:100vh}.map-page{position:relative;overflow:hidden;background:#dce9e3;color:#10243e}.state{padding:96rpx 32rpx;text-align:center}.map-tools{position:absolute;z-index:5;top:24rpx;right:24rpx;left:24rpx;display:grid;grid-template-columns:minmax(0,1fr) 96rpx;align-items:flex-start;gap:16rpx}.locate{position:relative;display:flex;align-items:center;justify-content:center;flex:none;width:96rpx;height:96rpx;min-width:96rpx;min-height:96rpx;margin:0;padding:0;border:2rpx solid #10243e14;border-radius:32rpx;background:#fff;box-shadow:0 12rpx 40rpx #10243e1f;box-sizing:border-box}.locate::after{border:0}.locate--active{background:#f0f9ff;box-shadow:inset 0 0 0 3rpx #0284c7,0 12rpx 40rpx #10243e1f}.locate--error{box-shadow:inset 0 0 0 3rpx #ea580c,0 12rpx 40rpx #10243e1f}.crosshair{position:relative;width:48rpx;height:48rpx;border:4rpx solid #0369a1;border-radius:50%;box-sizing:border-box}.crosshair::before,.crosshair::after{position:absolute;background:#0369a1;content:""}.crosshair::before{top:-12rpx;bottom:-12rpx;left:20rpx;width:4rpx}.crosshair::after{top:20rpx;right:-12rpx;left:-12rpx;height:4rpx}.crosshair-dot{position:absolute;z-index:1;top:16rpx;left:16rpx;width:8rpx;height:8rpx;border:2rpx solid #fff;border-radius:50%;background:#0369a1}.center-note{position:absolute;z-index:4;top:140rpx;left:24rpx;min-height:56rpx;padding:12rpx 20rpx;border:2rpx solid #10243e14;border-radius:20rpx;background:#fffffff0;box-shadow:0 6rpx 24rpx #10243e14;box-sizing:border-box;color:#3c5269;font-size:24rpx;font-weight:700}.location-error{position:absolute;z-index:5;top:212rpx;right:24rpx;left:24rpx;padding:20rpx 24rpx;border-radius:20rpx;background:#fff7ed;color:#7c2d12;font-size:26rpx}.permission-sheet{position:absolute;z-index:6;right:0;bottom:0;left:0;height:752rpx;padding:16rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));border-radius:48rpx 48rpx 0 0;background:#fff;box-shadow:0 -16rpx 56rpx #10243e22;box-sizing:border-box}.permission-handle{width:80rpx;height:8rpx;margin:0 auto;border-radius:8rpx;background:#cbd5e1}.permission-icon{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;margin:52rpx 0 28rpx;border-radius:50%;background:#f1f5f9}.permission-title{font-size:44rpx;font-weight:700}.permission-copy{margin:16rpx 0 28rpx;color:#64748b;font-size:30rpx;line-height:1.6}.permission-primary,.permission-secondary{width:100%;min-height:88rpx;border-radius:28rpx;font-weight:700}.permission-primary{border:0;background:#0284c7;color:#fff}.permission-secondary{margin-top:16rpx;border:2rpx solid #dbe5ec;background:#fff;color:#10243e}.permission-primary::after,.permission-secondary::after{border:0}
