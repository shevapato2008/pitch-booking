<view class="c1a-page">
  <view class="c1a-system" style="height: {{headerTopPx}}px;"></view>
  <view class="c1a-nav" style="height: {{headerRowHeightPx}}px;">
    <button class="c1a-icon-button" hover-class="button-hover" bindtap="onHeaderBack" aria-label="返回"><view class="c1a-back-glyph"></view></button>
    <view class="c1a-nav-copy"><text class="c1a-nav-title">申请加入</text></view>
    <view class="c1a-nav-spacer"></view>
  </view>

  <scroll-view scroll-y="true" class="c1a-scroll">
    <view wx:if="{{status === 'LOADING'}}" class="c1a-card c1a-state-card" role="status" aria-busy="true">
      <text class="c1a-heading">正在读取申请条件</text>
      <text class="c1a-help">请稍候，页面不会自动提交申请。</text>
    </view>

    <view wx:elif="{{status === 'LOAD_ERROR'}}" class="c1a-card c1a-state-card" role="alert">
      <text class="c1a-heading">申请表暂时没有加载出来</text>
      <text class="c1a-help">{{errorMessage}}</text>
      <button class="c1a-button c1a-button--secondary" hover-class="button-hover" bindtap="onReload">重新加载</button>
      <button class="c1a-button c1a-button--neutral" hover-class="button-hover" bindtap="onReturnGame">返回球局详情</button>
    </view>

    <view wx:elif="{{status === 'AUTH_LOSS'}}" class="c1a-card c1a-state-card" role="alert">
      <text class="c1a-heading">登录状态需要恢复</text>
      <text class="c1a-help">{{errorMessage}}</text>
      <button class="c1a-button c1a-button--primary" hover-class="button-hover" bindtap="onLogin">重新登录并继续</button>
      <button class="c1a-button c1a-button--neutral" hover-class="button-hover" bindtap="onReturnGame">返回球局详情</button>
    </view>

    <view wx:elif="{{status === 'NOT_FOUND'}}" class="c1a-card c1a-state-card" role="alert">
      <text class="c1a-heading">没有找到这场球局</text>
      <text class="c1a-help">{{errorMessage}}</text>
      <button class="c1a-button c1a-button--secondary" hover-class="button-hover" bindtap="onHeaderBack">返回</button>
    </view>

    <view wx:elif="{{status === 'AUTHORITY_CHANGED'}}" class="c1a-card c1a-state-card" role="status">
      <text class="c1a-heading">申请条件已变化</text>
      <text class="c1a-help">{{errorMessage}}</text>
      <button class="c1a-button c1a-button--secondary" hover-class="button-hover" bindtap="onReturnGame">返回球局详情</button>
    </view>

    <view wx:elif="{{status === 'CONFLICT'}}" class="c1a-card c1a-state-card" role="alert">
      <text class="c1a-heading">这次申请无法继续</text>
      <text class="c1a-help">{{errorMessage}}</text>
      <button class="c1a-button c1a-button--secondary" hover-class="button-hover" bindtap="onReturnGame">返回球局详情</button>
    </view>

    <view wx:elif="{{status === 'OTHER_PENDING'}}" class="c1a-card c1a-state-card" role="alert">
      <text class="c1a-heading">还有一项操作待确认</text>
      <text class="c1a-help">{{errorMessage}}</text>
      <button class="c1a-button c1a-button--primary" hover-class="button-hover" bindtap="onGoPending">前往确认</button>
      <button class="c1a-button c1a-button--neutral" hover-class="button-hover" bindtap="onReturnGame">返回球局详情</button>
    </view>

    <view wx:elif="{{status === 'FOREIGN_PENDING'}}" class="c1a-card c1a-state-card" role="alert">
      <text class="c1a-heading">另一账号有操作待确认</text>
      <text class="c1a-help">{{errorMessage}}</text>
      <button class="c1a-button c1a-button--secondary" hover-class="button-hover" bindtap="onClearPending">清除本机待确认记录</button>
      <button class="c1a-button c1a-button--neutral" hover-class="button-hover" bindtap="onReturnGame">返回球局详情</button>
    </view>

    <view wx:elif="{{status === 'SUBMITTING'}}" class="c1a-card c1a-state-card" role="status" aria-busy="true">
      <text class="c1a-heading">正在提交申请</text>
      <text class="c1a-help">已保存本次提交记录，请勿重复操作。</text>
    </view>

    <view wx:elif="{{status === 'SUBMITTED_NAV_ERROR'}}" class="c1a-card c1a-state-card" role="alert">
      <text class="c1a-heading">申请已提交</text>
      <text class="c1a-help">{{navigationError}}</text>
      <button class="c1a-button c1a-button--primary" hover-class="button-hover" bindtap="onReturnGame">再次返回球局详情</button>
    </view>

    <view wx:elif="{{status === 'RESULT_UNKNOWN'}}" class="c1a-card c1a-state-card" role="status">
      <text class="c1a-eyebrow">正在确认原提交</text>
      <text class="c1a-heading">申请结果暂时未知</text>
      <text>本场称呼：{{draft.displayName}}</text>
      <text class="c1a-help">{{errorMessage}}</text>
    </view>

    <block wx:elif="{{status === 'READY'}}">
      <text class="c1a-form-intro">信息仅用于本场审核，提交后不能重复申请。</text>

      <label class="c1a-field" for="c1a-display-name">
        <text class="c1a-label">本场称呼</text>
        <input id="c1a-display-name" class="c1a-input" value="{{draft.displayName}}" maxlength="24" bindinput="onDisplayNameInput" cursor-spacing="160" placeholder="例如：小范" />
        <text class="c1a-help">这是你在本场球局展示的称呼，不是微信昵称或实名</text>
        <text wx:if="{{validation.errors.displayName}}" class="c1a-error" role="alert">{{validation.errors.displayName}}</text>
      </label>

      <view class="c1a-field">
        <text class="c1a-label">意向位置</text>
        <view class="c1a-position-grid">
          <button wx:for="{{positions}}" wx:key="value" class="c1a-option {{item.selected ? 'c1a-option--selected' : ''}}" hover-class="button-hover" data-position="{{item.value}}" bindtap="onPositionTap">{{item.label}}</button>
        </view>
        <text wx:if="{{validation.errors.position}}" class="c1a-error" role="alert">{{validation.errors.position}}</text>
      </view>

      <label class="c1a-field" for="c1a-note">
        <view class="c1a-field-row"><text class="c1a-label">给队长的话</text><text class="c1a-count">{{noteLength}} / 120</text></view>
        <textarea id="c1a-note" class="c1a-textarea" value="{{draft.note}}" maxlength="120" bindinput="onNoteInput" cursor-spacing="160" placeholder="可选：简单说明经验或到场安排" />
        <text class="c1a-help">选填，最多 120 字；请勿填写联系方式</text>
        <text wx:if="{{validation.errors.note}}" class="c1a-error" role="alert">{{validation.errors.note}}</text>
      </label>

      <view class="c1a-consent-list">
        <checkbox-group bindchange="onAdultChange">
          <label class="c1a-consent" hover-class="c1a-consent--pressed">
            <checkbox class="c1a-consent-input" value="adult" checked="{{draft.adultConfirmed}}" />
            <view class="c1a-check-mark {{draft.adultConfirmed ? 'c1a-check-mark--checked' : ''}}"></view>
            <text>我已满 18 周岁</text>
          </label>
        </checkbox-group>
        <text wx:if="{{attempted && validation.errors.adultConfirmed}}" class="c1a-error" role="alert">{{validation.errors.adultConfirmed}}</text>
        <checkbox-group bindchange="onRiskChange">
          <label class="c1a-consent" hover-class="c1a-consent--pressed">
            <checkbox class="c1a-consent-input" value="risk" checked="{{draft.riskConfirmed}}" />
            <view class="c1a-check-mark {{draft.riskConfirmed ? 'c1a-check-mark--checked' : ''}}"></view>
            <text>我了解足球运动存在受伤风险，并自愿参与</text>
          </label>
        </checkbox-group>
        <text wx:if="{{attempted && validation.errors.riskConfirmed}}" class="c1a-error" role="alert">{{validation.errors.riskConfirmed}}</text>
      </view>

      <text wx:if="{{errorMessage}}" class="c1a-error c1a-page-error" role="alert">{{errorMessage}}</text>
    </block>
    <text wx:if="{{navigationError && status !== 'SUBMITTED_NAV_ERROR'}}" class="c1a-error c1a-navigation-error" role="alert">{{navigationError}}</text>
  </scroll-view>

  <view wx:if="{{status === 'READY'}}" class="c1a-footer">
    <button class="c1a-button c1a-button--neutral" hover-class="button-hover" bindtap="onCancel">取消</button>
    <button class="c1a-button c1a-button--primary" hover-class="button-hover" disabled="{{!canSubmit}}" bindtap="onSubmit">提交申请</button>
  </view>
  <view wx:elif="{{status === 'RESULT_UNKNOWN'}}" class="c1a-footer c1a-footer--stacked">
    <button class="c1a-button c1a-button--primary" hover-class="button-hover" bindtap="onConfirmResult">确认申请结果</button>
    <button class="c1a-button c1a-button--secondary" hover-class="button-hover" bindtap="onReturnGame">返回球局详情</button>
  </view>
</view>
