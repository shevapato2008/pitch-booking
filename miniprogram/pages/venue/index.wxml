<view class="venue-page">
  <view wx:if="{{loading}}" class="state-message">正在加载场馆信息…</view>
  <view wx:elif="{{errorText}}" class="state-message state-message--error">{{errorText}}</view>
  <block wx:else>
    <view class="content">
      <venue-card venue="{{venue}}" />
    </view>
    <view class="action-bar">
      <button class="primary-action" bindtap="onViewAvailability" hover-class="primary-action--pressed">
        查看可订时段
      </button>
    </view>
  </block>
</view>
