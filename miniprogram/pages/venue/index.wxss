.venue-page {
  min-height: 100vh;
}

@import "../../styles/controls.wxss";

.content {
  padding-top: 32rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.state-message {
  padding: 96rpx 32rpx;
  line-height: 1.5;
  text-align: center;
}

.state-message--error { color: #F3F8FF; }

.action-bar {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(21, 37, 57, 0.96);
  border-top: 2rpx solid #314157;
}
.action-bar--split { display: flex; gap: 16rpx; }
.action-bar--split button { flex: 1; }
.map-action { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 24rpx; line-height: 1.4; color: #CEFF80; background: #152539; border: 2rpx solid #CEFF80; font-weight: 700; }
.map-action::after { border: 0; }

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 32rpx;
  color: #173421;
  line-height: 1.2;
  font-weight: 700;
  background: #CEFF80;
  border: 0;
  box-shadow: 0 10rpx 24rpx rgba(206, 255, 128, 0.12);
}

.primary-action::after { border: 0; }

.primary-action--pressed {
  background: #CEFF80;
  transform: scale(0.99);
}

.venue-page { min-height: 0; }
