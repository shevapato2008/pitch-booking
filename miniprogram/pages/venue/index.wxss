.venue-page {
  min-height: 100vh;
}

.content {
  padding-top: 32rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.state-message {
  padding: 96rpx 32rpx;
  line-height: 1.5;
  text-align: center;
}

.state-message--error { color: #10243E; }

.action-bar {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid #DBE5EC;
}
.action-bar--split { display: flex; gap: 16rpx; }
.action-bar--split button { flex: 1; }
.map-action { margin: 0; color: #0369A1; background: #FFFFFF; border: 2rpx solid #0284C7; font-weight: 700; }
.map-action::after { border: 0; }

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 32rpx;
  color: #FFFFFF;
  line-height: 1.2;
  font-weight: 700;
  background: #0284C7;
  border: 0;
  box-shadow: 0 10rpx 24rpx rgba(2, 132, 199, 0.22);
}

.primary-action::after { border: 0; }

.primary-action--pressed {
  background: #036B9F;
  transform: scale(0.99);
}
