.c1b-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #0B1727; color: #F3F8FF; font-size: 28rpx; }
.c1b-mine-entry::after, .c1b-date-chip::after, .c1b-filter-chip::after, .c1b-game-card::after, .c1b-secondary-action::after { border: 0; }
.c1b-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; min-height: 0; }
.c1b-content { box-sizing: border-box; min-height: 100%; padding: 24rpx 24rpx calc(64rpx + env(safe-area-inset-bottom, 0px)); }
.c1b-context { display: block; color: #B1BFD0; font-size: 26rpx; line-height: 40rpx; }
.c1b-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 18rpx; }
.c1b-section-title { color: #F3F8FF; font-size: 34rpx; font-weight: 800; line-height: 48rpx; }
.c1b-mine-entry { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; flex: 0 0 auto; min-height: 88rpx; margin: 0; padding: 0 38rpx 0 18rpx; border: 0; border-radius: 20rpx; background: transparent; color: #CEFF80; font-size: 24rpx; font-weight: 700; line-height: 36rpx; text-align: center; }
.c1b-mine-entry > text { width: 100%; }
.c1b-mine-chevron { position: absolute; top: 50%; right: 12rpx; box-sizing: border-box; width: 12rpx; height: 12rpx; border-top: 3rpx solid #CEFF80; border-right: 3rpx solid #CEFF80; transform: translateY(-50%) rotate(45deg); }
.c1b-filters { margin: 6rpx 0 0; padding: 0 0 20rpx; border-bottom: 1rpx solid #273A51; background: #0B1727; }
.c1b-date-strip { width: 100%; white-space: nowrap; }
.c1b-date-strip__inner { display: inline-flex; gap: 16rpx; padding-bottom: 16rpx; }
.c1b-date-chip, .c1b-filter-chip, .c1b-secondary-action { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; margin: 0; border: 1rpx solid #314157; background: #152539; color: #B1BFD0; font-size: 26rpx; line-height: 38rpx; }
.c1b-date-chip { flex: 0 0 auto; min-width: 130rpx; padding: 0 24rpx; border-radius: 20rpx; }
.c1b-filter-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; }
.c1b-format-picker { display: block; min-width: 0; }
.c1b-filter-chip { width: 100%; padding: 0 20rpx; border-radius: 24rpx; }
.c1b-filter-active { border-color: #425E68; background: #122C3B; color: #CEFF80; font-weight: 700; }
.c1b-date-chip.c1b-filter-active { border-color: #CEFF80; background: #CEFF80; color: #173421; }
.c1b-control-disabled, .c1b-date-chip[disabled], .c1b-filter-chip[disabled] { opacity: .48; }
.c1b-down-icon { box-sizing: border-box; width: 14rpx; height: 14rpx; margin: -8rpx 0 0 16rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.c1b-toggle-dot { box-sizing: border-box; width: 32rpx; height: 32rpx; margin-right: 14rpx; border: 3rpx solid #8B9DB3; border-radius: 50%; background: #152539; }
.c1b-filter-active .c1b-toggle-dot { border: 10rpx solid #A6EDB9; }
.c1b-result-line { display: flex; align-items: center; justify-content: space-between; min-height: 78rpx; color: #A4B5C8; font-size: 24rpx; line-height: 36rpx; }
.c1b-result-count { color: #F3F8FF; font-weight: 700; }
.c1b-game-list { display: grid; gap: 20rpx; }
.c1b-game-card { position: relative; display: block; box-sizing: border-box; width: 100%; min-height: 444rpx; margin: 0; padding: 26rpx 28rpx; overflow: hidden; border: 1rpx solid #314157; border-radius: 28rpx; background: linear-gradient(130deg, #192D40, #152539 70%); color: #F3F8FF; text-align: left; transition: transform 140ms ease; }
.c1b-game-card--pressed, .c1b-pressed { opacity: .68; }
.c1b-card-status { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 10rpx; }
.c1b-confirmed { color: #A6EDB9; font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.c1b-confirmed::before { display: inline-block; width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: #A6EDB9; content: ""; vertical-align: 2rpx; }
.c1b-spots { display: inline-flex; align-items: center; justify-content: center; min-height: 48rpx; padding: 4rpx 16rpx; border-radius: 24rpx; background: #17392F; color: #A6EDB9; font-size: 22rpx; font-weight: 700; line-height: 32rpx; }
.c1b-spots--full { background: #1C2C40; color: #B1BFD0; }
.c1b-game-name { display: block; padding-right: 30rpx; font-size: 32rpx; font-weight: 700; line-height: 46rpx; }
.c1b-game-time { display: block; min-width: 0; font-size: 40rpx; font-weight: 800; line-height: 52rpx; letter-spacing: -1rpx; }
.c1b-date-line { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-top: 8rpx; color: #A4B5C8; font-size: 22rpx; line-height: 34rpx; }
.c1b-game-venue { display: block; margin-top: 4rpx; color: #B1BFD0; font-size: 24rpx; line-height: 36rpx; }
.c1b-game-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.c1b-game-tags text { padding: 4rpx 14rpx; border-radius: 20rpx; background: #1C2C40; color: #B1BFD0; font-size: 20rpx; line-height: 32rpx; }
.c1b-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 20rpx; padding: 18rpx 0; border-top: 1rpx solid #273A51; border-bottom: 1rpx solid #273A51; }
.c1b-metric-label { display: block; overflow: hidden; color: #A4B5C8; font-size: 18rpx; line-height: 28rpx; text-overflow: ellipsis; white-space: nowrap; }
.c1b-metric-value { display: flex; width: 100%; min-width: 0; min-height: 68rpx; align-items: center; justify-content: center; overflow: hidden; margin-top: 2rpx; color: #F3F8FF; font-size: 22rpx; font-weight: 700; line-height: 34rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.c1b-metric--deadline .c1b-metric-value { overflow: hidden; text-overflow: clip; white-space: normal; word-break: keep-all; }
.c1b-organizer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; color: #B1BFD0; font-size: 22rpx; line-height: 34rpx; }
.c1b-organizer text:first-child { overflow: hidden; color: #F3F8FF; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.c1b-card-chevron { position: absolute; top: 110rpx; right: 30rpx; box-sizing: border-box; width: 16rpx; height: 16rpx; border-top: 3rpx solid #CEFF80; border-right: 3rpx solid #CEFF80; transform: rotate(45deg); }
.c1b-state-card { margin-top: 26rpx; padding: 44rpx 32rpx; border: 1rpx solid #314157; border-radius: 28rpx; background: #152539; text-align: center; }
.c1b-state-card--error { border-color: #6A424B; background: #39242D; }
.c1b-state-title, .c1b-state-copy { display: block; }
.c1b-state-title { font-size: 36rpx; font-weight: 700; line-height: 52rpx; }
.c1b-state-card--error .c1b-state-title { color: #FFB4AA; }
.c1b-state-copy { margin-top: 12rpx; color: #B1BFD0; font-size: 26rpx; line-height: 40rpx; }
.c1b-secondary-action { width: 100%; margin-top: 30rpx; padding: 0 24rpx; border-color: #425E68; border-radius: 22rpx; background: #122C3B; color: #CEFF80; font-weight: 700; }
.c1b-skeleton { min-height: 444rpx; border: 1rpx solid #314157; border-radius: 28rpx; background: #152539; }
.c1b-skeleton::before { display: block; width: 70%; height: 28rpx; margin: 40rpx 28rpx 0; border-radius: 14rpx; background: #273A51; box-shadow: 0 62rpx 0 #273A51, 0 124rpx 0 #273A51, 0 202rpx 0 #273A51, 0 274rpx 0 #273A51; content: ""; }

@import "../../styles/controls.wxss";

button.c1b-mine-entry.ng-button { padding-right: 38rpx; }
