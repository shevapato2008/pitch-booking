@import "../../styles/tokens.wxss";

page { --page:#0B1727; --surface:#152539; --text:#F3F8FF; --muted:#A4B5C8; --border:#314157; --primary:#CEFF80; --primary-strong:#CEFF80; --primary-soft:#122C3B; --success:#A6EDB9; --warning:#FFD094; --danger:#FFB4AA; height:100%; background:var(--page); color:var(--text); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
view,text,button,textarea,scroll-view { box-sizing:border-box; }
button { min-width:0; margin:0; padding:0; border:0; border-radius:0; background:transparent; color:inherit; font:inherit; line-height:inherit; }
button::after { border:0; }
.fulfillment { display:flex; height:100vh; flex-direction:column; overflow:hidden; background:var(--page); }
.fulfillment__system,.fulfillment__header { flex:0 0 auto; background:var(--surface); }
.fulfillment__header { position:relative; display:flex; min-height:88rpx; align-items:center; justify-content:center; padding-left:24rpx; border-bottom:2rpx solid var(--border); }
.fulfillment__back { position:absolute; top:0; left:16rpx; }
.fulfillment__header-copy { min-width:0; max-width:520rpx; text-align:center; }
.fulfillment__venue { display:block; overflow:hidden; font-size:32rpx; font-weight:750; line-height:44rpx; text-overflow:ellipsis; white-space:nowrap; }
.fulfillment__context { display:block; color:var(--muted); font-size:22rpx; line-height:30rpx; }
.fulfillment__scroll { min-height:0; flex:1 1 auto; }
.fulfillment__content { padding:24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom,0px)); }
.icon-button { display:flex; width:88rpx; min-width:88rpx; height:88rpx; min-height:88rpx; align-items:center; justify-content:center; border-radius:24rpx; }
.icon { position:relative; display:block; width:40rpx; height:40rpx; color:currentColor; }
.icon--back::before { content:""; position:absolute; top:9rpx; left:12rpx; width:18rpx; height:18rpx; border-bottom:4rpx solid currentColor; border-left:4rpx solid currentColor; transform:rotate(45deg); }
.icon--close::before,.icon--close::after { content:""; position:absolute; top:18rpx; left:7rpx; width:28rpx; height:4rpx; border-radius:4rpx; background:currentColor; transform:rotate(45deg); }
.icon--close::after { transform:rotate(-45deg); }
.state-panel__mark,.refund-helper__mark { display:flex; width:36rpx; height:36rpx; flex:0 0 auto; align-items:center; justify-content:center; border:3rpx solid currentColor; border-radius:50%; font-size:22rpx; font-weight:800; line-height:1; }
.date-heading { display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:20rpx; }
.section-label,.date-heading__value { display:block; }
.section-label { color:var(--muted); font-size:22rpx; line-height:32rpx; }
.date-heading__value { font-size:36rpx; font-weight:750; line-height:50rpx; }
.date-heading__count { padding-bottom:6rpx; color:var(--muted); font-size:22rpx; line-height:32rpx; }
.inline-error,.load-more-error { display:flex; min-height:72rpx; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:20rpx; padding:16rpx 20rpx; border-left:8rpx solid var(--danger); border-radius:18rpx; background:#39242D; color:var(--danger); font-size:24rpx; line-height:36rpx; }
.inline-error__action { display:flex; min-width:88rpx; min-height:64rpx; flex:0 0 auto; align-items:center; justify-content:center; color:#CEFF80; font-weight:750; }
.order-list { display:grid; gap:20rpx; }
.order-card { position:relative; padding:24rpx; border:2rpx solid var(--border); border-radius:28rpx; background:var(--surface); }
.order-card__top { display:flex; align-items:center; justify-content:space-between; margin-bottom:10rpx; }
.status { padding:6rpx 16rpx; border-radius:999rpx; font-size:22rpx; font-weight:750; line-height:32rpx; }
.status--ready { background:var(--primary-soft); color:#CEFF80; }
.status--active { background:#17392F; color:var(--success); }
.status--complete,.status--muted { background:#1C2C40; color:#C9D7E7; }
.status--warning { background:#392E23; color:var(--warning); }
.status--refund { background:#39242D; color:var(--danger); }
.order-card__number { color:var(--muted); font-size:20rpx; line-height:32rpx; }
.order-card__time { display:block; font-size:32rpx; font-weight:750; line-height:44rpx; }
.order-card__pitch { display:block; color:var(--muted); font-size:24rpx; line-height:36rpx; }
.order-card__guest { display:flex; gap:16rpx; margin-top:8rpx; color:var(--muted); font-size:22rpx; line-height:32rpx; }
.order-card__blocked { display:block; margin-top:8rpx; color:var(--muted); font-size:22rpx; line-height:32rpx; }
.order-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:12rpx; margin-top:20rpx; }
.order-action { display:flex; min-width:176rpx; min-height:88rpx; align-items:center; justify-content:center; padding:12rpx 20rpx; border:2rpx solid #425E68; border-radius:24rpx; background:#122C3B; color:#CEFF80; font-size:24rpx; font-weight:750; text-align:center; }
.order-action--danger { border-color:#6A424B; background:#39242D; color:var(--danger); }
.order-action[disabled] { opacity:.46; }
.state-panel { display:flex; flex-direction:column; align-items:center; gap:12rpx; padding:72rpx 32rpx; border:2rpx solid var(--border); border-radius:28rpx; background:var(--surface); text-align:center; }
.state-panel--error { color:var(--danger); }
.state-panel__mark { width:72rpx; height:72rpx; margin-bottom:8rpx; }
.state-panel__title { font-size:30rpx; font-weight:750; line-height:44rpx; }
.state-panel__copy { margin-bottom:12rpx; color:var(--muted); font-size:24rpx; line-height:36rpx; }
.load-more { margin-top:4rpx; }
.load-more-error { margin:4rpx 0 0; }
.sheet-scrim { position:fixed; z-index:10; inset:0; background:rgba(3, 9, 19, .68); }
.refund-sheet { position:fixed; z-index:11; right:0; bottom:0; left:0; padding:12rpx 32rpx calc(28rpx + env(safe-area-inset-bottom,0px)); border-radius:48rpx 48rpx 0 0; background:var(--surface); box-shadow:0 -16rpx 56rpx rgba(2, 10, 20,.18); }
.sheet-handle { width:80rpx; height:8rpx; margin:4rpx auto 24rpx; border-radius:8rpx; background:var(--border); }
.refund-sheet__head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:24rpx; }
.refund-sheet__order,.refund-sheet__title { display:block; }
.refund-sheet__order { color:var(--muted); font-size:22rpx; line-height:32rpx; }
.refund-sheet__title { font-size:36rpx; font-weight:750; line-height:50rpx; }
.reason-label { display:block; margin-bottom:12rpx; font-size:26rpx; font-weight:750; line-height:38rpx; }
.reason-input { display:block; width:100%; height:148rpx; min-height:148rpx; padding:20rpx 24rpx; border:2rpx solid var(--border); border-radius:24rpx; background:var(--page); color:var(--text); font-size:26rpx; line-height:40rpx; }
.refund-error { display:block; margin-top:12rpx; color:var(--danger); font-size:24rpx; line-height:36rpx; }
.refund-helper { display:flex; align-items:flex-start; gap:12rpx; margin:18rpx 0 24rpx; color:var(--muted); font-size:22rpx; line-height:32rpx; }
.refund-helper__mark { width:32rpx; height:32rpx; color:var(--primary-strong); font-size:18rpx; }
.refund-sheet__actions { display:grid; grid-template-columns:224rpx minmax(0,1fr); gap:20rpx; }
.secondary-button,.danger-button { display:flex; min-height:96rpx; align-items:center; justify-content:center; padding:16rpx 24rpx; border-radius:28rpx; font-size:28rpx; font-weight:750; text-align:center; }
.secondary-button { border:2rpx solid #425E68; background:var(--surface); color:var(--primary-strong); }
.danger-button { border:2rpx solid #6A424B; background:#39242D; color:var(--danger); }
.secondary-button[disabled],.danger-button[disabled] { opacity:.46; }

@import "../../styles/controls.wxss";
