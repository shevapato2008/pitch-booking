<view class="fulfillment">
  <view class="fulfillment__system" style="height: {{headerTopPx}}px"></view>
  <view class="fulfillment__header" style="height: {{headerRowHeightPx}}px; padding-right: {{headerRightInsetPx}}px">
    <button class="icon-button fulfillment__back" aria-label="返回" bindtap="onBack"><view class="icon icon--back"></view></button>
    <view class="fulfillment__header-copy"><text class="fulfillment__venue">{{venueName || '今日订单'}}</text><text class="fulfillment__context">今日订单 · 仅授权工作人员</text></view>
  </view>

  <scroll-view class="fulfillment__scroll" scroll-y="true" enhanced="true" show-scrollbar="false" refresher-enabled="true" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullDownRefresh">
    <view class="fulfillment__content">
      <view class="date-heading"><view><text class="section-label">服务日期</text><text class="date-heading__value">{{selectedDateLabel || '正在读取'}}</text></view><text class="date-heading__count">{{orders.length}} 个订单</text></view>
      <view class="date-tabs" role="group" aria-label="切换服务日期">
        <button wx:for="{{dates}}" wx:key="serviceDate" class="date-tab {{item.selected ? 'date-tab--selected' : ''}}" data-service-date="{{item.serviceDate}}" disabled="{{item.selected}}" bindtap="onSelectDate"><text>{{item.weekday}}</text><text class="date-tab__day">{{item.day}}</text></button>
      </view>

      <text wx:if="{{refreshErrorText}}" class="inline-error" role="alert">{{refreshErrorText}}</text>
      <view wx:if="{{actionError}}" class="inline-error inline-error--action" role="alert"><text>{{actionError}}</text><button wx:if="{{unknownAttempt}}" class="inline-error__action" disabled="{{recoveryBusy}}" bindtap="onRetryUnknown">{{recoveryBusy ? '核对中' : '重新核对'}}</button></view>

      <view wx:if="{{mode === 'loading'}}" class="state-panel"><view class="state-panel__mark">i</view><text class="state-panel__title">正在读取订单</text><text class="state-panel__copy">请稍候</text></view>
      <view wx:elif="{{mode === 'read-error'}}" class="state-panel state-panel--error" role="alert"><view class="state-panel__mark">!</view><text class="state-panel__title">订单读取失败，请重试</text><text class="state-panel__copy">当前列表未更新，请重新读取权威订单状态。</text><button class="secondary-button" bindtap="onRetry">重新读取</button></view>
      <view wx:elif="{{mode === 'empty'}}" class="state-panel"><view class="state-panel__mark">i</view><text class="state-panel__title">当天没有待处理订单</text><text class="state-panel__copy">可切换其他日期继续查看。</text></view>
      <view wx:else class="order-list">
        <view wx:for="{{orders}}" wx:key="orderId" class="order-card">
          <view class="order-card__top"><text class="status status--{{item.statusTone}}">{{item.statusLabel}}</text><text class="order-card__number">{{item.number}}</text></view>
          <text class="order-card__time">{{item.time}}</text><text class="order-card__pitch">{{item.pitch}}</text>
          <view class="order-card__guest"><text>联系电话</text><text>{{item.phone}}</text></view>
          <text wx:if="{{item.blockedReason}}" class="order-card__blocked">{{item.blockedReason}}</text>
          <view wx:if="{{item.canCheckIn || item.canComplete || item.canRefund}}" class="order-actions">
            <button wx:if="{{item.canCheckIn}}" class="order-action" data-order-id="{{item.orderId}}" disabled="{{mutatingOrderId || unknownAttempt}}" bindtap="onCheckIn">{{mutatingOrderId === item.orderId ? '处理中' : '确认签到'}}</button>
            <button wx:if="{{item.canComplete}}" class="order-action" data-order-id="{{item.orderId}}" disabled="{{mutatingOrderId || unknownAttempt}}" bindtap="onComplete">{{mutatingOrderId === item.orderId ? '处理中' : '完成服务'}}</button>
            <button wx:if="{{item.canRefund}}" class="order-action order-action--danger" data-order-id="{{item.orderId}}" disabled="{{mutatingOrderId || unknownAttempt}}" bindtap="onOpenRefund">取消并退款</button>
          </view>
        </view>
        <button wx:if="{{nextCursor && !loadMoreError}}" class="secondary-button load-more" disabled="{{loadingMore}}" bindtap="onLoadMore">{{loadingMore ? '加载中' : '加载更多'}}</button>
        <view wx:if="{{loadMoreError}}" class="load-more-error"><text>更多订单加载失败</text><button class="inline-error__action" bindtap="onRetryLoadMore">重试</button></view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{sheetOpen}}" class="sheet-scrim"></view>
  <view wx:if="{{sheetOpen}}" class="refund-sheet" role="dialog" aria-label="确认取消并退款">
    <view class="sheet-handle"></view>
    <view class="refund-sheet__head"><view><text class="refund-sheet__order">订单 {{refundOrderNumber}}</text><text class="refund-sheet__title">确认取消并退款</text></view><button class="icon-button" aria-label="关闭退款确认" bindtap="onCancelRefund"><view class="icon icon--close"></view></button></view>
    <label class="reason-label" for="refund-reason">取消原因（必填）</label>
    <textarea id="refund-reason" class="reason-input" value="{{refundReason}}" maxlength="500" aria-label="取消原因（必填）" bindinput="onRefundReasonInput"></textarea>
    <text wx:if="{{refundError}}" class="refund-error" role="alert">{{refundError}}</text>
    <view class="refund-helper"><view class="refund-helper__mark">i</view><text>提交后将关闭本订单，并按原支付路径处理退款。</text></view>
    <view class="refund-sheet__actions"><button class="secondary-button" disabled="{{refundBusy}}" bindtap="onCancelRefund">取消</button><button class="danger-button" disabled="{{!refundReasonValid || refundBusy || unknownAttempt}}" bindtap="onConfirmRefund">{{refundBusy ? '提交中' : '确认退款'}}</button></view>
  </view>
</view>
