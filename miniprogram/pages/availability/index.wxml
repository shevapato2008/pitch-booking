<view class="availability-page u-page u-text">
  <view wx:if="{{loading}}" class="state-message u-muted u-type-body">正在加载可订时段…</view>
  <view wx:elif="{{errorText}}" class="state-message state-message--error u-type-body">{{errorText}}</view>
  <view wx:else class="availability-content {{onlineBookingEnabled && selectedSlotId ? 'availability-content--with-action' : ''}}">
    <view class="date-section">
      <date-strip
        dates="{{viewModel.dates}}"
        selectedDate="{{selectedDate}}"
        bind:select="onDateSelect"
      />
    </view>

    <view class="filter-section u-pad-page">
      <pitch-filter
        options="{{pitchOptions}}"
        selectedPitchType="{{selectedPitchType}}"
        bind:select="onPitchTypeSelect"
      />
    </view>

    <view wx:if="{{!onlineBookingEnabled}}" class="booking-unavailable u-surface u-border u-radius-md" role="status">
      <text class="booking-unavailable__title">在线预订暂未开放</text>
      <text class="booking-unavailable__copy">你仍可查看场地和时段信息。</text>
    </view>

    <view wx:if="{{viewModel.isEmpty}}" class="empty-state u-surface u-border u-radius-md u-muted u-type-body">
      当天暂无可订时段
    </view>
    <view wx:else class="slot-section u-pad-page">
      <slot-grid pitchGroups="{{viewModel.pitchGroups}}" disabled="{{!onlineBookingEnabled}}" bind:select="onSlotSelect" />
    </view>
    <text wx:if="{{navigationError}}" class="state-message state-message--error u-type-body">{{navigationError}}</text>
    <view wx:if="{{onlineBookingEnabled && selectedSlotId}}" class="availability-action-bar u-surface">
      <button
        class="availability-confirm u-control u-radius-md"
        bindtap="onConfirmSlot"
        hover-class="availability-confirm--pressed"
        aria-label="确认已选择的场次"
      >确认场次</button>
    </view>
  </view>
</view>
