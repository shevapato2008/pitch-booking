.c1a-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #0B1727; color: #F3F8FF; font-size: 24rpx; }
.c1a-system { flex: 0 0 auto; background: #152539; }
.c1a-nav { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; box-sizing: border-box; flex: 0 0 auto; border-bottom: 1rpx solid #314157; background: #152539; }
.c1a-nav-copy { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; }
.c1a-nav-title { overflow: hidden; font-size: 32rpx; font-weight: 700; line-height: 42rpx; text-overflow: ellipsis; white-space: nowrap; }
.c1a-nav-spacer { width: 88rpx; height: 88rpx; }
.c1a-scroll { box-sizing: border-box; flex: 1 1 auto; height: 0; padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom, 0px)); }
.c1a-card { display: flex; flex-direction: column; gap: 20rpx; box-sizing: border-box; padding: 24rpx; border: 1rpx solid #314157; border-radius: 28rpx; background: #152539; }
.c1a-state-card { margin-top: 20rpx; }
.c1a-eyebrow { color: #CEFF80; font-size: 22rpx; font-weight: 700; line-height: 32rpx; }
.c1a-heading { font-size: 30rpx; font-weight: 700; line-height: 42rpx; }
.c1a-help { color: #B1BFD0; font-size: 22rpx; line-height: 34rpx; }
.c1a-notice { display: block; margin-bottom: 20rpx; padding: 18rpx 20rpx; border: 1rpx solid #425E68; border-radius: 18rpx; background: #122C3B; color: #CEFF80; font-size: 22rpx; line-height: 34rpx; }
.c1a-review-context { display: block; margin-bottom: 20rpx; color: #B1BFD0; font-size: 24rpx; line-height: 36rpx; }
.c1a-applicant-card { box-sizing: border-box; padding: 28rpx; border: 1rpx solid #314157; border-radius: 28rpx; background: #152539; }
.c1a-applicant-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.c1a-applicant-name { min-width: 0; overflow: hidden; font-size: 36rpx; font-weight: 700; line-height: 50rpx; text-overflow: ellipsis; white-space: nowrap; }
.c1a-pending-pill { display: flex; min-height: 52rpx; flex: 0 0 auto; align-items: center; justify-content: center; padding: 4rpx 18rpx; border-radius: 999rpx; background: #122C3B; color: #CEFF80; font-size: 22rpx; font-weight: 700; line-height: 32rpx; }
.c1a-applicant-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #314157; color: #B1BFD0; font-size: 20rpx; line-height: 30rpx; }
.c1a-applicant-meta view { display: flex; min-width: 0; flex-direction: column; }
.c1a-meta-value { margin-top: 4rpx; color: #F3F8FF; font-size: 24rpx; font-weight: 700; line-height: 36rpx; }
.c1a-applicant-note { display: block; margin-top: 24rpx; padding: 22rpx; border-radius: 20rpx; background: #1C2C40; color: #B1BFD0; font-size: 24rpx; line-height: 36rpx; }
.c1a-privacy-note { display: block; margin-top: 20rpx; color: #A4B5C8; font-size: 22rpx; line-height: 34rpx; }
.c1a-blocker { display: block; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #314157; }
.c1a-full-note { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 20rpx; padding: 24rpx; border: 1rpx solid #6B5335; border-radius: 22rpx; background: #392E23; }
.c1a-full-dot { width: 18rpx; height: 18rpx; flex: 0 0 auto; margin-top: 8rpx; border-radius: 50%; background: #FFD094; }
.c1a-full-note > view:last-child { display: flex; min-width: 0; flex-direction: column; }
.c1a-full-note text:first-child { color: #FFD094; font-size: 25rpx; font-weight: 700; line-height: 36rpx; }
.c1a-full-note text:last-child { margin-top: 4rpx; color: #B1BFD0; font-size: 22rpx; line-height: 34rpx; }
.c1a-empty { align-items: center; padding-top: 48rpx; padding-bottom: 48rpx; text-align: center; }
.c1a-empty-mark { display: flex; align-items: flex-end; justify-content: center; width: 88rpx; height: 88rpx; gap: 8rpx; border-radius: 50%; background: #122C3B; }
.c1a-empty-mark view { width: 10rpx; margin-bottom: 28rpx; border-radius: 10rpx; background: #CEFF80; }
.c1a-empty-mark view:nth-child(1) { height: 18rpx; }
.c1a-empty-mark view:nth-child(2) { height: 30rpx; }
.c1a-empty-mark view:nth-child(3) { height: 24rpx; }
.c1a-error { color: #FFB4AA; font-size: 20rpx; line-height: 30rpx; }
.c1a-navigation-error { display: block; margin: 16rpx 0; padding: 16rpx; border: 1rpx solid #6A424B; border-radius: 16rpx; background: #39242D; }
button { box-sizing: border-box; }
button::after { border: 0; }
.c1a-button { min-height: 88rpx; display: flex; align-items: center; justify-content: center; width: 100%; margin: 0; padding: 0 20rpx; border-radius: 20rpx; font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.c1a-button--primary { border: 1rpx solid #CEFF80; background: #CEFF80; color: #173421; }
.c1a-button--primary[disabled] { border-color: #314157; background: #314157; color: #C9D7E7; }
.c1a-button--secondary { border: 1rpx solid #425E68; background: #122C3B; color: #CEFF80; }
.c1a-button--neutral { border: 1rpx solid #314157; background: #152539; color: #F3F8FF; }
.c1a-button--danger { border: 1rpx solid #6A424B; background: #39242D; color: #FFB4AA; }
.c1a-button--neutral[disabled] { background: #1C2C40; color: #8B9DB3; }
.c1a-button--primary:active, .c1a-button--primary.button-hover, .button-hover { opacity: .82; }
.c1a-button--secondary:active, .c1a-button--secondary.button-hover { opacity: .82; }
.c1a-button--neutral:active, .c1a-button--neutral.button-hover { opacity: .82; }
.c1a-button--danger:active, .c1a-button--danger.button-hover { opacity: .82; }
.c1a-icon-button { min-height: 88rpx; display: flex; align-items: center; justify-content: center; min-width: 88rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #F3F8FF; }
.c1a-back-glyph { box-sizing: border-box; width: 22rpx; height: 22rpx; border-bottom: 4rpx solid currentColor; border-left: 4rpx solid currentColor; transform: rotate(45deg); }
.c1a-footer { position: fixed; z-index: 8; right: 0; bottom: 0; left: 0; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom, 0px)); border-top: 1rpx solid #314157; background: rgba(21, 37, 57, .96); }
.c1a-footer-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.c1a-scrim { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; box-sizing: border-box; padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom, 0px)); background: rgba(3, 9, 19, .68); }
.c1a-sheet { box-sizing: border-box; width: 100%; padding: 32rpx; border-radius: 32rpx; background: #152539; box-shadow: 0 28rpx 64rpx rgba(2, 10, 20, .22); }
.c1a-sheet-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.c1a-sheet-title-row > view { display: flex; min-width: 0; flex-direction: column; }
.c1a-sheet-title { font-size: 34rpx; font-weight: 700; line-height: 48rpx; }
.c1a-sheet-copy { margin-top: 12rpx; color: #B1BFD0; font-size: 24rpx; line-height: 36rpx; }
.c1a-sheet-close { min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; margin: 0; padding: 0; border: 0; border-radius: 24rpx; background: #1C2C40; color: #F3F8FF; }
.c1a-close-glyph { position: relative; width: 32rpx; height: 32rpx; }
.c1a-close-glyph::before, .c1a-close-glyph::after { position: absolute; top: 14rpx; left: 2rpx; width: 28rpx; height: 4rpx; border-radius: 4rpx; background: currentColor; content: ""; }
.c1a-close-glyph::before { transform: rotate(45deg); }
.c1a-close-glyph::after { transform: rotate(-45deg); }
.c1a-sheet-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 28rpx; }

@import "../../styles/controls.wxss";
