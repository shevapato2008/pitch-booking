<view class="venue-profile" data-state="{{mode}}">
<module-navigation title="场馆资料" action="back" bind:navigate="onBack" />
  <scroll-view class="venue-profile__scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
    <view class="venue-profile__content">
      <text class="venue-profile__venue-heading">{{venueName || '场馆资料'}}</text>
      <view class="venue-profile__workbenches"><button class="venue-profile__workbench venue-profile__workbench--active venue-profile__touch" data-target="profile" bindtap="onNavigateWorkbench" hover-class="ng-pressed">场馆资料</button><button class="venue-profile__workbench venue-profile__touch" data-target="pitches" bindtap="onNavigateWorkbench" hover-class="ng-pressed">配置场地</button><button class="venue-profile__workbench venue-profile__touch" data-target="inventory" bindtap="onNavigateWorkbench" hover-class="ng-pressed">库存时段</button><button class="venue-profile__workbench venue-profile__touch" data-target="orders" bindtap="onNavigateWorkbench" hover-class="ng-pressed">今日订单</button></view>
      <view wx:if="{{mode === 'loading' || mode === 'load-error' || mode === 'permission-error' || pageRefreshError}}" class="venue-profile__status venue-profile__status--{{tone}}" role="alert"><view class="venue-profile__status-mark">!</view><view class="venue-profile__status-copy"><text class="venue-profile__status-title">{{pageRefreshError || status}}</text><text class="venue-profile__status-detail">{{statusDetail}}</text></view></view>
      <view wx:if="{{profile}}">
        <view class="venue-profile__card">
          <view class="venue-profile__section-heading"><view><text class="venue-profile__section-title">场馆图片</text><text class="venue-profile__section-help">1 张必选封面，最多 8 张；图片操作立即提交</text></view><text class="venue-profile__count">{{imageCount}} / {{maxImages}}</text></view>
          <view class="venue-profile__image-grid"><view wx:for="{{images}}" wx:key="id" wx:for-index="imageIndex" class="venue-profile__image-tile {{item.cover ? 'venue-profile__image-tile--cover' : ''}}"><image wx:if="{{item.url}}" class="venue-profile__image" src="{{item.url}}" mode="aspectFill" aria-label="{{item.alt}}"></image><view wx:else class="venue-profile-scene" role="img" aria-label="{{item.alt}}"><view class="venue-profile-scene__sky"></view><view class="venue-profile-scene__field"></view><view class="venue-profile-scene__halfway"></view><view class="venue-profile-scene__circle"></view><view class="venue-profile-scene__goal"></view></view><text wx:if="{{item.cover}}" class="venue-profile__cover-label">封面</text><text class="venue-profile__image-state venue-profile__image-state--{{item.state}}">{{item.stateLabel}}</text><text wx:if="{{item.reasonLabel}}" class="venue-profile__image-reason">{{item.reasonLabel}}</text><view wx:if="{{imageActionsEnabled && item.actionsEnabled && !item.cover}}" class="venue-profile__image-actions"><button class="venue-profile__image-action ng-button ng-button--secondary ng-button--compact {{(unknownScope || writeBusy || busyItemId === item.id) ? 'ng-disabled' : ''}}" data-image-id="{{item.id}}" disabled="{{unknownScope || writeBusy || busyItemId === item.id}}" bindtap="onSetCover" hover-class="ng-pressed">设为封面</button><button class="venue-profile__image-action venue-profile__image-action--danger ng-button ng-button--danger ng-button--compact {{(unknownScope || writeBusy || busyItemId === item.id) ? 'ng-disabled' : ''}}" data-image-id="{{item.id}}" disabled="{{unknownScope || writeBusy || busyItemId === item.id}}" bindtap="onRemoveImage" hover-class="ng-pressed">移除</button><button class="venue-profile__image-action ng-button ng-button--secondary ng-button--compact {{(unknownScope || writeBusy || imageIndex <= 1 || busyItemId === item.id) ? 'ng-disabled' : ''}}" data-image-id="{{item.id}}" data-direction="-1" disabled="{{unknownScope || writeBusy || imageIndex <= 1 || busyItemId === item.id}}" bindtap="onReorderImage" hover-class="ng-pressed">前移</button></view><button wx:if="{{item.state === 'REJECTED'}}" class="venue-profile__retry-item venue-profile__touch ng-button ng-button--text {{(unknownScope || !imageActionsEnabled || writeBusy || busyItemId === item.id) ? 'ng-disabled' : ''}}" data-item-id="{{item.id}}" disabled="{{unknownScope || !imageActionsEnabled || writeBusy || busyItemId === item.id}}" bindtap="onRetryModeration" hover-class="ng-pressed">重新审核</button></view><button wx:if="{{imageActionsEnabled && imageCount < maxImages}}" class="venue-profile__add-image venue-profile__touch" disabled="{{unknownScope || writeBusy}}" bindtap="onChooseImage" hover-class="ng-pressed"><view class="venue-profile-icon venue-profile-icon--plus"></view><text>添加图片</text></button></view>
          <text wx:if="{{imageActionError}}" class="venue-profile__local-error">{{imageActionError}}</text><text wx:if="{{imageRefreshError}}" class="venue-profile__local-error">{{imageRefreshError}}</text><button wx:if="{{imagePending || imageRefreshError}}" class="venue-profile__secondary venue-profile__touch ng-button ng-button--secondary {{(imageRefreshBusy) ? 'ng-disabled' : ''}}" bindtap="onRefreshImageStatus" disabled="{{imageRefreshBusy}}" hover-class="ng-pressed">{{imageRefreshBusy ? '刷新中' : '刷新图片状态'}}</button><button wx:if="{{unknownScope === 'image'}}" class="venue-profile__secondary venue-profile__touch ng-button ng-button--secondary {{(writeBusy || !imageActionsEnabled) ? 'ng-disabled' : ''}}" disabled="{{writeBusy || !imageActionsEnabled}}" bindtap="onRetryUnknown" hover-class="ng-pressed">核对图片操作结果</button>
        </view>
        <view class="venue-profile__card"><view class="venue-profile__section-heading"><view><text class="venue-profile__section-title">场馆介绍</text><text class="venue-profile__section-help">当前状态：{{descriptionStateLabel}}</text></view><text wx:if="{{descriptionDirty}}" class="venue-profile__draft">有未提交修改</text></view><label class="venue-profile__label" for="venue-description">介绍内容</label><textarea id="venue-description" class="venue-profile__description" value="{{description}}" maxlength="-1" disabled="{{!descriptionEditable}}" bindinput="onDescriptionInput"></textarea><text class="venue-profile__counter">{{descriptionCount}} / 300</text><text wx:if="{{descriptionReasonLabel}}" class="venue-profile__local-error">{{descriptionReasonLabel}}</text><text wx:if="{{descriptionActionError}}" class="venue-profile__local-error">{{descriptionActionError}}</text><text wx:if="{{descriptionRefreshError}}" class="venue-profile__local-error">{{descriptionRefreshError}}</text><button wx:if="{{descriptionPending || descriptionRefreshError}}" class="venue-profile__secondary venue-profile__touch ng-button ng-button--secondary {{(descriptionRefreshBusy) ? 'ng-disabled' : ''}}" bindtap="onRefreshDescriptionStatus" disabled="{{descriptionRefreshBusy}}" hover-class="ng-pressed">{{descriptionRefreshBusy ? '刷新中' : '刷新介绍状态'}}</button><button wx:if="{{descriptionDirty}}" class="venue-profile__primary venue-profile__touch ng-button ng-button--primary {{(unknownScope || writeBusy || !descriptionSubmitEnabled || descriptionSubmitBusy) ? 'ng-disabled' : ''}}" disabled="{{unknownScope || writeBusy || !descriptionSubmitEnabled || descriptionSubmitBusy}}" bindtap="onSubmitDescription" hover-class="ng-pressed">{{descriptionSubmitBusy ? '提交中' : descriptionActionLabel}}</button><button wx:if="{{!descriptionDirty && descriptionActionLabel}}" class="venue-profile__primary venue-profile__touch ng-button ng-button--primary {{(unknownScope || writeBusy || !descriptionEditable || descriptionSubmitBusy) ? 'ng-disabled' : ''}}" disabled="{{unknownScope || writeBusy || !descriptionEditable || descriptionSubmitBusy}}" bindtap="onRetryDescription" hover-class="ng-pressed">{{descriptionSubmitBusy ? '提交中' : descriptionActionLabel}}</button><button wx:if="{{unknownScope === 'description'}}" class="venue-profile__secondary venue-profile__touch ng-button ng-button--secondary {{(writeBusy || !descriptionEditable) ? 'ng-disabled' : ''}}" disabled="{{writeBusy || !descriptionEditable}}" bindtap="onRetryUnknown" hover-class="ng-pressed">核对介绍提交结果</button></view>
        <view class="venue-profile__card"><view class="venue-profile__section-heading"><text class="venue-profile__section-title">场馆设施</text><text class="venue-profile__count">{{facilities.length}} 项已选</text></view><view wx:for="{{facilityGroups}}" wx:key="title" class="venue-profile__facility-group"><text class="venue-profile__facility-title">{{item.title}}</text><view class="venue-profile__chips"><button wx:for="{{item.items}}" wx:for-item="facility" wx:key="code" class="venue-profile__chip {{facility.selected ? 'venue-profile__chip--selected ng-choice--selected' : ''}} ng-choice {{(!facilitiesEditable) ? 'ng-disabled' : ''}}" data-facility-code="{{facility.code}}" disabled="{{!facilitiesEditable}}" bindtap="onToggleFacility" aria-pressed="{{facility.selected}}" hover-class="ng-pressed">{{facility.label}}</button></view></view></view>
      </view>
      <view wx:else class="venue-profile__card venue-profile__error-panel"><text class="venue-profile__error-title">无法显示编辑内容</text><button wx:if="{{mode === 'load-error'}}" class="venue-profile__primary venue-profile__touch ng-button ng-button--primary" bindtap="onReload" hover-class="ng-pressed">重新加载</button></view>
    </view>
  </scroll-view>
  <view class="venue-profile__footer"><text class="venue-profile__footer-note">{{facilitySaveBlockedReason || facilitySaveError || '保存仅提交场馆设施'}}</text><button class="venue-profile__primary venue-profile__touch ng-button ng-button--primary {{(unknownScope || writeBusy || !facilitySaveEnabled || facilitySaveBusy) ? 'ng-disabled' : ''}}" disabled="{{unknownScope || writeBusy || !facilitySaveEnabled || facilitySaveBusy}}" bindtap="onSaveFacilities" hover-class="ng-pressed"><text>{{facilitySaveBusy ? '保存中' : '保存场馆设施'}}</text></button><button wx:if="{{unknownScope === 'facilities'}}" class="venue-profile__secondary venue-profile__touch ng-button ng-button--secondary {{(writeBusy || !facilitiesEditable) ? 'ng-disabled' : ''}}" disabled="{{writeBusy || !facilitiesEditable}}" bindtap="onRetryUnknown" hover-class="ng-pressed">核对设施保存结果</button></view>
</view>
