<view class="venue-profile" data-state="{{mode}}">
  <view class="venue-profile__system" style="height: {{headerTopPx}}px"></view>
  <view class="venue-profile__header" style="height: {{headerRowHeightPx}}px; padding-right: {{headerRightInsetPx}}px"><button class="venue-profile__back venue-profile__touch" aria-label="返回" bindtap="onBack"><view class="venue-profile-icon venue-profile-icon--back"></view></button><text class="venue-profile__title">场馆资料</text></view>
  <scroll-view class="venue-profile__scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
    <view class="venue-profile__content">
      <text class="venue-profile__venue-heading">{{venueName || '场馆资料'}}</text>
      <view class="venue-profile__workbenches"><button class="venue-profile__workbench venue-profile__workbench--active venue-profile__touch" data-target="profile" bindtap="onNavigateWorkbench">场馆资料</button><button class="venue-profile__workbench venue-profile__touch" data-target="pitches" bindtap="onNavigateWorkbench">配置场地</button><button class="venue-profile__workbench venue-profile__touch" data-target="inventory" bindtap="onNavigateWorkbench">库存时段</button></view>
      <view wx:if="{{mode === 'loading' || mode === 'load-error' || mode === 'permission-error' || pageRefreshError}}" class="venue-profile__status venue-profile__status--{{tone}}" role="alert"><view class="venue-profile__status-mark">!</view><view class="venue-profile__status-copy"><text class="venue-profile__status-title">{{pageRefreshError || status}}</text><text class="venue-profile__status-detail">{{statusDetail}}</text></view></view>
      <view wx:if="{{profile}}">
        <view class="venue-profile__card">
          <view class="venue-profile__section-heading"><view><text class="venue-profile__section-title">场馆图片</text><text class="venue-profile__section-help">1 张必选封面，最多 8 张；图片操作立即提交</text></view><text class="venue-profile__count">{{imageCount}} / {{maxImages}}</text></view>
          <view class="venue-profile__image-grid"><view wx:for="{{images}}" wx:key="id" wx:for-index="imageIndex" class="venue-profile__image-tile {{item.cover ? 'venue-profile__image-tile--cover' : ''}}"><image wx:if="{{item.url}}" class="venue-profile__image" src="{{item.url}}" mode="aspectFill" aria-label="{{item.alt}}"></image><view wx:else class="venue-profile-scene" role="img" aria-label="{{item.alt}}"><view class="venue-profile-scene__sky"></view><view class="venue-profile-scene__field"></view><view class="venue-profile-scene__halfway"></view><view class="venue-profile-scene__circle"></view><view class="venue-profile-scene__goal"></view></view><text wx:if="{{item.cover}}" class="venue-profile__cover-label">封面</text><text class="venue-profile__image-state venue-profile__image-state--{{item.state}}">{{item.stateLabel}}</text><text wx:if="{{item.reasonLabel}}" class="venue-profile__image-reason">{{item.reasonLabel}}</text><view wx:if="{{imageActionsEnabled && item.actionsEnabled && !item.cover}}" class="venue-profile__image-actions"><button class="venue-profile__image-action" data-image-id="{{item.id}}" disabled="{{unknownScope || writeBusy || busyItemId === item.id}}" bindtap="onSetCover">设为封面</button><button class="venue-profile__image-action venue-profile__image-action--danger" data-image-id="{{item.id}}" disabled="{{unknownScope || writeBusy || busyItemId === item.id}}" bindtap="onRemoveImage">移除</button><button class="venue-profile__image-action" data-image-id="{{item.id}}" data-direction="-1" disabled="{{unknownScope || writeBusy || imageIndex <= 1 || busyItemId === item.id}}" bindtap="onReorderImage">前移</button></view><button wx:if="{{item.state === 'REJECTED'}}" class="venue-profile__retry-item venue-profile__touch" data-item-id="{{item.id}}" disabled="{{unknownScope || !imageActionsEnabled || writeBusy || busyItemId === item.id}}" bindtap="onRetryModeration">重新审核</button></view><button wx:if="{{imageActionsEnabled && imageCount < maxImages}}" class="venue-profile__add-image venue-profile__touch" disabled="{{unknownScope || writeBusy}}" bindtap="onChooseImage"><view class="venue-profile-icon venue-profile-icon--plus"></view><text>添加图片</text></button></view>
          <text wx:if="{{imageActionError}}" class="venue-profile__local-error">{{imageActionError}}</text><text wx:if="{{imageRefreshError}}" class="venue-profile__local-error">{{imageRefreshError}}</text><button wx:if="{{imagePending || imageRefreshError}}" class="venue-profile__secondary venue-profile__touch" bindtap="onRefreshImageStatus" disabled="{{imageRefreshBusy}}">{{imageRefreshBusy ? '刷新中' : '刷新图片状态'}}</button><button wx:if="{{unknownScope === 'image'}}" class="venue-profile__secondary venue-profile__touch" disabled="{{writeBusy || !imageActionsEnabled}}" bindtap="onRetryUnknown">核对图片操作结果</button>
        </view>
        <view class="venue-profile__card"><view class="venue-profile__section-heading"><view><text class="venue-profile__section-title">场馆介绍</text><text class="venue-profile__section-help">当前状态：{{descriptionStateLabel}}</text></view><text wx:if="{{descriptionDirty}}" class="venue-profile__draft">有未提交修改</text></view><label class="venue-profile__label" for="venue-description">介绍内容</label><textarea id="venue-description" class="venue-profile__description" value="{{description}}" maxlength="-1" disabled="{{!descriptionEditable}}" bindinput="onDescriptionInput"></textarea><text class="venue-profile__counter">{{descriptionCount}} / 300</text><text wx:if="{{descriptionReasonLabel}}" class="venue-profile__local-error">{{descriptionReasonLabel}}</text><text wx:if="{{descriptionActionError}}" class="venue-profile__local-error">{{descriptionActionError}}</text><text wx:if="{{descriptionRefreshError}}" class="venue-profile__local-error">{{descriptionRefreshError}}</text><button wx:if="{{descriptionPending || descriptionRefreshError}}" class="venue-profile__secondary venue-profile__touch" bindtap="onRefreshDescriptionStatus" disabled="{{descriptionRefreshBusy}}">{{descriptionRefreshBusy ? '刷新中' : '刷新介绍状态'}}</button><button wx:if="{{descriptionDirty}}" class="venue-profile__primary venue-profile__touch" disabled="{{unknownScope || writeBusy || !descriptionSubmitEnabled || descriptionSubmitBusy}}" bindtap="onSubmitDescription">{{descriptionSubmitBusy ? '提交中' : descriptionActionLabel}}</button><button wx:if="{{!descriptionDirty && descriptionActionLabel}}" class="venue-profile__primary venue-profile__touch" disabled="{{unknownScope || writeBusy || !descriptionEditable || descriptionSubmitBusy}}" bindtap="onRetryDescription">{{descriptionSubmitBusy ? '提交中' : descriptionActionLabel}}</button><button wx:if="{{unknownScope === 'description'}}" class="venue-profile__secondary venue-profile__touch" disabled="{{writeBusy || !descriptionEditable}}" bindtap="onRetryUnknown">核对介绍提交结果</button></view>
        <view class="venue-profile__card"><view class="venue-profile__section-heading"><text class="venue-profile__section-title">场馆设施</text><text class="venue-profile__count">{{facilities.length}} 项已选</text></view><view wx:for="{{facilityGroups}}" wx:key="title" class="venue-profile__facility-group"><text class="venue-profile__facility-title">{{item.title}}</text><view class="venue-profile__chips"><button wx:for="{{item.items}}" wx:for-item="facility" wx:key="code" class="venue-profile__chip {{facility.selected ? 'venue-profile__chip--selected' : ''}}" data-facility-code="{{facility.code}}" disabled="{{!facilitiesEditable}}" bindtap="onToggleFacility" aria-pressed="{{facility.selected}}">{{facility.label}}</button></view></view></view>
      </view>
      <view wx:else class="venue-profile__card venue-profile__error-panel"><text class="venue-profile__error-title">无法显示编辑内容</text><button wx:if="{{mode === 'load-error'}}" class="venue-profile__primary venue-profile__touch" bindtap="onReload">重新加载</button></view>
    </view>
  </scroll-view>
  <view class="venue-profile__footer"><text class="venue-profile__footer-note">{{facilitySaveBlockedReason || facilitySaveError || '保存仅提交场馆设施'}}</text><button class="venue-profile__primary venue-profile__touch" disabled="{{unknownScope || writeBusy || !facilitySaveEnabled || facilitySaveBusy}}" bindtap="onSaveFacilities"><text>{{facilitySaveBusy ? '保存中' : '保存场馆设施'}}</text></button><button wx:if="{{unknownScope === 'facilities'}}" class="venue-profile__secondary venue-profile__touch" disabled="{{writeBusy || !facilitiesEditable}}" bindtap="onRetryUnknown">核对设施保存结果</button></view>
</view>
