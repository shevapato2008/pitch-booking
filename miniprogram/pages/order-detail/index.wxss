@import "../../styles/tokens.wxss";
.order-page{box-sizing:border-box;min-height:100vh;padding:40rpx 24rpx}.hero{display:flex;flex-direction:column;align-items:center;padding:32rpx 0 40rpx}.eyebrow{font-size:24rpx;font-weight:700}.title{margin:12rpx 0;font-weight:800}.countdown{font-size:72rpx;font-weight:800;color:#0369A1}.content{display:flex;flex-direction:column;gap:24rpx}.order-card,.state-card{display:flex;flex-direction:column;gap:12rpx;padding:28rpx}.state-card{border:2rpx solid #DBE5EC;border-radius:24rpx;background:#FFF}.state-card--error{color:#B91C1C}.amount{font-size:40rpx;font-weight:800}.retry{min-height:88rpx;margin-top:16rpx;color:#0369A1;background:#FFF;border:2rpx solid #7DD3FC}
