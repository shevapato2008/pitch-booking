@import "../../styles/tokens.wxss";

.order-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
  background: #0B1727;
  color: #F3F8FF;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

@import "../../styles/controls.wxss";

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx 40rpx;
  text-align: center;
}

.eyebrow {
  color: #CEFF80;
  font-size: 26rpx;
  font-weight: 700;
}

.title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.35;
}

.countdown {
  margin-top: 16rpx;
  color: #CEFF80;
  font-size: 72rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-copy {
  max-width: 600rpx;
  margin-top: 16rpx;
  color: #A4B5C8;
  font-size: 26rpx;
  line-height: 1.55;
}

.progress-icon {
  position: relative;
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
  border: 6rpx solid #425E68;
  border-radius: 50%;
}

.progress-icon__arc {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 28rpx;
  height: 28rpx;
  border-top: 6rpx solid #CEFF80;
  border-right: 6rpx solid #CEFF80;
  border-radius: 0 32rpx 0 0;
}

.success-check {
  position: relative;
  box-sizing: border-box;
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 16rpx;
  border: 4rpx solid #A6EDB9;
  border-radius: 50%;
  background: #152539;
}

.success-check__stroke {
  position: absolute;
  top: 34rpx;
  left: 25rpx;
  width: 50rpx;
  height: 26rpx;
  border-bottom: 6rpx solid #A6EDB9;
  border-left: 6rpx solid #A6EDB9;
  transform: rotate(-45deg);
}

.cashier-notice {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  border: 2rpx solid #425E68;
  border-radius: 24rpx;
  background: #122C3B;
  color: #CEFF80;
  font-size: 24rpx;
  line-height: 1.5;
}

.cashier-notice__title {
  font-weight: 800;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.content--with-footer {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom, 0px));
}

.detail-card,
.state-card {
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  padding: 32rpx;
  border: 2rpx solid #314157;
  border-radius: 32rpx;
  background: #152539;
}

.state-card {
  gap: 16rpx;
  line-height: 1.55;
}

.state-card--error,
.inline-error {
  color: #FFB4AA;
}

.card-kicker {
  margin-bottom: 16rpx;
  color: #A4B5C8;
  font-size: 24rpx;
}

.venue-name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
}

.pitch-name {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  color: #A4B5C8;
  font-size: 26rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.detail-row__strong {
  font-weight: 700;
}

.muted,
.rules {
  color: #A4B5C8;
}

.amount,
.footer-total__amount {
  font-size: 40rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
}

.paid-snapshot {
  display: flex;
  align-self: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  border: 2rpx solid #314157;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.detail-line {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.open-game-action {
  width: 100%;
  margin-top: 24rpx;
}

.rules,
.closing-copy,
.inline-error {
  font-size: 24rpx;
  line-height: 1.6;
}

.payment-footer {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom, 0px));
  border-top: 2rpx solid #314157;
  background: #152539;
}

.footer-total {
  display: flex;
  min-width: 188rpx;
  flex-direction: column;
}

.footer-total__label {
  color: #A4B5C8;
  font-size: 24rpx;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.primary-button {
  flex: 1;
  margin: 0;
  padding: 24rpx;
  border: 0;
  background: #CEFF80;
  color: #173421;
}

.primary-button[disabled] {
  background: #314157;
  color: #C9D7E7;
  opacity: 1;
}

.secondary-button {
  margin: 0;
  padding: 20rpx 24rpx;
  border: 2rpx solid #425E68;
  background: #152539;
  color: #CEFF80;
}

.footer-action {
  flex: 1;
}

button::after {
  border: 0;
}

.order-page { min-height: 0; }
