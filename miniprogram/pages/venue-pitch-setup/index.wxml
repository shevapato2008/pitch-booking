<view class="venue-pitch-setup" data-state="{{mode}}" aria-busy="{{duplicateSaveDisabled}}">
  <view class="venue-pitch-setup__system" style="height: {{headerTopPx}}px"></view>
  <view class="venue-pitch-setup__header" style="height: {{headerRowHeightPx}}px; padding-right: {{headerRightInsetPx}}px" aria-hidden="{{isSheetOpen}}">
    <button class="venue-pitch-setup__back venue-pitch-setup__touch" aria-label="返回" bindtap="onBack">
      <view class="venue-pitch-setup-icon venue-pitch-setup-icon--back" aria-hidden="true"></view>
    </button>
    <view class="venue-pitch-setup__identity">
      <text class="venue-pitch-setup__title">配置场地</text>
    </view>
  </view>

  <view class="venue-pitch-setup__content" aria-hidden="{{isSheetOpen}}">
    <text class="venue-pitch-setup__venue-heading">{{venueName}}</text>
    <view class="venue-pitch-setup__callout">
      <view class="venue-pitch-setup-icon venue-pitch-setup-icon--info" aria-hidden="true">i</view>
      <view>
        <text class="venue-pitch-setup__callout-title">物理场地决定可售库存的归属</text>
        <text class="venue-pitch-setup__callout-copy">场地名称和制式只在本页形成草稿，保存后才会生效。</text>
      </view>
    </view>

    <view class="venue-pitch-setup__summary">
      <text>已配置场地</text>
      <text wx:if="{{configuredCount !== null}}">{{configuredCount}} 块</text>
      <text wx:else>—</text>
    </view>

    <view wx:if="{{statusMessage}}" class="venue-pitch-setup__banner venue-pitch-setup__banner--{{bannerKind || 'info'}}" role="{{bannerKind === 'error' ? 'alert' : 'status'}}">
      <text>{{statusMessage}}</text>
    </view>

    <scroll-view class="venue-pitch-setup__list" scroll-y="true" enhanced="true" show-scrollbar="false">
      <view wx:if="{{mode === 'loading'}}" class="venue-pitch-setup__state">
        <view class="venue-pitch-setup__loading-material" aria-hidden="true"></view>
        <text>正在读取场地配置</text>
      </view>
      <view wx:elif="{{mode === 'error'}}" class="venue-pitch-setup__state">
        <text>场地配置加载失败，请重新加载</text>
        <button class="venue-pitch-setup__secondary venue-pitch-setup__touch" bindtap="onRecovery">重新加载</button>
      </view>
      <view wx:elif="{{mode === 'empty'}}" class="venue-pitch-setup__state">
        <text>还没有已配置场地，请先添加第一块物理场地</text>
      </view>

      <block wx:for="{{pitches}}" wx:key="id">
        <button
          wx:if="{{item.id || item.clientRef}}"
          class="venue-pitch-setup__pitch venue-pitch-setup__touch"
          data-pitch-id="{{item.id || item.clientRef}}"
          bindtap="onPitchTap"
          disabled="{{duplicateSaveDisabled}}"
          aria-label="{{item.displayName}}，{{item.playersPerSide}}人制，{{item.status === 'ACTIVE' ? '使用中' : '已停用'}}"
        >
          <view class="venue-pitch-setup__pitch-copy">
            <text class="venue-pitch-setup__pitch-title">{{item.displayName}}</text>
            <text class="venue-pitch-setup__pitch-meta">{{item.nameSource || (item.customName ? '自定义名称' : '系统生成名称')}} · {{item.playersPerSide}}人制</text>
            <text wx:if="{{item.draftStatus}}" class="venue-pitch-setup__status venue-pitch-setup__status--draft">{{item.draftStatus}}</text>
            <text wx:elif="{{item.status === 'ACTIVE'}}" class="venue-pitch-setup__status venue-pitch-setup__status--active">ACTIVE · 使用中</text>
            <text wx:else class="venue-pitch-setup__status venue-pitch-setup__status--inactive">INACTIVE · 已停用</text>
          </view>
          <view class="venue-pitch-setup-icon venue-pitch-setup-icon--chevron" aria-hidden="true"></view>
        </button>
        <view wx:else class="venue-pitch-setup__pitch venue-pitch-setup__touch" aria-label="{{item.displayName}}，{{item.playersPerSide}}人制，{{item.status === 'ACTIVE' ? '使用中' : '已停用'}}">
          <view class="venue-pitch-setup__pitch-copy">
            <text class="venue-pitch-setup__pitch-title">{{item.displayName}}</text>
            <text class="venue-pitch-setup__pitch-meta">{{item.nameSource || (item.customName ? '自定义名称' : '系统生成名称')}} · {{item.playersPerSide}}人制</text>
            <text wx:if="{{item.draftStatus}}" class="venue-pitch-setup__status venue-pitch-setup__status--draft">{{item.draftStatus}}</text>
            <text wx:elif="{{item.status === 'ACTIVE'}}" class="venue-pitch-setup__status venue-pitch-setup__status--active">ACTIVE · 使用中</text>
            <text wx:else class="venue-pitch-setup__status venue-pitch-setup__status--inactive">INACTIVE · 已停用</text>
          </view>
        </view>
      </block>

      <button wx:if="{{mode !== 'loading' && mode !== 'error'}}" class="venue-pitch-setup__add venue-pitch-setup__touch" bindtap="onOpenAdd">
        <view class="venue-pitch-setup-icon venue-pitch-setup-icon--plus" aria-hidden="true"></view>
        <text>添加一块场地</text>
      </button>
      <button wx:if="{{mode === 'inactive-only'}}" class="venue-pitch-setup__secondary venue-pitch-setup__touch" bindtap="onReactivatePitch">恢复使用</button>
    </scroll-view>
  </view>

  <view class="venue-pitch-setup__footer" aria-hidden="{{isSheetOpen}}">
    <text class="venue-pitch-setup__footer-notice">{{footerNotice}}</text>
    <button class="venue-pitch-setup__primary venue-pitch-setup__touch" disabled="{{pageAction.disabled}}" bindtap="onPageAction">
      <view wx:if="{{duplicateSaveDisabled}}" class="venue-pitch-setup__spinner venue-pitch-setup__spinner--small" aria-hidden="true"></view>
      <text>{{pageAction.label}}</text>
    </button>
  </view>

  <block wx:if="{{isSheetOpen}}">
    <view class="venue-pitch-setup__scrim" aria-hidden="true" bindtap="onCancelSheet"></view>
    <view class="venue-pitch-setup__sheet" role="dialog" aria-modal="true" aria-label="{{dialog ? dialog.title : editor.title}}">
      <view class="venue-pitch-setup__handle" aria-hidden="true"></view>
      <view class="venue-pitch-setup__sheet-heading">
        <view>
          <text class="venue-pitch-setup__sheet-title">{{dialog ? dialog.title : editor.title}}</text>
          <text class="venue-pitch-setup__sheet-note">完成只会写入当前页面草稿</text>
        </view>
        <button class="venue-pitch-setup__close venue-pitch-setup__touch" aria-label="关闭编辑面板" bindtap="onCloseSheet">
          <view class="venue-pitch-setup-icon venue-pitch-setup-icon--close" aria-hidden="true"></view>
        </button>
      </view>

      <view wx:if="{{dialog}}" class="venue-pitch-setup__dialog">
        <text>{{dialog.message}}</text>
        <view class="venue-pitch-setup__actions">
          <button class="venue-pitch-setup__secondary venue-pitch-setup__touch" bindtap="onCancelSheet">{{dialog.cancelLabel}}</button>
          <button class="venue-pitch-setup__primary venue-pitch-setup__touch" bindtap="onConfirmLeave">{{dialog.confirmLabel}}</button>
        </view>
      </view>

      <view wx:else class="venue-pitch-setup__editor">
        <label class="venue-pitch-setup__label" for="pitch-name">场地名称（可选）</label>
        <input id="pitch-name" class="venue-pitch-setup__input venue-pitch-setup__touch" value="{{draftName}}" bindinput="onNameInput" placeholder="保存后可使用系统名称" />
        <text wx:if="{{editor.fieldError}}" class="venue-pitch-setup__error" role="alert">{{editor.fieldError}}</text>

        <text class="venue-pitch-setup__label">可选制式</text>
        <view class="venue-pitch-setup__formats">
          <button wx:for="{{editor.formatOptions}}" wx:key="value" class="venue-pitch-setup__format venue-pitch-setup__touch {{item.selected ? 'venue-pitch-setup__format--selected' : ''}}" disabled="{{item.disabled}}" data-format="{{item.value === '其他' ? 'other' : item.value}}" bindtap="onSelectFormat" aria-pressed="{{item.selected}}">{{item.label}}</button>
        </view>
        <text wx:if="{{editor.formatReason}}" class="venue-pitch-setup__helper">已有业务记录，场地制式不可修改</text>

        <view wx:if="{{editor.customInput}}" class="venue-pitch-setup__custom-field">
          <label class="venue-pitch-setup__label" for="players-per-side">每队人数</label>
          <view class="venue-pitch-setup__custom-row">
            <input id="players-per-side" class="venue-pitch-setup__input venue-pitch-setup__touch" type="number" inputmode="numeric" value="{{draftPlayersInput}}" bindinput="onPlayersInput" aria-invalid="{{!isDraftPlayersValid}}" />
            <text class="venue-pitch-setup__preview">{{draftPlayersPreview}}</text>
          </view>
          <text wx:if="{{!isDraftPlayersValid}}" class="venue-pitch-setup__error" role="alert">请输入 1–99 的整数</text>
        </view>

        <view wx:if="{{editor.blockerMessage}}" class="venue-pitch-setup__blocker" role="alert">
          <text>未来库存尚未处理，暂不能停用</text>
          <view class="venue-pitch-setup__blocker-counts">
            <text>可售 {{editor.futureBlockers.AVAILABLE}}</text><text>锁定 {{editor.futureBlockers.LOCKED}}</text><text>已售 {{editor.futureBlockers.BOOKED}}</text>
          </view>
        </view>

        <view wx:if="{{editor.confirmation}}" class="venue-pitch-setup__confirmation">
          <text class="venue-pitch-setup__sheet-title">确认删除这块场地？</text>
          <text>{{editor.confirmation.message}}</text>
          <view class="venue-pitch-setup__actions">
            <button class="venue-pitch-setup__secondary venue-pitch-setup__touch" bindtap="onCancelSheet">取消</button>
            <button class="venue-pitch-setup__primary venue-pitch-setup__touch" bindtap="onConfirmDelete">确认删除</button>
          </view>
        </view>

        <view wx:else class="venue-pitch-setup__sheet-actions-shell">
          <button wx:if="{{editor.deleteLabel}}" class="venue-pitch-setup__danger venue-pitch-setup__touch" disabled="{{editor.deleteDisabled}}" bindtap="onDeletePitch">{{editor.deleteLabel}}</button>
          <button wx:if="{{editor.lifecycleLabel}}" class="venue-pitch-setup__danger venue-pitch-setup__touch" disabled="{{editor.lifecycleDisabled}}" bindtap="onLifecycleAction">{{editor.lifecycleLabel}}</button>
          <view class="venue-pitch-setup__sheet-actions">
            <button class="venue-pitch-setup__secondary venue-pitch-setup__touch" bindtap="onCancelSheet">取消</button>
            <button class="venue-pitch-setup__primary venue-pitch-setup__touch" disabled="{{editor.completeDisabled || !isDraftPlayersValid}}" bindtap="onCompleteEditor">{{editor.completeLabel}}</button>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
