<view class="d1a-page">
  <view class="d1a-system" style="height: {{headerTopPx}}px;"></view>
  <view class="d1a-header" style="height: {{headerRowHeightPx}}px;">
    <button class="d1a-header-back" hover-class="d1a-pressed" bindtap="onHeaderBack" aria-label="返回">
      <view class="d1a-back-icon" aria-hidden="true"></view>
    </button>
    <text class="d1a-header-title">场馆招商邀请</text>
    <view class="d1a-header-spacer" aria-hidden="true"></view>
  </view>

  <scroll-view class="d1a-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="d1a-content">
      <view class="d1a-hero d1a-hero--{{tone}}">
        <view class="d1a-invite-mark" aria-hidden="true"><view class="d1a-invite-line"></view></view>
        <text class="d1a-eyebrow">平台招商邀请</text>
        <text class="d1a-title">{{title}}</text>
        <text class="d1a-description">{{description}}</text>
        <view class="d1a-status d1a-status--{{tone}}"><view class="d1a-status-dot" aria-hidden="true"></view><text>{{statusLabel}}</text></view>
      </view>

      <view wx:if="{{venue}}" class="d1a-card">
        <text class="d1a-card-label">受邀场馆</text>
        <text class="d1a-venue-name">{{venue.name}}</text>
        <text class="d1a-venue-meta">{{venue.districtName}}</text>
        <text class="d1a-address">{{venue.address}}</text>
        <view class="d1a-divider"></view>
        <view class="d1a-fact-row"><text>邀请有效期</text><text>{{expiresAtLabel}}</text></view>
      </view>

      <view class="d1a-notice" aria-role="note">
        <view class="d1a-info-mark" aria-hidden="true">i</view>
        <view><text>权限不会自动开通</text><text>提交认领申请后仍需平台人工审核；审核通过后才会获得对应场馆权限。</text></view>
      </view>
    </view>
  </scroll-view>

  <view class="d1a-bottom">
    <button class="d1a-primary-button d1a-primary-button--{{tone}}" hover-class="d1a-pressed" bindtap="onPrimaryAction" loading="{{busy}}" disabled="{{busy}}">{{actionLabel}}</button>
    <view class="d1a-safe-bottom"></view>
  </view>
</view>
