page { background: #F8FAFC; color: #10243E; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { display: flex; flex-direction: column; min-height: 100vh; background: #F8FAFC; font-size: 28rpx; }
.header { position: sticky; top: 0; z-index: 10; display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; box-sizing: border-box; min-height: 88rpx; border-bottom: 1rpx solid #DBE5EC; background: #FFFFFF; }.header__back, .header__spacer { display: flex; align-items: center; justify-content: center; width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #0369A1; font-size: 52rpx; }.header__title { text-align: center; font-size: 34rpx; font-weight: 700; }
.content { box-sizing: border-box; flex: 1; height: 0; padding: 20rpx 24rpx calc(32rpx + env(safe-area-inset-bottom, 0px)); }
.card, .state-card, .actions { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #DBE5EC; border-radius: 16rpx; background: #FFFFFF; }.heading { font-size: 32rpx; font-weight: 700; line-height: 44rpx; }.eyebrow { color: #047857; font-size: 24rpx; font-weight: 700; }.reason { padding: 16rpx; border-radius: 12rpx; background: #FFF7ED; color: #9A3412; }
.badge { align-self: flex-start; padding: 8rpx 16rpx; border-radius: 999rpx; background: #EAF4FB; color: #0369A1; font-size: 24rpx; font-weight: 700; }.badge--PUBLISHED { background: #ECFDF5; color: #047857; }.badge--SUSPENDED { background: #FFF7ED; color: #9A3412; }.badge--CANCELLED, .badge--COMPLETED { background: #F1F5F9; color: #526479; }
.state-card--error { border-color: #FECACA; }.state-card--warning { border-color: #FDE68A; }.inline-error { margin: 0 0 16rpx; color: #B91C1C; }.return { margin: 0; }.scroll-space { height: 24rpx; }
.primary, .secondary, .danger { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 14rpx; font-size: 30rpx; font-weight: 600; }.primary { border: 0; background: #0284C7; color: #FFFFFF; }.secondary { border: 1rpx solid #0284C7; background: #FFFFFF; color: #0369A1; }.danger { border: 1rpx solid #B91C1C; background: #FFFFFF; color: #B91C1C; }button::after { border: 0; }
.scrim { position: fixed; z-index: 30; inset: 0; display: flex; align-items: flex-end; box-sizing: border-box; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom, 0px)); background: rgba(16, 36, 62, .48); }.sheet { display: flex; flex-direction: column; gap: 16rpx; box-sizing: border-box; width: 100%; padding: 28rpx; border-radius: 20rpx; background: #FFFFFF; }
