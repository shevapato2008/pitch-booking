page { background: #0B1727; color: #F3F8FF; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #0B1727; font-size: 28rpx; }
.header__system { flex: 0 0 auto; background: #152539; }
.header { z-index: 10; display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; box-sizing: border-box; flex: 0 0 auto; min-height: 88rpx; border-bottom: 1rpx solid #314157; background: #152539; }.header__back, .header__spacer { display: flex; align-items: center; justify-content: center; width: 88rpx; min-width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #F3F8FF; }.header__back-glyph { box-sizing: border-box; width: 22rpx; height: 22rpx; border-bottom: 4rpx solid currentColor; border-left: 4rpx solid currentColor; transform: rotate(45deg); }.header__title { text-align: center; font-size: 34rpx; font-weight: 700; }
.content { box-sizing: border-box; min-height: 0; flex: 1 1 auto; height: 0; padding: 20rpx 24rpx calc(32rpx + env(safe-area-inset-bottom, 0px)); }
.card, .state-card, .actions { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #314157; border-radius: 16rpx; background: #152539; }.heading { font-size: 32rpx; font-weight: 700; line-height: 44rpx; }.eyebrow { color: #A6EDB9; font-size: 24rpx; font-weight: 700; }.reason { padding: 16rpx; border-radius: 12rpx; background: #392E23; color: #FFD094; }
.badge { align-self: flex-start; padding: 8rpx 16rpx; border-radius: 999rpx; background: #122C3B; color: #CEFF80; font-size: 24rpx; font-weight: 700; }.badge--PUBLISHED { background: #17392F; color: #A6EDB9; }.badge--SUSPENDED { background: #392E23; color: #FFD094; }.badge--CANCELLED, .badge--COMPLETED { background: #1C2C40; color: #B1BFD0; }
.state-card--error { border-color: #6A424B; }.state-card--warning { border-color: #6B5335; }.inline-error { margin: 0 0 16rpx; color: #FFB4AA; }.return { margin: 0; }.scroll-space { height: 24rpx; }
.primary, .secondary, .danger { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 14rpx; font-size: 30rpx; font-weight: 600; }.primary { border: 0; background: #CEFF80; color: #173421; }.secondary { border: 1rpx solid #CEFF80; background: #152539; color: #CEFF80; }.danger { border: 1rpx solid #FFB4AA; background: #152539; color: #FFB4AA; }.button-hover { opacity: .82; }button::after { border: 0; }
.scrim { position: fixed; z-index: 30; inset: 0; display: flex; align-items: flex-end; box-sizing: border-box; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom, 0px)); background: rgba(3, 9, 19, .68); }.sheet { display: flex; flex-direction: column; gap: 16rpx; box-sizing: border-box; width: 100%; padding: 28rpx; border-radius: 20rpx; background: #152539; }

@import "../../styles/controls.wxss";
