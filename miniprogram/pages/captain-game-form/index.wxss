page { background: #0B1727; color: #F3F8FF; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #0B1727; font-size: 28rpx; }
.header__system { flex: 0 0 auto; background: #152539; }
.header { z-index: 10; display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; box-sizing: border-box; flex: 0 0 auto; min-height: 88rpx; border-bottom: 1rpx solid #314157; background: #152539; }
.header__back, .header__spacer { display: flex; align-items: center; justify-content: center; width: 88rpx; min-width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #F3F8FF; }
.header__back-glyph { box-sizing: border-box; width: 22rpx; height: 22rpx; border-bottom: 4rpx solid currentColor; border-left: 4rpx solid currentColor; transform: rotate(45deg); }
.header__title { overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; font-weight: 700; }
.content { box-sizing: border-box; min-height: 0; flex: 1 1 auto; height: 0; padding: 20rpx 24rpx 0; }
.card, .state-card { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #314157; border-radius: 16rpx; background: #152539; }
.card__top, .stepper-row, .picker-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.eyebrow, .locked, .help { color: #B1BFD0; font-size: 24rpx; line-height: 36rpx; }.eyebrow { color: #CEFF80; font-weight: 700; }
.heading, .state-card__title { font-size: 32rpx; font-weight: 700; line-height: 44rpx; }.state-card--error { border-color: #6A424B; }.state-card--warning { border-color: #6B5335; }
.summary { margin: 0 0 16rpx; padding: 18rpx 20rpx; border: 1rpx solid #6A424B; border-radius: 12rpx; background: #39242D; color: #FFB4AA; }
.field { display: flex; flex-direction: column; gap: 8rpx; }.field__label { font-weight: 700; }
.field__input, .field__textarea { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 0 22rpx; border: 1rpx solid #273A51; border-radius: 12rpx; background: #152539; color: #F3F8FF; }
.field__textarea { min-height: 176rpx; padding-top: 20rpx; line-height: 40rpx; }.field__error { color: #FFB4AA; font-size: 24rpx; line-height: 34rpx; }
.stepper { display: grid; grid-template-columns: 88rpx 56rpx 88rpx; align-items: center; gap: 18rpx; }.stepper button { display: flex; align-items: center; justify-content: center; width: 88rpx; min-width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border: 1rpx solid #273A51; border-radius: 12rpx; background: #152539; color: #CEFF80; font-size: 36rpx; line-height: 1; }.stepper__value { display: flex; min-width: 0; align-items: center; justify-content: center; font-variant-numeric: tabular-nums; text-align: center; }
.choice-row, .choice-grid { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; }.choice { display: flex; align-items: center; min-height: 72rpx; }
.picker-row { min-height: 88rpx; border-bottom: 1rpx solid #273A51; }.picker-value { display: flex; align-items: center; justify-content: flex-end; min-height: 88rpx; color: #CEFF80; }
.footer { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom, 0px)); border-top: 1rpx solid #314157; background: #152539; }.scroll-space { height: calc(136rpx + env(safe-area-inset-bottom, 0px)); }
.primary, .secondary { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 14rpx 0 0; padding: 0 24rpx; border-radius: 14rpx; font-size: 30rpx; font-weight: 600; }.primary { border: 0; background: #CEFF80; color: #173421; }.secondary { border: 1rpx solid #CEFF80; background: #152539; color: #CEFF80; }
button::after { border: 0; }
.button-hover { opacity: .82; }
