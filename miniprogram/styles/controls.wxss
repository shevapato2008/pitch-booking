/* Night Glow control vocabulary. Keep page layout, events and authority local. */
.ng-button.ng-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 16rpx 24rpx;
  border: 2rpx solid #314157;
  border-radius: 24rpx;
  color: #F3F8FF;
  background: #152539;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
  box-shadow: none;
  transition: opacity 140ms ease;
}
.ng-button.ng-button::after, .ng-icon-button.ng-icon-button::after { border: 0; }
.ng-button.ng-button--primary { border-color: #CEFF80; background: #CEFF80; color: #173421; }
.ng-button.ng-button--secondary { border-color: #425E68; background: #122C3B; color: #CEFF80; }
.ng-button.ng-button--neutral { border-color: #314157; background: #152539; color: #F3F8FF; }
.ng-button.ng-button--danger { border-color: #6A424B; background: #39242D; color: #FFB4AA; }
.ng-button.ng-button--compact { padding: 10rpx 18rpx; border-radius: 16rpx; font-size: 26rpx; }
.ng-button.ng-button--text { padding: 8rpx 12rpx; border-color: transparent; background: transparent; color: #CEFF80; font-size: 26rpx; }
.ng-button.ng-button--text-danger { border-color: transparent; background: transparent; color: #FFB4AA; }
.ng-button.ng-button.ng-disabled {
  border-color: #314157;
  background: #233449;
  color: #A4B5C8;
  opacity: 1;
  box-shadow: none;
}
.ng-icon-button.ng-icon-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 44px;
  min-width: 44px;
  height: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: #F3F8FF;
  line-height: 1;
}
.ng-icon-button.ng-icon-button.ng-disabled { background: transparent; color: #8B9DB3; opacity: 1; }
.ng-close-icon { position: relative; display: block; width: 24px; height: 24px; flex: none; }
.ng-close-icon::before, .ng-close-icon::after { position: absolute; top: 11px; left: 3px; width: 18px; height: 2px; border-radius: 2px; background: currentColor; content: ""; transform: rotate(45deg); }
.ng-close-icon::after { transform: rotate(-45deg); }
/* Explicit hover-class works on native buttons without changing geometry. */
.ng-pressed { opacity: .76; transform: none; }
.ng-icon-button.ng-pressed { background: #233449; opacity: 1; }
@media (prefers-reduced-motion: reduce) { .ng-button.ng-button { transition: none; } }

/* Choices share geometry and selection feedback; data/availability keeps its own meaning. */
.ng-choice.ng-choice { box-sizing: border-box; display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 10rpx 20rpx; border: 2rpx solid #314157; border-radius: 20rpx; background: #152539; color: #A4B5C8; font-size: 26rpx; font-weight: 600; line-height: 1.4; }
.ng-choice.ng-choice--selected { border-color: #CEFF80; background: #CEFF80; color: #173421; font-weight: 700; }
.ng-choice.ng-choice.ng-disabled { border-color: #314157; background: #233449; color: #8B9DB3; opacity: 1; }
.ng-choice.ng-choice--selected.ng-disabled { border-color: #425E68; background: #122C3B; color: #A4B5C8; }
.ng-badge.ng-badge { box-sizing: border-box; display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; min-width: 104rpx; height: 56rpx; padding: 0 16rpx; border-radius: 28rpx; font-size: 22rpx; font-weight: 700; line-height: 32rpx; text-align: center; white-space: nowrap; }
.ng-chevron-right { display: block; width: 10px; height: 10px; border-top: 2px solid currentColor; border-right: 2px solid currentColor; transform: rotate(45deg); }
