/* Approved native design tokens. WXSS custom properties are intentionally avoided. */
/* Colors: bg #F8FAFC; surface #FFFFFF; text #10243E; muted #64748B; border #DBE5EC. */
/* Trust: blue #0284C7; sky #0EA5E9. */
/* States: available #059669 on #EFFBF6; unavailable #94A3B8; held #B45309. */
/* Type: 24rpx / 28rpx / 32rpx / 40rpx; CTA 30rpx. */
/* Radius: 16rpx / 24rpx / 32rpx. */
/* Spacing: 8rpx / 16rpx / 24rpx / 32rpx / 48rpx. */
/* Interactive controls: minimum 88rpx. */

.u-page { background: #F8FAFC; }
.u-surface { background: #FFFFFF; }
.u-text { color: #10243E; }
.u-muted { color: #64748B; }
.u-border { border: 2rpx solid #DBE5EC; }
.u-radius-sm { border-radius: 16rpx; }
.u-radius-md { border-radius: 24rpx; }
.u-radius-lg { border-radius: 32rpx; }
.u-type-caption { font-size: 24rpx; }
.u-type-body { font-size: 28rpx; }
.u-type-subtitle { font-size: 32rpx; }
.u-type-title { font-size: 40rpx; }
.u-type-cta { font-size: 30rpx; }
.u-pad-page { padding-right: 24rpx; padding-left: 24rpx; }
.u-control { min-height: 88rpx; }
.u-trust-primary { color: #0284C7; }
.u-trust-secondary { color: #0EA5E9; }
.u-status-available { color: #059669; background: #EFFBF6; }
.u-status-unavailable { color: #94A3B8; }
.u-status-held { color: #B45309; }
