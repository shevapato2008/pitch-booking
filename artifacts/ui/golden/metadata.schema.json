{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitch-booking.local/schemas/golden-metadata.schema.json",
  "title": "Venue browsing golden metadata",
  "type": "object",
  "required": [
    "sha256",
    "route",
    "scenario",
    "logical_width",
    "device_pixel_ratio",
    "operating_system",
    "wechat_version",
    "base_library_version",
    "developer_tools_version",
    "commit"
  ],
  "properties": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "route": {
      "type": "string",
      "enum": [
        "pages/venue/index",
        "pages/availability/index"
      ]
    },
    "scenario": {
      "type": "string",
      "enum": [
        "slots-empty",
        "slots-first-load-error",
        "slots-late-response",
        "slots-ready",
        "slots-refresh-error",
        "slots-selected",
        "venue-first-load-error",
        "venue-image-failure",
        "venue-map-error",
        "venue-phone-error",
        "venue-ready"
      ]
    },
    "logical_width": {
      "type": "integer",
      "minimum": 320,
      "maximum": 1024
    },
    "device_pixel_ratio": {
      "type": "number",
      "minimum": 1,
      "maximum": 4
    },
    "operating_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "wechat_version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){2,3}$"
    },
    "base_library_version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){2,3}$"
    },
    "developer_tools_version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){2,3}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  },
  "additionalProperties": false
}
