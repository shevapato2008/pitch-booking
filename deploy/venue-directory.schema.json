{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelstella.com/schemas/venue-directory.schema.json",
  "title": "Verified venue directory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coordinate_system",
    "legacy_identity_mappings",
    "venues"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "coordinate_system": { "const": "GCJ02" },
    "legacy_identity_mappings": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/legacyIdentityMapping" }
    },
    "venues": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/venue" }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_system", "latitude", "longitude"],
      "properties": {
        "coordinate_system": { "const": "GCJ02" },
        "latitude": { "type": "number", "minimum": 38.55, "maximum": 40.25 },
        "longitude": { "type": "number", "minimum": 116.7, "maximum": 118.1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier", "verified_at", "method", "confidence"],
      "properties": {
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "internal_reference": { "type": "string", "minLength": 1 },
        "supporting_source_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "verifier": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date-time" },
        "method": { "type": "string", "minLength": 1 },
        "confidence": {
          "enum": [
            "AUTHORITATIVE_SOURCE",
            "DIRECT_POI",
            "SOURCE_CONVERSION",
            "MANUAL_MAP_MATCH"
          ]
        },
        "notes": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["source_url"], "not": { "required": ["internal_reference"] } },
        { "required": ["internal_reference"], "not": { "required": ["source_url"] } }
      ]
    },
    "legacyIdentityMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "legacy_slug", "slug"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "legacy_slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["poi_name", "coordinate"],
      "properties": {
        "poi_name": { "type": "string", "minLength": 1 },
        "coordinate": { "$ref": "#/$defs/coordinate" }
      }
    },
    "transitStop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "coordinate",
        "lines",
        "distance_meters",
        "distance_basis",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["SUBWAY", "BUS"] },
        "name": { "type": "string", "minLength": 1 },
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "distance_meters": { "type": "integer", "minimum": 0 },
        "distance_basis": { "const": "MAP_VERIFIED" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "venueEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_address", "marker", "navigation"],
      "properties": {
        "name_address": { "$ref": "#/$defs/evidence" },
        "marker": { "$ref": "#/$defs/evidence" },
        "navigation": { "$ref": "#/$defs/evidence" }
      }
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "sort_order",
        "name",
        "description",
        "address",
        "district_code",
        "district_name",
        "booking_mode",
        "marker",
        "navigation",
        "pitch_types",
        "cover_image",
        "business_hours_text",
        "parking_text",
        "images",
        "facilities",
        "nearest_transit",
        "content_verified_at",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sort_order": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "address": { "type": "string", "minLength": 1 },
        "district_code": { "type": "string", "pattern": "^[0-9]{6}$" },
        "district_name": { "type": "string", "minLength": 1 },
        "booking_mode": { "enum": ["ONLINE", "DIRECTORY_ONLY"] },
        "marker": { "$ref": "#/$defs/coordinate" },
        "navigation": { "$ref": "#/$defs/navigation" },
        "pitch_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["FIVE_A_SIDE", "SEVEN_A_SIDE", "ELEVEN_A_SIDE"] }
        },
        "cover_image": {
          "anyOf": [
            { "type": "string", "format": "uri", "pattern": "^https://" },
            { "type": "null" }
          ]
        },
        "business_hours_text": { "type": ["string", "null"] },
        "parking_text": { "type": ["string", "null"] },
        "images": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "facilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "nearest_transit": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/transitStop" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "SUBWAY" } }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "BUS" } }
              },
              "minContains": 0,
              "maxContains": 3
            }
          ]
        },
        "content_verified_at": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/$defs/venueEvidence" }
      }
    }
  }
}
