APP_ENV=staging
APP_REVISION=uncommitted
DATABASE_URL=postgresql+psycopg://pitch:change-before-deploy@postgres:5432/pitch
POSTGRES_DB=pitch
POSTGRES_USER=pitch
POSTGRES_PASSWORD=change-before-deploy
PUBLIC_API_BASE_URL=https://staging.invalid
PUBLIC_IMAGE_HOSTS=["cdn.invalid"]
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=replace-with-private-oss-bucket
OSS_PUBLIC_BASE_URL=https://cdn.invalid/media
OSS_ACCESS_KEY_ID=inject-through-your-secret-manager
OSS_ACCESS_KEY_SECRET=inject-through-your-secret-manager
# Must be a different, private bucket used only for onboarding evidence.
ONBOARDING_OSS_BUCKET=replace-with-dedicated-private-onboarding-bucket
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODERATION_MODEL=qwen3-vl-flash
MODERATION_REVIEWER_USER_IDS=
WECHAT_PROVIDER=real
# Keep disabled until the WeChat subscription template, closed keyword mapping, and physical-device
# delivery/deep-link acceptance gates have all passed.
OPEN_GAME_NOTIFICATION_PROVIDER=disabled
OPEN_GAME_NOTIFICATION_TEMPLATE_ID=
OPEN_GAME_NOTIFICATION_KEYWORD_MAPPING_JSON=
# This default is inert while the provider is disabled. An enabled staging deployment must
# explicitly use trial; an enabled production deployment must use formal.
OPEN_GAME_NOTIFICATION_MINIPROGRAM_STATE=formal
PAYMENT_PROVIDER=disabled
ENABLE_MOCK_PAYMENT_PROVIDER=false
# Required only when PAYMENT_PROVIDER=wechat. WeChat Pay API v3 merchant and platform-public-key values. PEM values are
# canonical single-line Base64; never paste raw multiline PEM into this file.
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_CERT_SERIAL=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PEM_BASE64=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PEM_BASE64=
# Exactly 32 characters from A-Z, a-z, 0-9, underscore, or hyphen. This restricted
# alphabet prevents dotenv/Compose interpolation. Keep only in ignored config or a secret manager.
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PAYMENT_NOTIFICATION_URL=https://staging.invalid/api/v1/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFICATION_URL=https://staging.invalid/api/v1/refunds/wechat/notify
# Keep false until the API domain has an active ICP filing record.
MINIPROGRAM_ICP_FILING_CONFIRMED=false
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=generate-and-inject-through-your-secret-manager
# Generate 32 random bytes and inject their standard Base64 encoding through your secret manager.
PHONE_ENCRYPTION_KEY_BASE64=generate-and-inject-through-your-secret-manager
PHONE_ENCRYPTION_KEY_VERSION=1
SESSION_TTL_DAYS=30
# Closed JSON array; store SHA-256 token hashes only, never raw reviewer tokens.
PLATFORM_STAFF_PRINCIPALS_JSON=[]
# Generate 32 random bytes and store their canonical standard Base64 encoding.
PLATFORM_CSRF_SECRET=generate-and-inject-through-your-secret-manager
