{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022", "DOM"],
    "noEmitOnError": true
  },
  "include": ["src/api.ts", "src/auth.ts", "src/review.ts", "src/attendance-correction.ts", "src/main.ts"]
}
